//Flipped (v0.12.1): the scanner now splits the glued ">>" into two
//closing brackets, so the nested declared-generic instantiation
//parses at a statement head. The construction spelling rides a dead
//branch: a declared generic's methods are native signatures with no
//registered implementation, so the call itself can never execute.
class Box<T> {
    public native Box();
    public native T get();
}
int main() {
    Box<Box<int>> b;
    if (1 == 2) {
        Box<Box<int>> c = Box();
    }
    return 0;
}
