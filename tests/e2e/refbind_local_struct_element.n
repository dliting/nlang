// v0.13.9 phase 3: a struct & binding to an array element names the
// element record itself — member stores write through to the array.
struct Point {
    int x;
    int y;
}

int main() {
    Point[] arr = Point[2];
    arr[1].x = 4;
    Point& r = arr[1];
    r.x = r.x * 2;
    return arr[1].x;
}
