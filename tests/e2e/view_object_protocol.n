// Final-review C2: protocol dispatch (toString/equals) on a view
// receiver reached through Object must land on the Array face class,
// not read the view's kind byte as a class index.
import lang;

int main() {
    int[] a = int[4];
    a[0] = 5; a[1] = 6; a[2] = 7; a[3] = 8;
    int[] twin = int[2];
    twin[0] = 6; twin[1] = 7;

    Object o = a[1:3];          // logical cells [6, 7]
    int acc = 0;
    if (o.equals(o) == 1) { acc = acc + 1; }               // self: identity
    if (o.equals(twin) == 0) { acc = acc + 2; }            // identity, not content
    if (o.toString() == twin.toString()) { acc = acc + 4; } // logical content
    return acc;
}
