// Container ops x alias: side-table growth moves handles, not
// element records — the alias keeps reading the same record.
int main() {
    List<int> nums = {};
    nums.add(5);
    int& n = nums[0];
    for (int i = 0; i < 200; i = i + 1) nums.add(1000 + i);
    if (n == 5) return 9;
    return 4;
}
