// v0.12.3 Task 5: the mixed-member template executes — a T field, a
// bodied constructor taking T, a T-returning method and a concrete-typed
// method share one template row (the dictionary model's single
// implementation); the call sites rebind to it. Exit = size() = 1.
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
    public T get() { return item; }
    public int size() { return 1; }
}
int main() {
    Box<string> b = Box("hello");
    if (b.get() == "hello") { return b.size(); }
    return 9;
}
