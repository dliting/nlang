int main() {
	//P3.10 OP_Box fix: boxed int 0 should not crash on toString.
	//Boxed int 0 is RTK_Boxed, so toString uses Object intrinsic
	//("Int32@hex(heapIdx)"), not int->str. We verify it doesn't crash
	//and the output starts with "Int32".
	Object o = 0;
	string s = o.toString();
	if (s.length() > 5) return 7;
	return 1;
}
