// generic_spelling_collision_paren_comparisons.n — 0.13.1b M2: the
// parenthesized spelling of the colliding call — every comparison
// argument wrapped — compiles and runs (the same program
// err_spelling_collision_names_the_fix pins the diagnostic for).
bool both(bool lt, bool gt) {
    return lt && gt;
}
int main() {
    int a = 1;
    int b = 2;
    int c = 5;
    int d = 4;
    if (!both((a < b), (c > (d)))) {
        return 1;
    }
    return 0;
}
