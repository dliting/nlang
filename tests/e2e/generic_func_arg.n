// v0.12.3 Task 5: a function type argument is rejected — a func value
// spans multiple signature slots and breaks the one-slot layout
// invariant every instantiation shares (spec D2).
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
    public T get() { return item; }
}
class Holder {
    public Box<func<int,int>> boxed;
}
int main() { return 0; }
