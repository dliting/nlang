// v0.13.9 phase 3 Task 12: a & loop variable over a List while
// shrinking it mid-loop — the walk re-probes the container length each
// iteration, so a removal shortens it; the binding names the current
// element slot each pass and writes land on the shifted elements.
// Expected exit code: 0.
int main() {
    List<int> nums = {};
    nums.add(0);
    nums.add(1);
    nums.add(2);
    nums.add(3);
    int sum = 0;
    int i = 0;
    foreach (int& n in nums) {
        if (i == 0) {
            nums.removeAt(3);   //drop the tail inside the first pass
            n = 10;
        } else {
            sum = sum + n;
        }
        i = i + 1;
    }
    if (sum == 1 + 2 && nums.get(0) == 10)
        return 0;
    return 1;
}
