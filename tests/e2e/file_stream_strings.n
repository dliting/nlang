int main() {
    FileStream fs = new FileStream("_phase8_tmp/test_strings.bin", "w");
    fs.writeString("hi");
    fs.close();
    FileStream fs2 = new FileStream("_phase8_tmp/test_strings.bin", "r");
    string s = fs2.readString();
    fs2.close();
    if (s == "hi") {
        return 1;
    }
    return 0;
}
