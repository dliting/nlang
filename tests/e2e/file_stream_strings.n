int main() {
    FileStream stream = new FileStream("_phase8_tmp/test_strings.bin", "w");
    stream.writeString("hi");
    stream.close();
    FileStream stream2 = new FileStream("_phase8_tmp/test_strings.bin", "r");
    string s = stream2.readString();
    stream2.close();
    if (s == "hi") {
        return 1;
    }
    return 0;
}
