//0.7.3 B: side-effect pin of the container gate's direction-① deletion
//— an array stored into a List<string> element slot flows to the cast
//table, whose token→string Auto coerces it (same verdict as the string[]
//subscript path). The .add-method form is pinned separately in Task 11.
int main() {
    List<string> ls = new List<string>();
    int[] ia = new int[2];
    ia[0] = 1;
    ia[1] = 2;
    ls.add("x");
    ls[0] = ia;
    int r = 0;
    if (ls.get(0) == "[1, 2]") { r = 6; }
    return r;
}
