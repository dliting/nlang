//v0.14.2 semantics pin: the comparison family on arrays.
//Numeric arrays: ==/!= and the relational operators are ELEMENTWISE,
//producing int 0/1 masks (the mask idiom; sum counts). Non-numeric
//arrays (string here): ==/!= stay IDENTITY (handle comparison) —
//there is no numeric ordering to lower to. Null checks stay sentinel.
import tensor;

int main() {
    int[] a = int[2];
    a[0] = 1;
    a[1] = 2;
    int[] b = a;
    int[] c = int[2];
    c[0] = 1;
    c[1] = 3;
    //Elementwise: the alias mask is all-ones, the distinct-content
    //mask is [1, 0].
    int[] eqAlias = a == b;
    if (eqAlias[0] != 1 || eqAlias[1] != 1) return 1;
    int[] eqDistinct = a == c;
    if (eqDistinct[0] != 1 || eqDistinct[1] != 0) return 2;
    //Non-numeric arrays keep the identity comparison.
    string[] s1 = string[1];
    string[] s2 = s1;
    if (s1 != s2) { return 3; }
    return 0;
}
