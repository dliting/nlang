//Phase 13 Step 2: dropped bound handles become collectable — bind,
//drop the reference, then churn the heap and verify a fresh handle
//still works (indirect observation: the collector ran without
//corrupting live state).
class Big { public int a; public int b; }

class M {
    public int v;
    public int get(int x) { return x + v; }
}

int main() {
    M m = M();
    m.v = 9;
    func<int, int> f = m.get;
    f(1);
    f = null;
    for (int i = 0; i < 3000; i = i + 1) {
        Big b = Big();
        b.a = i;
    }
    func<int, int> g = m.get;
    return g(0);
}
