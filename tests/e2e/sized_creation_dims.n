// The sized-creation dimension contract: any expression resolving to an
// integer is a valid dimension — method calls and arithmetic included.
// A float dimension is a compile error (sized_creation_float_dim_reject);
// a negative runtime value stays the bounds family.
int[] dimsHelper() {
    int[] s = int[2];
    s[0] = 2;
    s[1] = 3;
    return s;
}

int main() {
    // method-call dimension
    float[] x = float[3];
    x[2] = 1.5;
    float[] y = float[x.length()];
    if (y.length() != 3) return 1;

    // arithmetic dimension
    int n = 3;
    int[] a = int[n + 1];
    a[3] = 7;
    if (a.length() != 4 || a[3] != 7) return 2;

    // dimension over a helper call
    double[] c = double[dimsHelper().length()];
    if (c.length() != 2) return 3;

    return 0;
}
