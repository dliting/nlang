//Positive guard: an array returned from a function coerces to string
//via the runtime array-aware toString dispatch — the cast arm must key
//on the array-valued property, not on identifier/member shapes.
int[] mk() {
    int[] a = new int[2];
    a[0] = 1;
    a[1] = 2;
    return a;
}
int main() {
    string s = mk();
    if (s == "[1, 2]")
        return 7;
    return 1;
}
