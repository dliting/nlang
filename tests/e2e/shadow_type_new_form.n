// The `new`-era spelling twin of shadow_type_init_two_decls (migrated
// with the rest of the `new` spellings); under the 0.9.0 restriction
// the shadowed declaration is rejected at the declaration site.
struct Vec {
    int x;
    int y;
}

int main() {
    Vec Vec = Vec{x: 5, y: 6};
    Vec w = Vec{x: 7, y: 8};
    return Vec.x + w.x;
}
