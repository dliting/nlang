// Phase 9 audit: defaults/named-arg full matrix (positional fill, trailing fill,
// named fill, reordered named, this.x default on method, explicit override).
int f(int a, int b = 2, int c = 3) {
	return a * 100 + b * 10 + c;
}
class P {
	public int x;
	public int P() { x = 1; return 0; }
	public int g(int m = this.x) {
		return m;
	}
}
int main() {
	int r = 0;
	if (f(1) != 123) r += 1;
	if (f(1, 9) != 193) r += 2;
	if (f(1, 9, 8) != 198) r += 4;
	if (f(1, c = 7) != 127) r += 8;
	if (f(c = 5, a = 2) != 225) r += 16;
	P p = new P();
	if (p.g() != 1) r += 32;
	if (p.g(9) != 9) r += 64;
	return r;
}
