//Multi-flag void method (AccessType NodeFlags KT_Void grammar variant):
//`public static void` requires the NodeFlags production — a single-flag
//rule alone would leave this shape a bare syntax error. 0.9.10: the
//type-name form `Util.twice(...)` is supported; this test keeps the
//instance-qualified spelling (allowed, the receiver value is unused) and
//an out param for the observable effect instead of touching instance
//state from a static method.
class Util {
	public static void twice(int v, out int r) {
		r = v * 2;
	}
}

int main() {
	int r = 0;
	Util u = Util();
	u.twice(21, out r);
	return r;
}
