//Phase 13 Step 0 fix round: alias as the explicit type of an
//initialization list ("new B{...}"). The splice used to leave
//SnInitListExpr::m_pExplicitType dangling (missing ReplaceChildNode
//override) and crash the compiler; the field must initialize to 41.
using B = Box;

class Box {
    int v;
}

int main() {
    B b = new B{ v: 41 };
    return b.v + 1;
}
