// Phase 10 audit round-3: array member-write receiver (`arr[i].field = v`)
// must stage its three operands in evalArea (EvalAreaClaim), not
// tempSlot/tempSlot2/callParamBase — any nested expression in the index
// (subscript-get, binary arithmetic) scratches tempSlot where the array
// was parked. Pre-fix: `pts[q[0]].x = 7` crashed ("null array access");
// `pts[i+k].x = 7` silently stored through whatever heap object had the
// right operand's value as its handle (wrong-array write when it happened
// to be valid — the nastiest failure mode of the family).
int pick(int n) {
    return n;
}

struct Point {
    int x;
    int y;
}

class Box {
    int v;
}

int main() {
    int r = 0;
    int i = 1;
    int k = 3;
    int[] q = new int[2];
    q[0] = 4;
    q[1] = 2;
    //Heap-handle separator: allocate a distinct array first so pts/cls
    //handles can never coincide with small index values.
    int[] first = new int[1];

    // subscript-get in the index — pre-fix crash
    Point[] pts = new Point[5];
    pts[q[0]].x = 7;
    if (pts[4].x != 7) r += 1;

    // binary arithmetic in the index — pre-fix silent wrong-array write
    pts[i + k].y = 9;
    if (pts[4].y != 9) r += 2;

    // call in the index
    pts[pick(2)].x = 5;
    if (pts[2].x != 5) r += 4;

    // subscript-get in the value (RHS) as well as the index
    pts[q[1]].y = q[0];
    if (pts[2].y != 4) r += 8;

    // plain literal index (control)
    pts[0].x = 3;
    if (pts[0].x != 3) r += 16;

    // class elements: same path plus the element null-check
    Box[] cls = new Box[5];
    cls[4] = new Box{v: 0};
    cls[i + k].v = 6;
    if (cls[4].v != 6) r += 32;

    // struct write-through must keep 9d-3 semantics (stored element mutated)
    if (pts[4].x != 7) r += 64;

    // container member-write receiver (control — claim-based get() path)
    List<Box> lc = [new Box{v: 1}];
    lc[q[1] - 2].v = 8;
    if (lc.get(0).v != 8) r += 128;

    return r;
}
