enum Color { Red, Green, Blue }
int main() {
    //Documents Phase 8e-9a known limitation: enum values are int32 at
    //runtime (CastInfo.cpp:50), so enum + string goes through int→string
    //coercion and yields the enum's underlying integer (Red=0 → "0").
    //Users who want "Red" must wait for Phase 8e-9b (Object.toString()
    //protocol with enum name table). Lock the current behavior so the
    //upgrade to 8e-9b is an intentional, observable change.
    string s = "x" + Color.Red;
    return s.length();
}
