enum Color { Red, Green, Blue }
int main() {
	//Phase 8e-9b: enum + string now goes through enum→string coercion
	//(OP_Enum_to_str), yielding the declared member name (Color.Red → "Red").
	//This replaces the Phase 8e-9a int-fallback behavior that yielded the
	//underlying integer (Red=0 → "0", length 2 = "x" + "0").
	string s = "x" + Color.Red;
	return s.length();
}
