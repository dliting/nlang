// v0.12.3 Task 1 window: a bodied constructor's clone carries no body,
// so it is not an implementation-bearing candidate — a constructing
// call with arguments reports the missing constructor cleanly (the
// zero-argument form stays the legal bare-allocation shape).
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
}
int main() {
    Box<int> b = Box(5);
    return 0;
}
