// v0.12.3 dictionary model: a bodied constructor call with arguments
// executes through the template row's compiled record (the clone is
// the signature surface the call type-checks against; the slot throat
// resolves the record). Exit 0.
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
}
int main() {
    Box<int> b = Box(5);
    return 0;
}
