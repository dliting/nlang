//foreach over an array VALUE from a call: `mk()` returning int[].
//0.7.3 B D10: accepted; the call evaluates ONCE into the hidden iter
//slot (single-evaluation pin: foreach_src_single_eval).
int[] mk() {
	int[] a = [10, 20, 30];
	return a;
}

int main() {
	int total = 0;
	foreach (int x in mk()) {
		total = total + x;
	}
	return total;
}
