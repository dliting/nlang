class Animal { public int legs; }
class Dog : Animal { public int teeth; }

int main() {
    FileStream stream = new FileStream("_phase8_tmp/object_polymorphism.bin", "w");
    Dog d = new Dog();
    d.legs = 4;
    d.teeth = 42;
    stream.writeObject(d);
    stream.close();
    FileStream stream2 = new FileStream("_phase8_tmp/object_polymorphism.bin", "r");
    Animal a = stream2.readObject("Animal");
    stream2.close();
    return a.legs;
}
