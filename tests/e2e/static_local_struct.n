//D14: struct-typed static locals — the initializer runs once, the value
//persists across calls with struct value semantics, and the
//initializer-less form reads as the zeroed default.
struct Point {
    public int x;
    public int y;
    Point(int a, int b) { x = a; y = b; }
}
int visit() {
    static Point p = Point(10, 20);
    p.x = p.x + 1;
    return p.x;
}
int touch() {
    static Point q;
    q.y = q.y + 2;
    return q.y;
}
int main() {
    if (visit() != 11) { return 1; }
    if (visit() != 12) { return 2; }
    if (touch() != 2) { return 3; }
    if (touch() != 4) { return 4; }
    return 0;
}
