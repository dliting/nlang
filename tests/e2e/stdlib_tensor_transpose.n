// tensor.transpose: rank-2 transpose copies [rows, cols] -> [cols, rows]
// in row-major order, for every element kind; two transposes round-trip.
import io;
import tensor;

int main() {
    int[,] a = [[1, 2, 3], [4, 5, 6]];
    int[,] t = tensor.transpose(a);
    if (t.shape()[0] != 3 || t.shape()[1] != 2) return 1;
    if (t[0,0] != 1 || t[0,1] != 4) return 2;
    if (t[1,0] != 2 || t[1,1] != 5) return 3;
    if (t[2,0] != 3 || t[2,1] != 6) return 4;

    // double kind, non-square target
    double[,] d = [[1.5, 2.5], [3.5, 4.5], [5.5, 6.5]];
    double[,] td = tensor.transpose(d);
    if (td.shape()[0] != 2 || td.shape()[1] != 3) return 5;
    if (td[0,2] != 5.5 || td[1,2] != 6.5) return 6;

    // round-trip restores the original layout
    int[,] back = tensor.transpose(t);
    if (back.shape()[0] != 2 || back.shape()[1] != 3) return 7;
    if (back[0,0] != 1 || back[1,2] != 6) return 8;

    // long kind: [[1, 2], [3, 4]] -> [[1, 3], [2, 4]]
    long[,] l = [[1, 2], [3, 4]];
    long s = tensor.transpose(l)[1,0];
    if (s != 2) return 9;
    if (tensor.transpose(l)[0,1] != 3) return 10;
    return 0;
}
