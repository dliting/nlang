//Side-effect ordering: the skipped operand's method call must not run;
//the evaluated one must. Counter observed via a class field.
class Counter {
    public int n;
    //bump()'s return value 1 is load-bearing: r3/r4 below assert the
    //evaluated operand's value flows through as the logical result.
    public int bump() { this.n = this.n + 1; return 1; }
}
int main() {
    Counter c = new Counter();
    c.n = 0;
    int a = 0;
    int r1 = (a != 0) && c.bump();  //skipped
    if (c.n != 0) return 2;
    int r2 = (a == 0) || c.bump();  //skipped
    if (c.n != 0) return 3;
    int r3 = (a == 0) && c.bump();  //evaluated
    if (c.n != 1) return 4;
    int r4 = (a != 0) || c.bump();  //evaluated
    if (c.n != 2) return 5;
    if (r1 != 0) return 6;
    if (r2 != 1) return 7;
    if (r3 != 1) return 8;
    if (r4 != 1) return 9;
    return 42;
}
