//Side-effect ordering: the skipped operand's method call must not run;
//the evaluated one must. Counter observed via a class field.
class Counter {
    public int n;
    //bump()'s return value true is load-bearing: r3/r4 below assert the
    //evaluated operand's value flows through as the logical result.
    public bool bump() { this.n = this.n + 1; return true; }
}
int main() {
    Counter c = new Counter();
    c.n = 0;
    bool a = false;
    bool r1 = a && c.bump();   //skipped
    if (c.n != 0) return 2;
    bool r2 = !a || c.bump();  //skipped
    if (c.n != 0) return 3;
    bool r3 = !a && c.bump();  //evaluated
    if (c.n != 1) return 4;
    bool r4 = a || c.bump();   //evaluated
    if (c.n != 2) return 5;
    if (r1 != false) return 6;
    if (r2 != true) return 7;
    if (r3 != true) return 8;
    if (r4 != true) return 9;
    return 42;
}
