//Phase 9d-2: super(msg) forwards the message to the built-in Exception
//parent ctor (previously a Phase 9d workaround assigned fields after
//construction with a default ctor).
class MyException : Exception {
    int code;
    public int MyException(string msg) {
        super(msg);
        this.code = 1;
        return 0;
    }
}

int main() {
    try {
        throw new MyException("bad");
    } catch (MyException e) {
        if (e.message == "bad") { return e.code; }
        return 2;
    }
    return 0;
}
