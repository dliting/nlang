//Array built-ins win over element methods on an array receiver (the
//length() precedent), and element methods still bind through a
//subscript. Stage-1 Review MAJOR-1's hazard (the array's heap index
//passed as `this` to the element's method table) is gone: the array
//arm resolves first, by name.
enum Color {
    Red, Green;

    public int rank() {
        return this + 10;
    }
}

int main() {
    Color[] a = Color[2];
    a[0] = Color.Red;
    a[1] = Color.Green;
    if (a.rank() != 1) return 7;
    if (a.length() != 2) return 8;
    if (a[0].rank() != 10) return 9;
    if (a[1].rank() != 11) return 10;
    return 0;
}
