// tensor.matmul: naive i-k-j matrix product with the accumulator taken
// from the element type — int/long wrap around (the language-wide
// arithmetic rule, no silent widening), float/double follow IEEE.
import io;
import tensor;

int main() {
    // int 2x3 * 3x2 -> [[58, 64], [139, 154]]
    int[,] a = [[1, 2, 3], [4, 5, 6]];
    int[,] b = [[7, 8], [9, 10], [11, 12]];
    int[,] c = tensor.matmul(a, b);
    if (c.shape()[0] != 2 || c.shape()[1] != 2) return 1;
    if (c[0,0] != 58 || c[0,1] != 64) return 2;
    if (c[1,0] != 139 || c[1,1] != 154) return 3;

    // double spot check
    double[,] x = [[1.5, 2.0], [0.5, 1.0]];
    double[,] y = [[2.0, 1.0], [1.0, 3.0]];
    double[,] z = tensor.matmul(x, y);
    if (z[0,0] != 5.0 || z[0,1] != 7.5) return 4;
    if (z[1,0] != 2.0 || z[1,1] != 3.5) return 5;

    // int32 wraparound pin: each product term is 65536*65536, the 2x2
    // sum wraps to 0 — no silent widening to long
    int[,] big = tensor.reshape2(tensor.fullI(4, 65536), [2, 2]);
    int[,] w = tensor.matmul(big, big);
    if (w[0,0] != 0 || w[1,1] != 0) return 6;

    // long kind keeps 64-bit width: the same shape sums to 2^33
    long[,] lb = tensor.reshape2(tensor.fullL(4, 65536), [2, 2]);
    long[,] lw = tensor.matmul(lb, lb);
    if (lw[0,0] != 8589934592) return 7;

    // vector-like shapes: 1x3 * 3x1
    int[,] u = [[1, 2, 3]];
    int[,] v = [[4], [5], [6]];
    if (tensor.matmul(u, v)[0,0] != 32) return 8;
    return 0;
}
