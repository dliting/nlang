//foreach over an array VALUE via Dict subscript sugar: `d["k"]` on a
//Dict<string, int[]> — the value slot's type argument is the array
//token, so the subscript resolves to it like get() does. 0.7.3 B D10:
//accepted (was rejected at resolve time).
int main() {
	Dict<string, int[]> d = new Dict<string, int[]>();
	int[] v = [10, 20];
	d.set("k", v);
	int total = 0;
	foreach (int x in d["k"]) {
		total = total + x;
	}
	return total;
}
