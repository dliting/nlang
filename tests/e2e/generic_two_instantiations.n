// v0.12.3 Task 5: two instantiations of one template share the single
// compiled row yet keep distinct values — the per-object state lives in
// instances, not in the class (Review Focus #2: cross-talk would mean
// the row layout or the frames alias).
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
    public T get() { return item; }
}
int main() {
    Box<int> bi = Box(42);
    Box<string> bs = Box("str");
    if (bi.get() != 42) { return 1; }
    if (bs.get() != "str") { return 2; }
    return 0;
}
