// v0.13.7 regex: the D9 shapes that destroy backtracking engines must still
// answer correctly on the thread-set engine. This entry carries no wall-clock
// assertion: the routine gate trees run it in Debug, ASan and IDE flavours at
// once, and a time-capped fixture in three trees is a bet on machine load
// rather than a test (2026-11-13 and 2026-11-14 both saw a machine-wide
// 1.5-1.8x slowdown move readings across a cap, and the ASan tree measures
// ~1.76x the Debug time on this workload -- tests/CMakeLists.txt). The
// bounded-time half of D9 is asserted by the opt-in perf twin
// (stdlib_regex_redos_perf.n, registered under NLANG_PERF_TESTS), and an
// engine that went exponential again on
// these shapes would sit past the ctest ceiling below, which is a harness
// backstop rather than an assertion inside the program.
//
// The input sizes are a quarter of the perf twin's: they stay far above the
// point where a backtracking engine explodes ((a*)*b and ((a|aa)+)+b over
// thousands of 'a' are the classic killers), while keeping this entry inside
// about a minute per run so every routine gate leg pays for correctness, not
// for a soak.
import io;
import regex;

string nTimes(string unit, int n) {
    string r = "";
    for (int i = 0; i < n; i = i + 1) { r = r + unit; }
    return r;
}

int main() {
    int bad = 0;
    int n = 4000;
    string hay = nTimes("a", n) + "c";
    // Each shape must answer "no match" -- the trailing b is absent -- and
    // must do so without the engine falling off the linear bound.
    if (Regex("(a|a)*b").isMatch(hay)) { bad = bad + 1; }
    if (Regex("(a*)*b").isMatch(hay)) { bad = bad + 1; }
    if (Regex("((a|aa)+)+b").isMatch(hay)) { bad = bad + 1; }
    if (Regex("a*a*a*a*b").isMatch(hay)) { bad = bad + 1; }
    // unanchored scan over 32k of text: the thread-set simulation has no fast
    // path, so a miss is the same linear walk as a hit and must say so
    string longHay = nTimes("x", 16000) + nTimes("y", 16000);
    if (Regex("needle").isMatch(longHay)) { bad = bad + 1; }
    // a hit keeps its byte offsets across the same scan
    string hitHay = nTimes("x", 16000) + "needle";
    Match mh = Regex("needle").match(hitHay);
    if (mh == null) { return bad + 1; }
    if (mh.start != 16000 || mh.end != 16006) { bad = bad + 1; }
    io.print("redos shapes ok, bad=" + bad.toString() + "\n");
    return bad;
}
