int main() {
    //Lock: array negative-index access throws "array index out of bounds"
    //(mirrors List<T> negative-index behavior in list_negative_index_throws).
    //No C-style negative-wrap or Python-style from-end semantics.
    int[] arr = new int[3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    return arr[-1];
}
