//0.9.10 D2.4: a static method may share a name with an instance virtual
//method when the parameter lists differ (separate namespaces). The
//static is declared first so runtime name dispatch must skip it to
//reach the virtual method.
class A {
    public static int f(string s) { return s.length(); }
    public virtual int f(int x) { return x + 1; }
}
int main() {
    A a = A();
    return a.f(41) + A.f("hi");
}
