//v0.13.9 phase (2) record stabilization: a static struct slot owns ONE
//record for life. The first whole-value store establishes it; every
//later store writes into that record in place — independent values,
//no bleed from the stored-from local after its mutation (the
//allocation pin rides the unit suite; this file pins behavior).
struct P {
    int x;
    int y;
}
class Holder {
    public static P slot;
}
int main() {
    P p;
    p.x = 1;
    p.y = 2;
    Holder.slot = p;
    p.x = 9;
    if (Holder.slot.x != 1) { return 1; }
    P q;
    q.x = 5;
    q.y = 6;
    Holder.slot = q;
    q.x = 7;
    if (Holder.slot.x != 5 || Holder.slot.y != 6) { return 2; }
    return 42;
}
