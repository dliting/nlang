//A user generic template living in its own project unit: the
//constructor and get() are bodied members, the T field is one value
//slot whatever T binds. main.n (a different unit of the same project)
//instantiates the template — the dictionary model's cross-unit shape.
class Box<T>
{
    public T item;
    public Box(T v) { item = v; }
    public T get() { return item; }
}
