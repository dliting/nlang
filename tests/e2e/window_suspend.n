//P2-4: suspension inside a re-entrant evaluation window (implicit
//array formatting calling toString). yield parks the window; the
//scheduler pump serves the already-queued worker, then the window
//resumes in place and completes — join pins "w" before the final
//write.
import thread;
import io;

class Slow {
    public string toString() {
        thread.yield();
        return "slow-ok";
    }
}

void worker() {
    io.write("w");
}

int main() {
    Thread t = thread.spawn(worker);
    //A multi-carrier executor may hand the freshly spawned worker to
    //another carrier before main reaches the yield; then no worker sits
    //in the pump queue at the park, the window resumes at once, and the
    //two writes race on separate threads (observed as "[slow-ok]w|done").
    //The P2-4 semantics under test hold in both schedules; the sleep
    //collapses them into one: a carrier-stolen worker finishes its write
    //inside the sleep, a still-queued one is served by the pump before
    //the window resumes — so "w" deterministically lands first either way.
    thread.sleep(15);
    Slow[] arr = [Slow()];
    io.write(arr);
    thread.join(t);
    io.write("|done");
    return 0;
}
