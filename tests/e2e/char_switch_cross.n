//0.7.5 switch cross-forms: an int discriminant may carry char labels and
//a char discriminant may carry int labels — both normalize through the
//cast matrix into the shared Int key domain (code points).
int main() {
    int hits = 0;
    int n = '中' as int;   // 0x4E2D
    switch (n) {
        case '中': hits += 1;
        case 'a': hits += 10;
    }
    char c = 'a';
    switch (c) {
        case 97: hits += 100;
        case 'b': hits += 1000;
    }
    if (hits != 101) { return 1; }
    return 0;
}
