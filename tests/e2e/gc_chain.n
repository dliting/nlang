class Node { public int value; public Node next; }
int main() {
    Node current = new Node();
    current.value = 1;
    int i = 0;
    while (i < 20) {
        Node n = new Node();
        n.value = i + 2;
        current.next = n;
        current = n;
        i = i + 1;
    }
    //current.value = 21 (last node: i=19, value=19+2=21)
    return current.value;
}
