class C {
    public int _dummy;
}
int main() {
	//Phase 8e-9b: calling toString() through an Object-typed reference
	//(upcast) still works — the runtime class is read from the heap
	//header, so the intrinsic returns "C@<hex>" (not "Object@<hex>").
	//Verifies that INTR_Object_toString uses the heap header's classIdx
	//rather than any static type. Phase 5 D13: the class name in the
	//rendering is the qualified table key, so this program's C renders
	//as "class_tostring_via_object_ref.C@<hex>".
	C c = new C();
	Object o = c;
	string s = o.toString();
	//Length of the qualified "C@" prefix is 31; followed by at least 1
	//hex char => >= 32. We can't check the prefix directly without
	//substring support, but we can verify the format is NOT
	//"Object@..." (the ownerless builtin keeps its bare key, length 8+).
	if (s.length() >= 32 && s.length() <= 35) return 7;
	return 1;
}
