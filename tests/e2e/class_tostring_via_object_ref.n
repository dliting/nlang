class C {
    public int _dummy;
}
int main() {
	//Phase 8e-9b: calling toString() through an Object-typed reference
	//(upcast) still works — the runtime class is read from the heap
	//header, so the intrinsic returns "C@<hex>" (not "Object@<hex>").
	//Verifies that INTR_Object_toString uses the heap header's classIdx
	//rather than any static type. The class name in the rendering is
	//the leaf of the package-qualified table key (user-visible renders
	//name the type as source wrote it), so C renders as "C@<hex>".
	C c = new C();
	Object o = c;
	string s = o.toString();
	//"Object@..." would mean the STATIC type leaked into the render;
	//startsWith pins the runtime class directly (the string method
	//makes the prefix check explicit - no length arithmetic needed).
	if (s.startsWith("C@")) return 7;
	return 1;
}
