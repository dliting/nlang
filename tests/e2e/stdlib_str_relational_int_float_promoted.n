// stdlib_str_relational_int_float_promoted — the symmetric int/float
// promotion (Phase 8e-8 mechanism) extended to comparison operands.
// The old shortcut branch compared raw bit patterns: -2 < -1.5 read the
// float bits as int (-1077936128) → false; 0.5 < 1 read int 1 as a
// denormal float → false; 1 == 1.0 compared 1 with 0x3F800000 → false.
int main() {
    if (!(-2 < -1.5)) return 1;
    if (!(0.5 < 1)) return 2;
    if (!(1 == 1.0)) return 3;
    if (!(2 > 1.5)) return 4;
    if (!(1.5 != 2)) return 5;
    if (!(3 >= 3.0)) return 6;
    if (!(4 <= 4.0)) return 7;
    if (!(1.0 != 2)) return 8;
    int i = 3;
    float f = 3.5;
    if (!(i < f)) return 9;
    if (!(f > i)) return 10;
    if (i == f) return 11;
    return 0;
}
