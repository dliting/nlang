import io;
import shapes;

int inc(int n) { return n + 1; }

int main()
{
    shapes.Point p = shapes.Point(2, 3);
    if (p.x + p.y != 5) { return 9; }
    io.print(shapes.Point(1, 6).y);
    // 0.13.13a D-2(b): the qualified ctor tail binds a lambda or a named
    // function reference directly — the module type's func-typed formal
    // supplies the expected function type.
    shapes.Box b = shapes.Box((x) -> x + 1);
    if (b.f(2) != 3) { return 10; }
    shapes.Box c = shapes.Box(inc);
    if (c.f(4) != 5) { return 11; }
    return 0;
}
