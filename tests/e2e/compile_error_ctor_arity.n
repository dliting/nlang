//Round-14 finding, HIGH: constructor calls validate their argument count
//against the ctor's parameter range (required = formals without a
//default, total = all formals — defaults fill the trailing ones). Named
//arguments and out arguments stay rejected: the ctor lowering stages its
//arguments positionally and has no writeback path. Pre-fix every shape
//below compiled clean: missing args read uninitialized callParam slots,
//extras were silently dropped, named args hit codegen's unhandled-kind
//internal error. All shapes in one file: the resolver reports every
//error before the build fails.
class WithParams { int a; public int WithParams(int a) { this.a = a; } }
class NoCtor { int a; }

int main() {
    WithParams p1 = WithParams();       // missing required arg
    WithParams p2 = WithParams(1, 2);   // extra args
    WithParams p3 = WithParams(a = 1);  // named argument
    int x = 0;
    WithParams p4 = WithParams(out x);  // out argument
    NoCtor n = NoCtor(1);               // no ctor + args
    return 0;
}
