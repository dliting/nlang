// Scalar-left reverse division with no zero cells: 0 / a is legal (the
// scalar is the dividend; the array cells are the divisors) and yields
// all zeros. Pins the rdiv family's operand-direction semantics end to
// end on both backends.
import tensor;

int main() {
    int[] a = int[4];
    a[0] = 1;
    a[1] = 2;
    a[2] = 3;
    a[3] = 4;
    int[] b = 0 / a;
    if (b[0] != 0 || b[1] != 0 || b[2] != 0 || b[3] != 0)
        return 1;
    return 0;
}
