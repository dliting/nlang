// tensor reduction kernels: sum/max/min/mean/dot across element kinds,
// plus the empty-array identities (sum/dot yield zero).
import io;
import tensor;

int main() {
    // sum across kinds; int case uses negatives
    int[] ai = tensor.arange(-3, 3, 1);            // -3 -2 -1 0 1 2
    if (tensor.sum(ai) != -3) return 1;
    double[] ad = tensor.arange(0.0, 2.0, 0.5);    // 0 .5 1 1.5
    if (tensor.sum(ad) != 3.0) return 2;
    long s2 = 1;
    long e2 = 4;
    long st2 = 1;
    long[] al = tensor.arange(s2, e2, st2);
    if (tensor.sum(al) != 6) return 3;

    // max / min (int)
    if (tensor.max(ai) != 2) return 4;
    if (tensor.min(ai) != -3) return 5;
    if (tensor.max(ad) != 1.5) return 6;

    // mean returns double for every overload
    if (tensor.mean(ai) != -0.5) return 7;
    if (tensor.mean(tensor.arange(1, 5, 1)) != 2.5) return 8;

    // dot: double analytic value, int widens to long
    double[] x = tensor.arange(1.0, 3.0, 1.0);     // 1 2
    double[] y = tensor.arange(3.0, 5.0, 1.0);     // 3 4
    if (tensor.dot(x, y) != 11.0) return 9;
    int[] bi = tensor.fullI(3, 100000);
    if (tensor.dot(bi, bi) != 30000000000) return 10;   // int64 accumulate

    // empty-array identities
    if (tensor.sum(int[0]) != 0) return 11;
    if (tensor.dot(double[0], double[0]) != 0.0) return 12;
    return 0;
}
