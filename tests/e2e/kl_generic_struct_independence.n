// v0.13.0 D3: the constructor boundary deep-copies a struct argument —
// after b owns its record, mutating the caller's p must not show
// through (the multi-slot rejection used to stand in for this).
struct Point {
    int x;
    public Point(int a) { x = a; }
}
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
    public T get() { return item; }
}
int main() {
    Point p = Point(1);
    Box<Point> b = Box(p);
    p.x = 99;
    Point q = b.get();
    if (q.x != 1) return 1;
    if (p.x != 99) return 2;
    return 0;
}
