enum Single {
    Only;
}

enum Pair {
    Left, Right;
}

int main() {
    //Lone ';' tail (Java-style closing) with no methods: compiles and
    //the members stay usable. Accumulation body (trap 23): the matched
    //clause runs, the implicit exit must skip the following body.
    if (Single.Only != 0) return 1;
    int r = 0;
    switch (Pair.Left) {
        case Pair.Left:
            r = r + 1;
        case Pair.Right:
            r = r + 10;
    }
    if (r == 1) return 0;
    return 4;
}
