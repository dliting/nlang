// Bottom of a three-module chain (a imports b, b imports c). Two
// structs so S's index inside c is non-zero; the struct-typed formal
// of sumS and the S-returning mkS serialize their .nmod v1.12 type
// descriptors with c-local struct indices.
struct Pad { int z; }
struct S { int x; int y; }

S mkS(int x, int y) {
    S s;
    s.x = x;
    s.y = y;
    return s;
}

int sumS(S s) { return s.x + s.y; }
