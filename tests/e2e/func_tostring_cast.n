//Phase 13 Step 1: the as-cast and string-concat conversion paths produce
//the same "func name" rendering as the member form. Phase 5 D13: the
//rendered name is the function's qualified table key, so a project
//function renders "<package>.<name>".
int bar(int x) { return x; }

int main() {
    Func<int, int> f = bar;
    string a = f as string;
    string b = "" + f;
    if (a == "func func_tostring_cast.bar"
            && b == "func func_tostring_cast.bar") {
        return 0;
    }
    return 1;
}
