class Point { public int x; public int y; public int Point(int ax, int ay) { this.x = ax; this.y = ay; return 0; } }
int main() {
    List<Point> lst = {};
    lst.add(Point(10, 0));
    lst.add(Point(10, 0));
    lst.add(Point(10, 0));
    int sum = 0;
    foreach (Point p in lst) {
        sum = sum + p.x;
    }
    return sum;
}
