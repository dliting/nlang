//v0.13.9 phase (2) record stabilization: struct field stores update the
//field's EXISTING record in place. After obj.f = p, p and obj.f are
//independent values — mutating p never bleeds into the stored copy
//(independence pin; also the record-identity property the stabilization
//delivers, observable as the zero-allocation unit pin).
struct P {
    int x;
    int y;
}
class Box {
    public P f;
}
int main() {
    Box obj = Box();
    P p;
    p.x = 1;
    p.y = 2;
    obj.f = p;
    p.x = 9;
    if (obj.f.x == 1 && obj.f.y == 2 && p.x == 9) {
        return 42;
    }
    return 1;
}
