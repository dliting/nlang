// The join along an inner axis must agree with the host path on every
// backend: the [2,2] dense operands joined along axis 1 produce [2,4]
// with y's half in the last two columns (the device join kernel folds
// each destination cell through its join-axis coordinate).
import tensor;

int main() {
    string b = tensor.backend();
    if (b != "cpu" && b != "cuda") return 1;

    float[,] x = [[1.0f, 2.0f], [3.0f, 4.0f]];
    float[,] y = [[5.0f, 6.0f], [7.0f, 8.0f]];
    float[,] r = tensor.concat(x, y, 1);
    if (r[0, 2] != 5.0f || r[1, 3] != 8.0f) return 2;
    if (r[0, 0] != 1.0f || r[1, 1] != 4.0f) return 3;
    return 0;
}
