//0.9.10 D2.4: a zero-arg same-name static must not make super() look
//valid against a one-argument parent constructor. Before the fix the
//resolver accepted the call, codegen selected the real ctor and ncc
//crashed.
class A {
	public static int A() { return 5; }
	public int A(int x) { return x; }
}
class B : A {
	public int B() { super(); return 0; }
}
int main() {
	B b = B();
	return 0;
}
