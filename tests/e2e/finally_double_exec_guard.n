//Phase 9d-2: on the exception path the finally body must execute exactly
//once — the normal-path copy (finallyNormal) and the handler copy
//(finallyHandler) are disjoint regions; only the handler copy runs when
//an exception unwinds through.
class Box { public int v; }
int main() {
    Box b = new Box();
    try {
        try {
            throw new Exception("once");
        } finally {
            b.v = b.v + 1;
        }
    } catch (Exception e) {
        if (b.v == 1) { return 7; }
        return 1;
    }
}
