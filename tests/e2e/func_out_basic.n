//Phase 13 Step 2: delegate call through a reference formal — the func
//signature carries the & mark and the callee writes the caller's slot
//through the reference. 0.9.14 D-new-9: the callee also sees the
//caller's current value as the parameter's initial value (the inout
//contract, same as a direct call).
void grab(int& r) { r = r + 7; }

int main() {
    func<void, int&> f = grab;
    int box = 3;
    f(box);
    return box;  // 3 + 7 = 10
}
