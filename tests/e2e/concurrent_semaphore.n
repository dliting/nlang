//Native Semaphore (P2-1): acquire() parks at zero permits and release()
//hands the permit to the front waiter (FIFO order); tryAcquire() never
//parks. Probes: a park/wake round trip, the exact three-waiter delivery
//order, and the tryAcquire take/miss pair. The sleeps fix the park
//arrival order (A, B, C in the deque); each release is joined to the
//waiter it must wake before the next release, so the printed order
//holds under any carrier count (assert-after-synchronize).
import thread;
import io;

class Waiter {
    public Semaphore sem;
    public string tag;
    public void go() {
        sem.acquire();
        io.write(tag);
    }
}

int main() {
    //Park/wake: the first waiter parks on the empty semaphore.
    Semaphore gate = Semaphore(0);
    Waiter a = Waiter();
    a.sem = gate;
    a.tag = "A";
    Thread ta = thread.spawn(a.go);
    thread.sleep(5);
    //FIFO: B and C park behind A before the releases.
    Waiter b = Waiter();
    b.sem = gate;
    b.tag = "B";
    Waiter c = Waiter();
    c.sem = gate;
    c.tag = "C";
    Thread tb = thread.spawn(b.go);
    thread.sleep(5);
    Thread tc = thread.spawn(c.go);
    thread.sleep(5);
    //Delivery order: each release must reach the front waiter; joining
    //that waiter before the next release turns the wake-to-write edge
    //into a happens-before edge, so the letters print in deque order.
    gate.release();
    thread.join(ta);
    gate.release();
    thread.join(tb);
    gate.release();
    thread.join(tc);
    //tryAcquire: takes the one permit, then misses at zero.
    Semaphore pool = Semaphore(1);
    if (pool.tryAcquire()) {
        io.write("1");
    }
    if (!pool.tryAcquire()) {
        io.write("0");
    }
    return 0;
}
