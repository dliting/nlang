//K3 task 5 acceptance: the stdlib Semaphore (pure NLang, concurrent
//package) limits concurrency to its permit count. Four workers acquire,
//record the overlapping-holder peak under a mutex, yield inside the
//section to widen the overlap window, then release; joins give
//happens-before for the read. With two permits the peak is exactly 2 —
//lower would mean acquire() did not block, higher would mean permits
//leaked.
import concurrent;
import thread;
import io;

class Probe {
    public Semaphore sem;
    public Mutex gate;
    public int inside;
    public int peak;
    public void work() {
        sem.acquire();
        gate.lock();
        inside = inside + 1;
        if (inside > peak) {
            peak = inside;
        }
        gate.unlock();
        thread.yield();
        gate.lock();
        inside = inside - 1;
        gate.unlock();
        sem.release();
    }
}

int main() {
    Probe p = Probe();
    p.sem = Semaphore(2);
    p.gate = Mutex();
    Thread a = thread.spawn(p.work);
    Thread b = thread.spawn(p.work);
    Thread c = thread.spawn(p.work);
    Thread d = thread.spawn(p.work);
    thread.join(a);
    thread.join(b);
    thread.join(c);
    thread.join(d);
    io.print("peak=" + p.peak.toString());
    if (p.peak == 2) {
        return 0;
    }
    return 1;
}
