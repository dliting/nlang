//Native Semaphore (P2-1): acquire() parks at zero permits and release()
//hands the permit to the front waiter (FIFO order); tryAcquire() never
//parks. Probes: a park/wake round trip, the exact three-waiter wake
//order, and the tryAcquire take/miss pair. Single-carrier sleeps fix
//the park arrival order, so the wake order is deterministic.
import thread;
import io;

class Waiter {
    public Semaphore sem;
    public string tag;
    public void go() {
        sem.acquire();
        io.write(tag);
    }
}

int main() {
    //Park/wake: the first waiter parks on the empty semaphore.
    Semaphore gate = Semaphore(0);
    Waiter a = Waiter();
    a.sem = gate;
    a.tag = "A";
    Thread ta = thread.spawn(a.go);
    thread.sleep(5);
    //FIFO: B and C park behind A before the releases.
    Waiter b = Waiter();
    b.sem = gate;
    b.tag = "B";
    Waiter c = Waiter();
    c.sem = gate;
    c.tag = "C";
    Thread tb = thread.spawn(b.go);
    thread.sleep(5);
    Thread tc = thread.spawn(c.go);
    thread.sleep(5);
    gate.release();
    gate.release();
    gate.release();
    thread.join(ta);
    thread.join(tb);
    thread.join(tc);
    //tryAcquire: takes the one permit, then misses at zero.
    Semaphore pool = Semaphore(1);
    if (pool.tryAcquire()) {
        io.write("1");
    }
    if (!pool.tryAcquire()) {
        io.write("0");
    }
    return 0;
}
