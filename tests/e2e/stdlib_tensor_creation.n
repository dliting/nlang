// tensor creation surface: full/arange same-name overloads (the element
// kind comes from the typed arguments) plus the language's sized
// creation, which is already zero-filled — zeros needs no kernel.
import io;
import tensor;

int main() {
    // zero-filled sized creation (the zeros replacement)
    double[] zd = double[3];
    if (zd[0] != 0.0 || zd[2] != 0.0) return 1;

    // full: overload picked by the value's type
    int[] fi = tensor.full(4, 7);
    int sum = 0;
    foreach (int v in fi) sum = sum + v;
    if (sum != 28) return 2;
    double[] fd = tensor.full(3, 2.5);
    if (fd[2] != 2.5) return 3;
    float[] ff = tensor.full(3, 0.5f);
    if (ff[1] != 0.5f) return 4;
    long one = 1;
    long[] fl = tensor.full(3, one + 4);
    if (fl[2] != 5) return 5;
    double[] od = tensor.full(3, 1.0);          // ones via full
    if (od[1] != 1.0) return 6;

    // arange: overload picked by the argument types
    int[] ri = tensor.arange(10, 0, -3);         // 10 7 4 1
    if (ri.length() != 4) return 7;
    if (ri[0] != 10 || ri[3] != 1) return 8;
    double[] rd = tensor.arange(0.0, 1.0, 0.25); // 4 elems, last 0.75
    if (rd.length() != 4) return 9;
    if (rd[0] != 0.0 || rd[3] != 0.75) return 10;
    float[] rf = tensor.arange(0.0f, 1.0f, 0.5f);
    if (rf.length() != 2) return 11;
    if (rf[1] != 0.5f) return 12;
    long s = 0;
    long e = 8;
    long st = 2;
    long[] rl = tensor.arange(s, e, st);
    if (rl.length() != 4) return 13;
    if (rl[3] != 6) return 14;
    // exact match beats widening: int args give int[]
    int[] exact = tensor.arange(0, 4, 1);
    if (exact.length() != 4) return 15;

    // arange zero step raises the base Exception family
    try {
        double[] bad = tensor.arange(0.0, 1.0, 0.0);
        if (bad.length() != -1) return 16;   // unreachable
    } catch (Exception ex) {
        // expected
    }
    return 0;
}
