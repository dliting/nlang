//v0.12.3 dictionary model: a bound method reference to a bodied
//template member resolves through the identifier binding (the value
//channel, not the invoke collector) and executes against the template
//row's record. Exit = f() = 1.
class Box<T> {
    public int get() { return 1; }
}
int main() {
    Box<int> b = Box();
    func<int> f = b.get;
    return f();
}
