//0.13.1c: dispatch through an abstract-typed variable reaches the
//concrete override — the abstract declaration participates in the
//dispatch chain like any virtual method.
class Shape
{
    public virtual int area();
}
class Rect : Shape
{
    int m_w;
    int m_h;
    public Rect(int w, int h)
    {
        m_w = w;
        m_h = h;
    }
    public int area()
    {
        return m_w * m_h;
    }
}
int main()
{
    Shape s = Rect(3, 4);
    assert(s.area() == 12);
    return 0;
}
