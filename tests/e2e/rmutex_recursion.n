//Recursive acquisition: walk() locks at every recursion level and
//releases on unwind — depth 8 must balance to exactly zero (the
//third-party probe takes the lock afterwards).
import concurrent;
import thread;
import io;

class Walker {
    public ReentrantMutex m;
    public int depth;

    public void walk(int k) {
        m.lock();
        depth = depth + 1;
        if (k > 0) this.walk(k - 1);
        m.unlock();
    }
}

int main() {
    Walker w = Walker();
    w.m = ReentrantMutex();
    w.walk(7);
    if (w.depth != 8) return 1;
    if (!w.m.tryLock()) return 2;
    w.m.unlock();
    io.print("depth=8");
    return 6;
}
