//Producer exports a class with a public instance field and a public
//instance method. A pure-.ncu import rebuilds the class stub with the
//full member surface (0.9.12 NCU v2.7), so the consumer can construct
//the object and reach the field or method directly across the boundary.
class Calc {
	public int base;
	public Calc(int b) { base = b; }
	public int doubled() { return base * 2; }
}
