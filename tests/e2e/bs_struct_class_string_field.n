class Person {
    public string name;
    public int age;
}

struct Group {
    Person p;
}

int main() {
    ByteStream bs = new ByteStream();
    Person p = new Person();
    p.name = "alice";
    p.age = 30;
    Group g;
    g.p = p;
    bs.writeStruct(g);
    bs.reset();
    Group g2 = bs.readStruct("Group");
    if (g2.p.name == "alice") {
        return 1;
    }
    return 0;
}
