//v0.13.9 phase (2) record stabilization: List.set writes the element's
//EXISTING record in place. add(p) establishes the element record; the
//subsequent li[0] = p must update that record — p.x = 9 must not bleed
//into the element. Before the in-place arm the sugar stored p's raw
//handle (alias), so the pin read 9 and returned 1.
struct P {
    int x;
    int y;
}
int main() {
    List<P> li = {};
    P p;
    p.x = 1;
    p.y = 2;
    li.add(p);
    li[0] = p;
    p.x = 9;
    if (li[0].x == 1 && li[0].y == 2) {
        return 42;
    }
    return 1;
}
