// Device concat covers the outermost axis (0) only; any other axis raises
// Exception on the CUDA backend (the flat two-half copy is valid along
// axis 0 for any rank; every other axis interleaves the halves inside
// the destination). The host path handles every axis, so the test
// branches on the backend: the cpu leg checks the axis-1 join, the cuda
// leg expects the raise. Both legs exit 0.
import tensor;

int main() {
    string b = tensor.backend();
    if (b != "cpu" && b != "cuda") return 1;

    // two [2,2] dense payloads joined along the inner axis (axis 1).
    float[,] x = [[1.0f, 2.0f], [3.0f, 4.0f]];
    float[,] y = [[5.0f, 6.0f], [7.0f, 8.0f]];

    if (b == "cpu") {
        float[,] r = tensor.concat(x, y, 1);
        if (r[0, 2] != 5.0f || r[1, 3] != 8.0f) return 2;
        return 0;
    }

    try {
        tensor.concat(x, y, 1);
        return 3;
    } catch (Exception e) {
        return 0;
    }
}
