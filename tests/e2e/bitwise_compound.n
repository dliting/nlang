// v0.13.7 compound bitwise assignment: store-back in the declared type
// (spec D3, the += family).
import io;

class Holder {
    public int bits;
}

int main() {
    int bad = 0;
    int x = 12;
    x &= 10;
    if (x != 8) { bad = bad + 1; }
    x = 12;
    x |= 3;
    if (x != 15) { bad = bad + 1; }
    x = 12;
    x ^= 10;
    if (x != 6) { bad = bad + 1; }
    //byte row keeps its own width; an out-of-range literal like 200 is a
    //compile error (constant range gate, same as the += family)
    byte b = 12;
    b &= 10;
    if (b != 8) { bad = bad + 1; }
    byte n = -1;
    n &= 15;
    if (n != 15) { bad = bad + 1; }
    //long carrier keeps the high bits
    long m = 1099511627776;
    m &= 1099511627777;
    if (m != 1099511627776) { bad = bad + 1; }
    m = 0;
    m ^= 1099511627776;
    if (m != 1099511627776) { bad = bad + 1; }
    //field and subscript lvalues
    Holder h = Holder();
    h.bits = 12;
    h.bits |= 3;
    if (h.bits != 15) { bad = bad + 1; }
    int[] arr = [0, 0];
    arr[0] = 12;
    arr[0] ^= 10;
    if (arr[0] != 6) { bad = bad + 1; }
    arr[1] = 5;
    arr[1] &= 3;
    if (arr[1] != 1) { bad = bad + 1; }
    //for-update position
    int acc = 0;
    for (int i = 1; i < 8; i |= 1) {
        acc = acc + 1;
        if (i >= 1) { i = 8; }
    }
    if (acc != 1) { bad = bad + 1; }
    return bad;
}
