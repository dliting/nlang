// tensor.scatter: the write twin of gather — value semantics (a new
// array, `a` unchanged), per-position writes at the gather addressing,
// the scalar-values arm (broadcast), rank-2 axis-0. Exit 0 when every
// check holds.
import tensor;

int main() {
    int[] a = tensor.arange(0, 6, 1);
    int[] idx = int[3];
    idx[0] = 5;
    idx[1] = 0;
    idx[2] = 2;
    int[] v = int[3];
    v[0] = 100;
    v[1] = 200;
    v[2] = 300;
    int[] r = tensor.scatter(a, 0, idx, v);
    if (r[0] != 200 || r[1] != 1 || r[2] != 300 || r[3] != 3
        || r[4] != 4 || r[5] != 100) return 1;
    //Value semantics: `a` unchanged.
    if (a[0] != 0 || a[5] != 5) return 2;
    //The scatter∘gather identity: gathering the scattered positions
    //returns the values.
    int[] back = tensor.gather(r, 0, idx);
    if (back[0] != 100 || back[1] != 200 || back[2] != 300) return 3;
    //The scalar-values arm.
    int[] s = tensor.scatter(a, 0, idx, 42);
    if (s[0] != 42 || s[2] != 42 || s[5] != 42 || s[1] != 1) return 4;
    //Rank-2 axis-0 (the visit addressing).
    int[] dims = int[2];
    dims[0] = 2;
    dims[1] = 3;
    float[,] m = tensor.fullDimsF(dims, 0.0f);
    int[] idx2 = int[3];
    idx2[0] = 1;
    idx2[1] = 0;
    idx2[2] = 1;
    float[] v2 = tensor.fullF(3, 7.5f);
    float[,] ms = tensor.scatter(m, 0, idx2, v2);
    if (ms[0, 0] != 0.0f || ms[1, 0] != 7.5f) return 5;
    if (ms[0, 1] != 7.5f || ms[1, 1] != 0.0f) return 6;
    if (ms[1, 2] != 7.5f || ms[0, 2] != 0.0f) return 7;
    return 0;
}
