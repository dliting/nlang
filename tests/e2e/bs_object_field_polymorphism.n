class Animal { public int legs; }
class Dog : Animal { public int teeth; }
struct Kennel { Animal a; }

int main() {
    ByteStream bs = ByteStream();
    Dog d = Dog();
    d.legs = 4;
    d.teeth = 42;
    Kennel k;
    k.a = d;
    bs.writeStruct(k);
    bs.reset();
    Kennel k2 = bs.readStruct("Kennel");
    return k2.a.legs;
}
