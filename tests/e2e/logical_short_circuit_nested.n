//Nested chains: left associativity (a&&b)&&c — each link can short-
//circuit the rest.
int main() {
    bool a = false;
    bool b = true;
    bool c = true;
    //&& chain: first link false -> rest (1/0) must not run
    bool r1 = a && b && (1 / 0 == 0);
    //|| chain: first link true -> rest (1/0) must not run
    bool r2 = b || a || (1 / 0 == 0);
    //mixed: a true compound && result short-circuits ||'s right;
    //grouping is explicit (parenthesized), so precedence is not exercised
    bool r3 = (b && c) || (1 / 0 == 0);
    if (r1 != false) return 2;
    if (r2 != true) return 3;
    if (r3 != true) return 4;
    return 7;
}
