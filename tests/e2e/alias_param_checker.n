//Phase 13 Step 0 fix round (amended 0.9.x): an alias whose target does
//not name a type is rejected at the alias itself — the type-position
//shadow guard re-walks past the function binding and reports the named
//miss at the `using` line (formerly the cloned param slot reported
//"not a valid data type" further downstream).
using F = foo;

int foo() {
    return 1;
}

int bar(F x) {
    return 3;
}

int main() {
    return bar(1);
}
