// Phase 11 Step 0 canary: one namespace-qualified intrinsic call through
// the whole pipeline (resolver intercept -> OP_CallIntrinsic codegen ->
// .nmod -> VM execution).
int main() {
    float a = math.sqrt(4.0);   // exact float argument
    float b = math.sqrt(4);     // int literal auto-promoted (int->float)
    if (a == 2.0 && b == 2.0) {
        return 0;
    }
    return 1;
}
