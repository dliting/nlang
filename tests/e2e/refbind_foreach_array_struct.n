// v0.13.9 phase 3: a struct & loop variable binds the array record in
// place — member stores land in the element, not a per-iteration copy.
struct Point {
    int x;
    int y;
}

int main() {
    Point[] arr = Point[3];
    arr[0].x = 1;
    arr[1].x = 2;
    arr[2].x = 3;
    foreach (Point& p in arr) {
        p.x = p.x * 10;
    }
    return arr[0].x + arr[1].x + arr[2].x;
}
