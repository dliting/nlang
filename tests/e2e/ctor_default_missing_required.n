//P3: with defaults present, a ctor arity error names the accepted range.
//Vec(int x, int y = 3) accepts 1 or 2 arguments; zero is still rejected.
class Vec {
    public int a;
    public int b;
    public Vec(int x, int y = 3) { this.a = x; this.b = y;}
}

int main() {
    Vec v = Vec();
    return 0;
}
