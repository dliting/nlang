//0.7.5: Dict initializer keys are string literals by grammar; the
//lowering emits them as string constants and boxes with K's tag — a
//non-string K would store the string handle bits as the key. Reject;
//explicit set() covers other key types.
int main() {
    Dict<int, int> d = new Dict<int, int>{"a":1};
    return 0;
}
