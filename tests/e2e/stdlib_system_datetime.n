// system.DateTime: epoch decomposition, ISO 8601 round-trip,
// dayOfWeek, negative epochs, and malformed parse rejection.
import io;
import system;

int parseThrows(string s) {
    try {
        DateTime.parse(s);
    } catch (Exception e) {
        return 1;
    }
    return 0;
}

int main() {
    DateTime t = DateTime.fromUnixMillis(1767225600000);   // 2026-01-01T00:00:00Z
    if (t.toString() != "2026-01-01T00:00:00.000Z") { return 1; }
    if (t.dayOfWeek() != 4) { return 2; }                  // Thursday
    if (t.year != 2026 || t.month != 1 || t.day != 1) { return 3; }
    if (t.addMillis(-1).toString() != "2025-12-31T23:59:59.999Z") { return 4; }
    if (DateTime.parse("2026-01-01T00:00:00.123Z").toUnixMillis() != 1767225600123) { return 5; }
    DateTime e = DateTime.fromUnixMillis(-86400000);       // 1969-12-31
    if (e.toString() != "1969-12-31T00:00:00.000Z") { return 6; }
    if (e.dayOfWeek() != 3) { return 7; }                  // Wednesday
    // Sunday is the one weekday whose number differs between the
    // 0=Sunday and ISO 1=Monday conventions — pin the documented one.
    if (DateTime.parse("2026-01-04T00:00:00Z").dayOfWeek() != 0) { return 13; }
    if (DateTime.parse("2026-01-01T00:00:00Z").toUnixMillis() != 1767225600000) { return 8; }
    if (parseThrows("2026-01-01 00:00:00Z") != 1) { return 9; }
    if (parseThrows("2026-13-01T00:00:00Z") != 1) { return 10; }
    if (parseThrows("2026-02-30T00:00:00Z") != 1) { return 11; }
    if (DateTime.now().year < 2026) { return 12; }
    // Cross-checks against Hinnant's date.h (year_month_day::to_days /
    // from_days): the leap rules (four-year leap, century exception,
    // 400-year exception) and the negative-era branch of days_from_civil
    // (a pre-year-2 epoch round-trips through the y < 0 era guard; -1
    // covers the negative-remainder branch of civil_from_days).
    if (DateTime.parse("2024-02-29T00:00:00Z").day != 29) { return 18; }
    if (parseThrows("1900-02-29T00:00:00Z") != 1) { return 19; }
    if (DateTime.parse("2000-02-29T00:00:00Z").day != 29) { return 20; }
    if (DateTime.fromUnixMillis(-1).toUnixMillis() != -1) { return 21; }
    if (DateTime.fromUnixMillis(-62167219200000).toUnixMillis() != -62167219200000) { return 22; }
    // Final review I3: toInt accepts a leading sign, so every field must
    // be all-digits before conversion — otherwise "T-1:00" normalizes
    // silently into the previous day and a signed year pads to text
    // toString can never reparse. The parse domain is exactly the
    // closed 4-digit-year form toString emits.
    if (parseThrows("2026-01-01T-1:00:00Z") != 1) { return 23; }
    if (parseThrows("2026-01-01T00:-1:00Z") != 1) { return 24; }
    if (parseThrows("+026-01-01T00:00:00Z") != 1) { return 25; }
    if (parseThrows("-026-01-01T00:00:00Z") != 1) { return 26; }
    io.print("ok");
    return 0;
}
