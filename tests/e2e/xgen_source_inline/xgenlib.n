//The inlined library sibling (the source-inline flow): the consumer's
//import "xgenlib" discovers this very file through the library-source
//search and parses it as a library translation unit into the SAME
//compilation — no .ncu stub, no nlink merge. Its generic template's
//descriptor spelling carries the package head ("xgenlib.Pipe<int>"),
//which the consumer image must admit at runtime intern or the first
//cast/new below is a corrupt-image error (spec item 8, D8.3).
class Pipe<T>
{
    public T item;
    public Pipe(T v) { item = v; }
    public T get() { return item; }
}
