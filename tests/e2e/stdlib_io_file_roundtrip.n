// stdlib_io_file_roundtrip — io.writeFile creates/truncates, io.readFile
// returns the exact bytes written ('\n' escape round-trips).
int main() {
    io.writeFile("_p11_tmp/rt.txt", "line1\nline2");
    string s = io.readFile("_p11_tmp/rt.txt");
    if (s != "line1\nline2") return 1;
    //Truncate on rewrite: a second writeFile replaces the content.
    io.writeFile("_p11_tmp/rt.txt", "short");
    string t = io.readFile("_p11_tmp/rt.txt");
    if (t != "short") return 2;
    return 0;
}
