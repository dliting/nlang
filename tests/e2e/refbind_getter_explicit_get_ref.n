// Task 6: the explicit .get(i) spelling in a & binding aliases the
// element record like the subscript sugar.
struct Point {
    int x;
    int y;
}

int main() {
    List<Point> pts = {};
    Point p0;
    p0.x = 1;
    p0.y = 2;
    pts.add(p0);
    Point& r = pts.get(0);
    r.x = 9;
    return pts[0].x;
}
