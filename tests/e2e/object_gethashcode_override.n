class Point {
    public int x;
    public int y;
    int getHashCode() {
        return this.x * 31 + this.y;
    }
}

int main() {
    Point p = new Point();
    p.x = 2;
    p.y = 3;
    int hc = p.getHashCode();
    int expected = 2 * 31 + 3;
    if (hc == expected) {
        return 1;
    }
    return 0;
}
