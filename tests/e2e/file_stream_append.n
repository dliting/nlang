int main() {
    FileStream fs = new FileStream("_phase8_tmp/test_append.bin", "w");
    fs.WriteInt(1);
    fs.Close();
    FileStream fs2 = new FileStream("_phase8_tmp/test_append.bin", "a");
    fs2.WriteInt(2);
    fs2.Close();
    FileStream fs3 = new FileStream("_phase8_tmp/test_append.bin", "r");
    int a = fs3.ReadInt();
    int b = fs3.ReadInt();
    fs3.Close();
    return a + b;
}
