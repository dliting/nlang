//compile_error: the Dict VALUE side is also what subscript sugar returns
//(type arg 1) — the switch discriminant gate must reject it.
int main() {
    Dict<string, int[]> d = new Dict<string, int[]>();
    int[] a = new int[1];
    a[0] = 7;
    d.set("k", a);
    switch (d["k"]) {
        case 1: return 1;
        default: return 2;
    }
}
