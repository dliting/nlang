//v0.13.9 phase (2) record stabilization: struct element stores update
//the element's EXISTING record in place. After arr[0] = p, p and the
//element are independent values — mutating p never bleeds into the
//array (independence pin; the zero-allocation property rides the unit
//pin).
struct P {
    int x;
    int y;
}
int main() {
    P e0;
    e0.x = 1;
    e0.y = 2;
    P e1;
    e1.x = 3;
    e1.y = 4;
    P[] arr = [e0, e1];
    P p;
    p.x = 1;
    p.y = 2;
    arr[0] = p;
    p.x = 9;
    if (arr[0].x == 1 && arr[0].y == 2 && arr[1].x == 3 && p.x == 9) {
        return 42;
    }
    return 1;
}
