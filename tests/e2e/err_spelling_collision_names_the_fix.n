// err_spelling_collision_names_the_fix.n — 0.13.1c: rescuable collision
// shapes re-read as comparisons and run; a collision whose comparison
// re-read does not parse (here: the misread call carries no argument at
// all, so the fragment fails) falls back to the diagnostic naming the
// situation and the parenthesized fix (not a bare cannot-resolve).
bool both(bool lt, bool gt) {
    return lt && gt;
}
int main() {
    int a = 1;
    int b = 2;
    int c = 5;
    if (!both(a < b, c > ())) {
        return 1;
    }
    return 0;
}
