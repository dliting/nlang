// tensor.sigmoid / tensor.tanh: monotone activations with the classic
// anchor values, tolerances at libm-reference precision.
import tensor;

int main() {
    float[] z = tensor.fullF(5, 0.0f);
    z[0] = -2.0f; z[1] = -1.0f;
    z[3] = 1.0f; z[4] = 2.0f;
    float[] sg = tensor.sigmoid(z);
    if (sg[2] < 0.4999f || sg[2] > 0.5001f) return 1;
    if (sg[0] > 0.13f || sg[0] < 0.11f) return 2;
    if (sg[4] < 0.88f || sg[4] > 0.89f) return 3;
    //monotone
    if (!(sg[0] < sg[1] && sg[1] < sg[2] && sg[2] < sg[3]
          && sg[3] < sg[4])) return 4;

    float[] th = tensor.tanh(z);
    if (th[2] > 0.0001f || th[2] < -0.0001f) return 5;
    if (th[0] < -0.97f || th[0] > -0.95f) return 6;
    if (th[4] < 0.95f || th[4] > 0.97f) return 7;

    double[] zd = tensor.arange(-20.0, 21.0, 10.0);
    double[] thd = tensor.tanh(zd);
    if (thd[0] != -1.0 || thd[2] != 0.0 || thd[4] != 1.0) return 8;
    return 0;
}
