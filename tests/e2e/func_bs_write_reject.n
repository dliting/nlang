//Phase 13 Step 2: serializing a struct with a Func field must fail
//cleanly at RUNTIME (named throw, exit 1) — a silent skip would look
//successful and lose the field on read-back.
int dbl(int x) { return x * 2; }

struct Boxed {
    Func<int, int> f;
}

int main() {
    ByteStream bs = new ByteStream();
    Boxed b;
    b.f = dbl;
    bs.writeStruct(b);
    return 0;
}
