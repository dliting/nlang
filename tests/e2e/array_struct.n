struct Point {
    int x;
    int y;
}

//Phase 9d-3: struct-array elements are materialized at allocation
//(AllocArrayOnHeap eagerly allocates a fresh struct per element,
//mirroring AllocStructOnHeap's recursive nested-field materialization).
int main() {
    Point[] arr = new Point[2];
    arr[0].x = 1;
    arr[0].y = 2;
    arr[1].x = 3;
    arr[1].y = 4;
    return arr[1].x;
}
