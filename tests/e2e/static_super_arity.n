//0.9.10 D2.4: super(...) arity comes from the real constructor, never
//from a same-name static declared earlier.
class A {
	public int v;
	public static int A() { return 5; }
	public int A(int x) { this.v = x + 1; return 0; }
}
class B : A {
	public int B() { super(6); return 0; }
}
int main() {
	B b = B();
	return b.v;
}
