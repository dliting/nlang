// v0.13.0 review finding: arithmetic on a type-parameter-typed operand
// inside a shared generic body compiled silently against the raw slot.
// Named compile error until runtime kind info lands (the design doc's
// dictionary model defers kind-dependent operators with it).
class Box<T> {
    public T item;
    public Box(T v) { item = v; }
    public T sum(Box<T> other) { return item + other.item; }
}
int main() { return 0; }
