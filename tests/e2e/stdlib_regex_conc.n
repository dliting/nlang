// v0.13.7 regex: one shared const Regex across carriers (D7). The sidecar
// flags file runs this under --carriers=4; the pre-commit sweep reruns it
// 100 times under ASan (single green runs do not count, 0.12.6 precedent).
import io;
import regex;
import thread;

class Scan {
    public Regex re;
    public string input;
    public int hits;
    public int bad;
    public Scan(Regex sharedRe, string src) {
        re = sharedRe;
        input = src;
        hits = 0;
        bad = 0;
    }
    public void run() {
        List<Match> ms = re.matches(input);
        int h = ms.length();
        for (int i = 0; i < ms.length(); i = i + 1) {
            if (ms[i].group("value") == "") { bad = bad + 1; }
        }
        if (re.replaceAll(input, "$${value};") != "1; 2; 3;") { bad = bad + 1; }
        hits = h;
    }
}

int main() {
    Regex shared = Regex("(?P<key>\\w+)=(?P<value>\\d+)");
    Scan[] ss = Scan[8];
    Thread[] ws = Thread[8];
    for (int i = 0; i < 8; i = i + 1) {
        ss[i] = Scan(shared, "x=1 y=2 z=3");
        ws[i] = thread.spawn(ss[i].run);
    }
    for (int i = 0; i < 8; i = i + 1) { thread.join(ws[i]); }
    int bad = 0;
    for (int i = 0; i < 8; i = i + 1) {
        if (ss[i].hits != 3) { bad = bad + 1; }
        if (ss[i].bad != 0) { bad = bad + 1; }
    }
    return bad;
}
