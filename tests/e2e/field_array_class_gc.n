class Box {
    public int[] a;
}

//9d-3 audit: array-typed class field kept live across a real GC
//(class-instance branch of MarkPhase, declared-kind RTK_Array route).
int main() {
    Box b = Box();
    b.a = int[2];
    b.a[0] = 7;
    int n = 0;
    while (n < 1500) {
        Box t = Box();
        n = n + 1;
    }
    return b.a[0];
}
