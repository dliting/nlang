// v0.12.3 Task 1 window pin, flipped by Task 5's registration topology:
// instance construction now executes through the template row, so the
// concrete-typed field initializer runs and count reads 5 (a T-typed
// initializer stays rejected by the declaration contract).
class Box<T> {
    public int count = 5;
    public T item;
}
int main() {
    Box<int> b = Box();
    return b.count;
}
