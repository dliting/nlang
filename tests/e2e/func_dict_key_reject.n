//Phase 13 Step 2: Dict keyed by a func type is rejected — DictKeysEqual
//is identity for non-boxed/class/struct keys, so two references to the
//same function would store as two entries.
int dbl(int x) { return x * 2; }

int main() {
    Dict<func<int, int>, int> d = new Dict<func<int, int>, int>();
    d[dbl] = 1;
    return 0;
}
