class Box {
    public int v;
    public Box wrap(int x) {
        Box b = new Box();
        b.v = x;
        return b;
    }
}

//Method chaining: each call returns a fresh Box, so the chain
//`b.wrap(5).wrap(7).wrap(9)` evaluates left-to-right and the final
//.v reads the most recently wrapped value (9). Not previously covered
//by e2e tests — verifies receiver-expression evaluation passes through
//chained method calls without temp-slot aliasing.
int main() {
    Box b = new Box();
    return b.wrap(5).wrap(7).wrap(9).v;
}
