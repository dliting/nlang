int pick(int x) {
    switch (x) {
        case 1, 2, 3: return 10;
        default: return 90;
    }
}

int main() {
    //Three labels per clause: first / middle / last each enter the body
    //(intermediate labels use the dual-jump shape; the last uses the
    //single JumpIfNot-to-next-clause). All misses reach default.
    if (pick(1) != 10) return 1;
    if (pick(2) != 10) return 2;
    if (pick(3) != 10) return 3;
    if (pick(4) != 90) return 4;
    return 0;
}
