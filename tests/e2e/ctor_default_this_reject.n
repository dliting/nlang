//P3 review Important-2 (explicit form): a ctor default cannot reference
//`this`. Defaults evaluate at the call site, where the object under
//construction does not exist yet — the reference used to fall back to
//the caller's local 0 and silently read the caller's object (or crash
//with a null reference from main).
class Vec {
    public int a;
    public int b;
    public Vec(int x, int y = this.a) {
        this.a = x; this.b = y;    }
}

int main() {
    Vec v = Vec(7);
    return 0;
}
