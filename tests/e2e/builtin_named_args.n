// builtin-decls phase 2 (0.11.10) delta 2: container methods are DECLARED
// members now, so named arguments bind by formal name (the by-name
// dispatch reject retired with the special arm).
int main() {
    List<int> l = [1, 2];
    l.add(item = 5);
    Dict<string, int> d = {};
    d.set(key = "a", value = 1);
    if (l.get(2) != 5 || d.get("a") != 1) { return 1; }
    return 0;
}
