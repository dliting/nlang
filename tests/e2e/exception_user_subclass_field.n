//Phase 9d: user Exception subclass field access. message/backtrace/cause
//are inherited from Exception (cell[1]/cell[3]/cell[5]) and the subclass's
//own code field lands at cell[7]. Verifies no aliasing between inherited
//and own fields (an earlier bug had them sharing cell[1], passing by
//coincidence). v0.12.4: Exception is const, so the subclass is const too
//and both fields are set through the declaring constructor.
const class MyException : Exception {
    public int code;
    public MyException(int c, string m) { super(m); this.code = c; }
}

int main() {
    MyException e = MyException(5, "custom");
    try {
        throw e;
    } catch (MyException e2) {
        //message is "custom" (6 bytes), code is still 5.
        int msgLen = e2.message.length();   // 6
        int code = e2.code;                 // 5
        return msgLen * 10 + code;          // 65
    }
    return 0;
}
