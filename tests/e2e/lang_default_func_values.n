//0.13.13a D-1: a func-typed parameter may carry a lambda or a function
//reference as its default value. The closure environment is established
//at the call site, so a default lambda snapshots the arguments of that
//call — two call sites of the same defaulted parameter capture different
//values — and a method-hosted lambda captures the call site's receiver.

class Knob {
    public static int tick() { return 7; }
}

int step(int n, func<int, int> g = (x) -> x + n) {
    return g(3);
}

class Ctr {
    public int m_base;
    public Ctr(int b) { this.m_base = b; }
    public int shift(int d, func<int, int> f = (x) -> x + this.m_base) {
        return f(d);
    }
}

int useTick(func<int> g = Knob.tick) {
    return g();
}

int handler(int n, func<int, int> h = (x) -> {
    int m = 7;                          // a body local captured by a nested lambda
    func<int, int> b = (z) -> z + m;
    return b(x);
}) {
    return h(1);
}

int shadow(int n, func<int, int> g = (x) -> {
    func<int, int> a = (y) -> y + n;    // the host formal n (snapshot cell)
    int n = 7;                          // a body local of the same name (mirror cell)
    func<int, int> b = (z) -> z + n;    // the body local n
    return a(x) + b(x);
}) {
    return g(1);
}

struct Dot { int p; }

int at(int k, Dot d, func<int, int> g = (y) -> y + d.p) {
    return g(k);
}

class Cfg {
    public int v;
    public Cfg(int p) { this.v = p; }
    public int get() { return this.v; }
}

int pick(int k, Cfg c, func<int, int> g = (x) -> x + c.get()) {
    return g(k);
}

int bump(int n, func<int, int> g = (x) -> x + n) {
    n = n + 100;                        // the host re-binds n after the closure was built
    return g(1);
}

int own(int n, func<int, int> g = (x) -> {
    func<int, int> b = (z) -> z + x;   // a nested lambda capturing the default lambda's own formal x
    return b(n) + x;
}) {
    return g(2);
}

int main() {
    if (step(5) != 8) { return 1; }                  // g(3) = 3 + 5
    if (step(100) != 103) { return 2; }              // this call captures its own n
    if (step(2, (x) -> x * 10) != 30) { return 3; }  // an explicit argument wins
    Ctr c = Ctr(20);
    if (c.shift(1) != 21) { return 4; }              // the lambda sees c's field
    Ctr other = Ctr(1000);
    if (other.shift(1) != 1001) { return 5; }        // a second receiver, its own value
    if (useTick() != 7) { return 6; }                // the default names a static method
    if (handler(3) != 8) { return 7; }               // 1 + 7 through the nested lambda
    if (shadow(3) != 12) { return 8; }               // (1 + 3) + (1 + 7), two distinct cells
    Dot d; d.p = 3;
    Dot otherDot; otherDot.p = 4;
    if (at(1, d) != 4) { return 9; }                 // a struct-typed formal, this call's value
    if (at(2, otherDot) != 6) { return 10; }         // a second call site, its own struct
    if (pick(1, Cfg(3)) + pick(2, Cfg(4)) != 10) { return 11; }  // class-typed formals
    if (bump(3) != 4) { return 12; }                 // the snapshot froze n at bind time
    if (own(5) != 9) { return 13; }                  // (5 + 2) + 2 through the default's own formal
    return 0;
}
