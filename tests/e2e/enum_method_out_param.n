// v0.13.9 phase 4: out on an enum method hits the single declaration
// retirement throat (the enum-specific check is gone).
enum Scale {
    One, Two;

    public int split(out int o) {
        o = this * 10;
        return this;
    }
}

int main() {
    int o = 0;
    return Scale.Two.split(o);
}
