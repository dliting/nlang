//v0.13.0 D2: struct ==/!= compare by field value (OP_Eq_struct/
//OP_Ne_struct) — the same deep equality as the container entries, so
//contains(p) and get(i) == p agree. Identity comparison made copies of
//equal values unequal.
struct Point {
    int x;
    int y;
    public Point(int a, int b) { x = a; y = b; }
}

int main() {
    Point a = Point(1, 2);
    Point b = Point(1, 2);
    Point c = Point(3, 4);
    if (!(a == b)) return 1;
    if (a != b) return 2;
    if (a == c) return 3;
    if (!(a != c)) return 4;
    return 0;
}
