// stdlib_fs_size_missing_caught — size() raises IOException (not the
// base Exception) both on a missing path and on a directory: fs failures
// map to IOException per the Phase 11 exception mapping, and size is
// defined for regular files only.
import fs;
int main() {
    try {
        int s = fs.size("_p11_tmp/fs_missing/nope.txt");
        return 1;  //should have thrown
    } catch (IOException e) {
        if (e.message == "") return 2;
    }
    fs.makeDirs("_p11_tmp/fs_missing/dir");
    try {
        int s = fs.size("_p11_tmp/fs_missing/dir");
        return 3;  //should have thrown (not a regular file)
    } catch (IOException e) {
        if (e.message == "") return 4;
    }
    return 0;
}
