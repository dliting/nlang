//Task 7 (spec §3.4): equality is the four-slot func record comparison.
//Same-activation: one display instance per activation, so two evaluations
//of one literal site compare equal; a factory called twice allocates two
//display instances and compares unequal.
func<int> makeCounter() {
    int n = 0;
    return () -> n + 1;
}

int main() {
    int c = 0;
    List<func<int>> fs = List<func<int>>();
    int i = 0;
    while (i < 2) {
        fs.add(() -> c + 1);
        i = i + 1;
    }
    if (fs.get(0) != fs.get(1)) {
        return 1;
    }
    func<int> p = makeCounter();
    func<int> q = makeCounter();
    if (p == q) {
        return 2;
    }
    if (p() != 1 || q() != 1) {
        return 3;
    }
    return 0;
}
