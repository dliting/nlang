//0.7.5: the element wrap must define the full 8-byte slot — without
//it the boxing plan read the claim slot's stale upper bytes left by
//the earlier call's argument staging.
long helper(long a, long b) { return a + b; }
int main() {
    long r = helper(4294967295, 4294967295);
    List<long> a = new List<long>{1};
    if (a.get(0) != 1) return 1;
    if (r != 8589934590) return 2;
    return 0;
}
