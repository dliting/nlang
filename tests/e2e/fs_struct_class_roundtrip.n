class Holder { public int v; }
struct S { Holder h; }

int main() {
    FileStream stream = new FileStream("_phase8_tmp/struct_class_roundtrip.bin", "w");
    Holder h = new Holder();
    h.v = 42;
    S s;
    s.h = h;
    stream.writeStruct(s);
    stream.close();
    FileStream stream2 = new FileStream("_phase8_tmp/struct_class_roundtrip.bin", "r");
    S s2 = stream2.readStruct("S");
    stream2.close();
    return s2.h.v;
}
