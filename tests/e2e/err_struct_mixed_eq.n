//v0.13.0 D2: comparing structs of different types used to compile and
//compare raw heap indices (always false); the gate names the rule.
struct Point {
    int x;
    public Point(int a) { x = a; }
}
struct Vec {
    int x;
    public Vec(int a) { x = a; }
}

int main() {
    Point a = Point(1);
    Vec b = Vec(1);
    if (a == b) { return 1; }
    return 0;
}
