//compile_error: a function of a generic class cannot be referenced as
//a func value (0.13.1a) — its behavior needs an instantiation context
//and a func value carries none. Call it directly (through an instance
//or a static chain); a bound instance reference keeps working because
//the receiver's head descriptor fills the frame cell on every call.
class Tag<T> {
    public static string tag() { return typeName(T); }
}
int main() {
    func<string> f = Tag.tag;
    return 0;
}
