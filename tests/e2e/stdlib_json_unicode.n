// v0.13.11 json: unicode escapes and raw bytes -- surrogate pairing, lone
// halves mapped to U+FFFD, offsets counting bytes not code points (D-6).
import io;
import json;

// Returns 0 when io.toBytes(text) matches want unsigned byte for byte.
int checkBytes(string text, int[] want) {
    byte[] got = io.toBytes(text);
    if (got.length() != want.length()) {
        io.print("bytes len " + got.length() + " want " + want.length());
        return 1;
    }
    int i = 0;
    while (i < want.length()) {
        int b = got[i];
        if (b < 0) { b = b + 256; }
        if (b != want[i]) {
            io.print("bytes at " + i + " got " + b + " want " + want[i]);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Returns 0 when parse(text) raises the exact wanted message.
int checkParseMessage(string text, string want) {
    string got = "";
    try {
        json.parse(text);
    } catch (JsonException e) {
        got = e.message;
    }
    if (got == want) { return 0; }
    io.print("parse row [" + text + "] got [" + got + "] want [" + want + "]");
    return 1;
}

int main() {
    int bad = 0;
    // BMP escapes decode to UTF-8 (NUL stays a legal one-byte character).
    if (checkBytes(json.parse("\"\\u0041\"").getString(), [65]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\u00e9\"").getString(), [195, 169]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\u20ac\"").getString(), [226, 130, 172]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\u0000\"").getString(), [0]) != 0) { bad = bad + 1; }
    // A surrogate pair becomes one astral code point; lone halves become
    // U+FFFD, and the non-surrogate after a high half stays itself (D-6).
    if (checkBytes(json.parse("\"\\ud83d\\ude00\"").getString(), [240, 159, 152, 128]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\ud800\"").getString(), [239, 191, 189]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\udc00\"").getString(), [239, 191, 189]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\ud800A\"").getString(), [239, 191, 189, 65]) != 0) { bad = bad + 1; }
    // A second escape right after a high half is replayed, so it still
    // decodes as the escape it is instead of being eaten by the pair.
    if (checkBytes(json.parse("\"\\ud800\\u0041\"").getString(), [239, 191, 189, 65]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\ud800\\ud800\"").getString(), [239, 191, 189, 239, 191, 189]) != 0) { bad = bad + 1; }
    // Raw bytes at or above 0x80 pass through the parser and the
    // serializer untouched (no re-encoding, D-6).
    byte[] rawDoc = byte[4];            // "e-acute" as one UTF-8 string token
    rawDoc[0] = 34;
    rawDoc[1] = 195 as byte;
    rawDoc[2] = 169 as byte;
    rawDoc[3] = 34;
    JsonValue raw = json.parse(io.fromBytes(rawDoc));
    if (checkBytes(raw.serialize(), [34, 195, 169, 34]) != 0) { bad = bad + 1; }
    // Offsets count bytes: after the é document the BOM starts at offset 4
    // (2 decoded characters would put a code-point offset elsewhere).
    byte[] bomTail = byte[7];
    bomTail[0] = 34;
    bomTail[1] = 195 as byte;
    bomTail[2] = 169 as byte;
    bomTail[3] = 34;
    bomTail[4] = 239 as byte;
    bomTail[5] = 187 as byte;
    bomTail[6] = 191 as byte;
    if (checkParseMessage(io.fromBytes(bomTail), "json: unexpected data after top-level value at byte offset 4") != 0) { bad = bad + 1; }
    // Only bytes below 0x20 get escaped (D-7): DEL (127) passes through;
    // U+001F serializes as the six-character lowercase escape.
    byte[] delDoc = byte[3];
    delDoc[0] = 34;
    delDoc[1] = 127;
    delDoc[2] = 34;
    if (checkBytes(json.parse(io.fromBytes(delDoc)).serialize(), [34, 127, 34]) != 0) { bad = bad + 1; }
    if (checkBytes(json.parse("\"\\u001f\"").serialize(), [34, 92, 117, 48, 48, 49, 102, 34]) != 0) { bad = bad + 1; }
    return bad;
}
