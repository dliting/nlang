// 0.9.0 semantic restriction: a local named like a visible class is a
// compile error (the 0.9.x allow-and-rebind behavior was retired).
class Point {
    public int x;
    public int Point(int a) { this.x = a; return 0; }
}

int main() {
    Point[] pts = Point[3];
    pts[0] = Point(11);
    int[] Point = int[2];
    Point[1] = 5;
    return pts[0].x + Point[1];
}
