//0.8.4: nested subscript compound over List<List<int>>
//(jagged int[][] is rejected; List<List<T>> is the 2-D form).
int main() {
	List<List<int>> m = new List<List<int>>();
	List<int> r0 = new List<int>();
	r0.add(100);
	r0.add(1);
	m.add(r0);
	m[0][0] += 4;
	m[0][1] *= 10;
	return m[0][0] / 2 + m[0][1];
}
