// tensor_view_operand_reads — the flat-addressing kernels (matmul,
// concat) must start a contiguous view's cells at the view's offset,
// not at the owning array's element zero. A row-block view at a nonzero
// offset is the probe: wrong reads surface the owner's first rows.
import tensor;

int main() {
    //6x4 source with a distinct value per cell: m[r][c] = r*10 + c.
    float[,] m = float[6, 4];
    for (int r = 0; r < 6; r += 1) {
        for (int c = 0; c < 4; c += 1) {
            float v = r * 10 + c;
            m[r, c] = v;
        }
    }
    float[,] blk = m[2:5, :];   //offset 8 elements: rows 2, 3, 4

    int bad = 0;

    //matmul probe: blk @ e0 (column selector) yields blk's column 0 =
    //20, 30, 40. Reading the owner's first rows instead yields 0, 10, 20.
    float[,] e0 = float[4, 1];
    e0[0, 0] = 1.0;
    float[,] got = tensor.matmul(blk, e0);
    for (int r = 0; r < 3; r += 1) {
        float want = m[2 + r, 0];
        if (got[r, 0] != want) {
            bad = bad + 1;
        }
    }

    //concat probe: blk ++ one fresh row along axis 0. The first three
    //result rows must be the source rows 2..4, not 0..2.
    float[,] tail = float[1, 4];
    tail[0, 0] = 90.0;
    float[,] cat = tensor.concat(blk, tail, 0);
    if (cat.length() != 16) {
        bad = bad + 100;
    }
    for (int r = 0; r < 3; r += 1) {
        for (int c = 0; c < 4; c += 1) {
            if (cat[r, c] != m[2 + r, c]) {
                bad = bad + 1;
            }
        }
    }
    if (cat[3, 0] != 90.0 || cat[3, 3] != 0.0) {
        bad = bad + 1;
    }
    return bad;
}
