//Phase 13 Step 1 (review round-1 F1): the positive face of the same
//fix — a reference to a func-returning function binds against the
//matching higher-order expected type, and invoking through the returned
//handle works end to end.
int bar(int x) { return x + 1; }

func<int, int> pick() { return bar; }

int apply(func<int, int> f, int x) { return f(x); }

int main() {
    func<func<int, int>> g = pick;
    func<int, int> h = g();
    return apply(h, 1);
}
