//0.9.10 D3: every constant value channel. Wide integers stay integral,
//a float-category declared type widens from an integer initializer,
//and null emits a full zero cell (string handle and 8-byte scalar).
//Expected exit code: 0 + 123 + 1 + 7 + 100 = 231.
interface Types {
	public static const long BIG = -7000000000;
	public static const long MIN_LONG = -9223372036854775808;
	public static const ulong U = 123;
	public static const float F = 1.5;
	public static const double WIDE = 7;
	public static const byte B = 100;
	public static const string S = null;
	public static const long NULL_LONG = null;
}

int main() {
	if (Types.S != null || Types.NULL_LONG != 0)
		return 1;
	//The one legal negated ulong (2^63) folds to long INT64_MIN; the
	//backend's negation arm must mirror the declaration-side classifier.
	long minLong = -9223372036854775808;
	if (Types.MIN_LONG != minLong)
		return 2;
	return (Types.BIG + 7000000000) as int
		+ Types.U as int + Types.F as int + Types.WIDE as int
		+ Types.B;
}
