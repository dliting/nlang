enum Color { Red, Green, Blue }

int pick(Color c) {
    int r = 0;
    switch (c) {
        case Color.Red, Color.Blue: r = r + 10;
        case Color.Green: r = r + 20;
    }
    return r;
}

int main() {
    //Multi-value case with enum labels: first and last member both match.
    //Bodies accumulate so the implicit clause exit stays observable here
    //(a return-body would mask a fallthrough regression).
    if (pick(Color.Red) != 10) return 1;
    if (pick(Color.Blue) != 10) return 2;
    if (pick(Color.Green) != 20) return 3;
    return 0;
}
