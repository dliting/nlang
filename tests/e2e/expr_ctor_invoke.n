// 0.9.0: constructor call without `new` (expression position).
class Point {
    public int x;
    public int y;
    public Point(int a, int b) { this.x = a; this.y = b;}
}

int main() {
    Point p = Point(2, 3);
    int s = Point(1, 4).x + p.y;
    int r = 0;
    try { throw Exception("boom"); }
    catch (Exception e) { if (e.message == "boom") { r = 3; } }
    if (s != 4) { return 9; }
    return s + r;
}
