//0.7.3 B pin (Task 2): a function reference stored via SUBSCRIPT into a
//function-typed array element binds against the element type — the
//resolver's func-ref subscript-store block (bare-name and member form).
//Pins the current binding so the token flip (Task 3) keeps it green
//through the token peel arm. No prior e2e covered the subscript form.
int dbl(int x) { return x * 2; }
int inc(int x) { return x + 1; }

class C {
    int k;
    public int add(int x) { return x + k; }
}

int main() {
    Func<int, int>[] arr = new Func<int, int>[2];
    arr[0] = dbl;
    arr[1] = inc;
    Func<int, int> f = arr[0];
    int a = f(5);
    C c = new C();
    c.k = 10;
    arr[1] = c.add;
    Func<int, int> g = arr[1];
    int b = g(5);
    //dbl(5)=10, member-bound add(5)=15.
    return a + b;
}
