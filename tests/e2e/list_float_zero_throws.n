int main() {
    //Lock the List<float> null-sentinel bug — symmetric to list_int_zero_throws.
    //A List<float> element holding 0.0 is treated as null when retrieved
    //via OP_Box/OP_Unbox (val==0 shortcut), so .get(idx) throws
    //"unbox on null/invalid reference". The throw → exit 1 path is the
    //expected outcome until P3.1 fix lands.
    //
    //P3.1 fix options (mirrors list_int_zero_throws):
    //  A — always allocate heap slot in OP_Box (drop null-sentinel
    //      optimization; lose ability to distinguish Object o = null
    //      from Object o = 0.0).
    //  B — use a separate null sentinel distinct from any heap idx.
    //  C — type-tag-aware boxing (only skip alloc for AST null literal,
    //      not for runtime float 0.0).
    List<float> nums = new List<float>();
    nums.add(0.0);
    float x = nums.get(0);
    return x;
}
