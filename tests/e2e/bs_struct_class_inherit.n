class Animal {
    public int legs;
}

class Dog : Animal {
    public int teeth;
}

struct Kennel {
    Dog d;
}

int main() {
    ByteStream bs = new ByteStream();
    Dog d = new Dog();
    d.legs = 4;
    d.teeth = 1;
    Kennel k;
    k.d = d;
    bs.writeStruct(k);
    bs.reset();
    Kennel k2 = bs.readStruct("Kennel");
    return k2.d.legs + k2.d.teeth;
}
