// String.toInt(radix): strict whole-string parse in radix 2..36. A
// leading + or - is allowed; "0x" prefixes are rejected even at radix
// 16; overflow, a radix outside 2..36, leading spaces, a lone sign and
// non-ASCII digits all raise Exception.
import io;

int parseThrows(string s, int radix) {
    try {
        s.toInt(radix);
    } catch (Exception e) {
        return 1;
    }
    return 0;
}

int main() {
    if ("ff".toInt(16) != 255) { return 1; }
    if ("101".toInt(2) != 5) { return 2; }
    if ("-z".toInt(36) != -35) { return 3; }
    if ("+10".toInt(10) != 10) { return 4; }
    if ("12".toInt() != 12) { return 5; }
    if (parseThrows("0x1f", 16) != 1) { return 6; }
    if (parseThrows("99999999999", 10) != 1) { return 7; }
    if (parseThrows("12", 1) != 1) { return 8; }
    if (parseThrows(" 12", 10) != 1) { return 9; }
    if (parseThrows("", 10) != 1) { return 10; }
    if (parseThrows("12", 37) != 1) { return 11; }
    //Cross-checks against strconv.ParseInt / Integer.parseInt: a lone
    //sign has no digits; full-width digits are not ASCII (Go rejects
    //them, Java's Character.digit accepts them, we follow Go); letters
    //are case-insensitive up to radix 36; the int32 lower bound parses
    //and one below it overflows.
    if (parseThrows("+", 10) != 1) { return 12; }
    if (parseThrows("-", 10) != 1) { return 13; }
    if (parseThrows("１２", 10) != 1) { return 14; }
    if ("Z".toInt(36) != 35) { return 15; }
    if ("z".toInt(36) != 35) { return 16; }
    if ("-2147483648".toInt(10) != -2147483648) { return 17; }
    if (parseThrows("-2147483649", 10) != 1) { return 18; }
    io.print("ok");
    return 0;
}
