// Phase 10 audit round-9: statement CONDITION staging must use EvalAreaClaim,
// not tempSlot. Conditions were emitted into tempSlot; a binary condition
// (`1 + use(make(5)) == 6`) parked its LEFT operand in tempSlot across the
// nested RIGHT emission, and a struct-by-value argument's deep-copy scratch
// (EmitBinding CopyStruct, hardcoded tempSlot) silently corrupted it — the
// wrong branch / wrong case / wrong loop bound resulted.
struct Point { int x; int y; }
Point make(int v) { Point p; p.x = v; p.y = v; return p; }
int use(Point p) { return p.x; }

int main() {
    int r = 0;

    // if: binary cond, struct-arg call in the RIGHT operand
    if (1 + use(make(5)) == 6) r += 0; else r += 1;

    // if control (plain arithmetic cond)
    if (1 + 5 == 6) r += 0; else r += 2;

    // while: cond re-evaluated every iteration
    int i = 0;
    while (i < 1 + use(make(5))) { i += 1; }
    if (i != 6) r += 4;

    // while control
    int j = 0;
    while (j < 1 + 5) { j += 1; }
    if (j != 6) r += 8;

    // do-while: cond after body
    int k = 0;
    do { k += 1; } while (k < 1 + use(make(5)));
    if (k != 6) r += 16;

    // for: per-iteration cond
    int cf = 0;
    for (int t = 0; t < 1 + use(make(5)); t = t + 1) { cf += 1; }
    if (cf != 6) r += 32;

    // switch: binary case-cond must match 6 (broken staging falls to default)
    switch (6) {
        case 1 + use(make(5)): break;
        default: r += 64;
    }

    // switch control
    switch (6) {
        case 1 + 5: break;
        default: r += 128;
    }

    // assert: same staging shape as if — if broken, AssertFail throws and
    // the process exits 1 before returning r (so exit 0 implies this passed)
    assert(1 + use(make(5)) == 6);

    return r;
}
