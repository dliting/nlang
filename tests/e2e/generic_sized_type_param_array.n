//v0.12.3 dictionary model: a sized array of a type parameter via the
//C-style trailing declarator is array CREATION — the statement form of
//new T[3], whose element kind is not known until the instantiation
//(the same rejection family as new T[n] in bodies, spec D2). T[] type
//positions stay legal (generic_type_param_array.n).
class Box<T> {
    public int get() {
        T a[3];
        return 1;
    }
}
int main() { return 0; }
