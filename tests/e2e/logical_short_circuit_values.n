//Value semantics: && , || and ! always yield strict bools (never the
//raw operand value), so the results compare directly against the
//true/false literals.
int main() {
    if ((true && true) != true) return 2;
    if ((true || false) != true) return 3;
    if ((false && true) != false) return 4;
    if ((false || true) != true) return 5;
    if ((1 < 2 && 2 < 3) != true) return 6;
    if (!false != true) return 8;
    if (!true != false) return 9;
    return 42;
}
