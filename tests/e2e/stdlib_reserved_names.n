// The reserved-name table is gone (phase 5): user declarations named
// after the builtin packages are ordinary declarations. All three
// shapes in one file — a function, a class and a local named io/fs/math
// compile and run; their table keys carry this file's package
// (stdlib_reserved_names.*), so they never collide with io.print and
// friends. The exit code IS the runtime pin.
int io(int x) { return x; }     // function named after a package
class fs { public int v; }      // class named after a package
int main() {
    int math = 1;               // local named after a package
    math = math + io(1);
    return math;
}
