// ND arrays holding reference elements survive collection.
import thread;
int main() {
    string[,] grid = string[2,3];
    grid[1,1] = "survivor";
    Thread t = thread.spawn(churn);
    int ok = 0;
    for (int r = 0; r < 50; r = r + 1) {
        int[] noise = int[5000];
        noise[0] = r;
        if (grid[1,1] == "survivor") ok = ok + 1;
    }
    thread.join(t);
    if (ok != 50) return 1;
    return 0;
}

void churn() {
    int rounds = 0;
    while (rounds < 800) {
        int[] buf = int[1000];
        buf[0] = rounds;
        rounds = rounds + 1;
    }
}
