// v0.13.9 phase 4: the declaration throat fires for virtual methods
// too; reference formals on virtual methods follow the phase 3 rules.
class A {
    virtual int foo(int x, out int y) {
        y = x;
        return 0;
    }
}

int main() {
    A a = A();
    int y = 0;
    return a.foo(3, out y);
}
