int main() {
    List<int> lst = new List<int>();
    lst.Add(1);
    lst.Add(2);
    lst.Add(3);
    lst.Add(4);
    lst.Add(5);
    lst.Add(6);
    lst.Add(7);
    lst.Add(8);
    lst.Add(9);
    lst.Add(10);
    int captured = 0;
    foreach (int x in lst) {
        if (x == 5) {
            captured = x;
            break;
        }
    }
    return captured;
}
