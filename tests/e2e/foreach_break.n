int main() {
    List<int> lst = new List<int>();
    lst.add(1);
    lst.add(2);
    lst.add(3);
    lst.add(4);
    lst.add(5);
    lst.add(6);
    lst.add(7);
    lst.add(8);
    lst.add(9);
    lst.add(10);
    int captured = 0;
    foreach (int x in lst) {
        if (x == 5) {
            captured = x;
            break;
        }
    }
    return captured;
}
