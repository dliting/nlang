// stdlib_str_starts_ends_contains — the three predicates return bool.
int main() {
    if ("hello".startsWith("he") != true) return 1;
    if ("hello".startsWith("xx") != false) return 2;
    if ("hello".endsWith("lo") != true) return 3;
    if ("hello".endsWith("he") != false) return 4;
    if ("hello".contains("ell") != true) return 5;
    if ("hello".contains("z") != false) return 6;
    if ("".startsWith("") != true) return 7;
    return 0;
}
