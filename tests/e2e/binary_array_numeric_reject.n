//0.7.3 B pin, updated for v0.14.0: same-kind array+numeric arithmetic
//now compiles (it lowers to the tensor package's scalar-broadcast
//arms), but a mixed-kind pair is still rejected - there is no
//cross-kind promotion, the resolver demands a matching primitive.
import tensor;

int main() {
    int[] a = int[2];
    float[] b = a + 1.5f;
    return 0;
}
