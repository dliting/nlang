//Phase 13 Step 1 (review round-1 F4): invoking a delegate whose
//signature carries out parameters needs OP_CallDelegateOut (Step 2) —
//rejected with a named diagnostic instead of an internal codegen error.
void grab(out int r) { r = 7; }

int main() {
    Func<void, out int> f = grab;
    int box = 0;
    f(out box);
    return box;
}
