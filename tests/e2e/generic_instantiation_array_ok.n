//0.13.1c positive pin: an array whose ELEMENT is a generic
//instantiation stays legal — the creation gate rejects only a bare
//type-parameter element (the placeholder), never an instantiation.
class Box<T>
{
    public T m_v;
    public Box(T v) { m_v = v; }
    public T get() { return m_v; }
}
int main()
{
    Box<int> boxes[2];
    boxes[0] = Box<int>(1);
    if (boxes[0].get() != 1)
        return 11;
    return 10;
}
