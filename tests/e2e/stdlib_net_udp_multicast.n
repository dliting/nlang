import io;
import net;

int main() {
    //Bind loopback: joinMulticast takes the socket's bound address as
    //the interface, and the loop copy of the self-sent multicast is
    //delivered back on it (verified equivalent to the wildcard bind —
    //M-4: the wildcard form is the one bind in the suite that trips
    //the Windows firewall prompt on a fresh machine).
    UdpSocket s = UdpSocket.bind("127.0.0.1", 0);
    s.setMulticastTtl(1);
    s.joinMulticast("239.255.255.250");
    s.sendTo(io.toBytes("m"), "239.255.255.250", s.localPort());
    byte[] buf = byte[8];
    string from;
    int port = 0;
    int n = s.recvFrom(buf, out from, out port, 3000);
    s.leaveMulticast("239.255.255.250");
    s.close();
    if (n != 1) { return 1; }
    io.print("ok");
    return 0;
}
