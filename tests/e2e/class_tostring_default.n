class C {
    public int _dummy;
}
int main() {
	//Phase 8e-9b: default Object.toString() format is "ClassName@heapIdxHex".
	//Two distinct heap instances must produce distinct strings (different
	//heap idx → different hex suffix). Avoid depending on the exact idx
	//value (heap idx is sensitive to GC / allocation order).
	C a = new C();
	C b = new C();
	string s1 = a.toString();
	string s2 = b.toString();
	//Both share the "C@" prefix (length >= 2) but differ overall.
	if (s1 != s2 && s1.length() >= 2 && s2.length() >= 2) return 7;
	return 1;
}
