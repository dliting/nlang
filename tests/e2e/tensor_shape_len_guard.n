// Final-review C3+M2: shape lists longer than kMaxArrayRank must be a
// catchable error (not a stack smash), and tensor.full's dims operand
// reads its cells through the view's strides (logical content), rank 1.
import tensor;

int main() {
    int acc = 0;

    // a 65-cell shape overflows the kernel's stack buffer before any
    // length check runs today — the process dies. Catchable after fix.
    int[] shape65 = int[65];
    int i = 0;
    while (i < 65) { shape65[i] = 1; i = i + 1; }
    double[] a = tensor.full(4, 1.0);
    try {
        double[] r = tensor.reshape(a, shape65);
        assert(false);
    } catch (Exception e) { acc = acc + 1; }

    // same overflow through transpose's axes list
    int[] axes80 = int[80];
    i = 0;
    while (i < 80) { axes80[i] = 0; i = i + 1; }
    try {
        int[] t = tensor.transpose(tensor.full(4, 1), axes80);
        assert(false);
    } catch (Exception e) { acc = acc + 2; }

    // rank-2 dims operands are rejected at the compiler's typed-int[]
    // boundary (no runtime probe needed); a strided view rides through.
    // dims as a strided view: logical cells [3, 4] shape the result —
    // the linear cells [9, 3] must not
    int[] base = int[6];
    base[0] = 9; base[1] = 3; base[3] = 4;
    int[] v1 = base[1:5:2];
    int[,] g = tensor.full(v1, 7);
    assert(g.shape()[0] == 3 && g.shape()[1] == 4);

    return acc;
}
