struct Point { int x; int y; }

int main() {
    FileStream fs = new FileStream("_phase8_tmp/struct_roundtrip.bin", "w");
    Point p;
    p.x = 10;
    p.y = 20;
    fs.WriteStruct(p);
    fs.Close();
    FileStream fs2 = new FileStream("_phase8_tmp/struct_roundtrip.bin", "r");
    Point q = fs2.ReadStruct("Point");
    fs2.Close();
    return q.x + q.y;
}
