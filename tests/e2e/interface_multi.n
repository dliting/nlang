interface IPrintable {
    public int print();
}

interface ICountable {
    public int count();
}

class Bag implements IPrintable, ICountable {
    public int items;
    public int print() {
        return 100;
    }
    public int count() {
        return this.items;
    }
}

int DoPrint(IPrintable p) {
    return p.print();
}

int DoCount(ICountable c) {
    return c.count();
}

int main() {
    Bag b = new Bag();
    b.items = 42;
    return DoPrint(b) + DoCount(b);
}
