int main() {
    //0.7.5 literal tiering: scientific notation is double-typed (C/Java
    //style) — the exponent applies at full double precision. An int
    //target needs an explicit `as int`; see int_sci_overflow for the
    //rejection side.
    double a = 2e5;
    if (a != 200000.0) return 1;
    double b = 2E3;
    if (b != 2000.0) return 2;
    double c = 1e0;
    if (c != 1.0) return 3;
    double d = 21e1;
    if (d != 210.0) return 4;
    double e = -2e3;
    if (e != -2000.0) return 5;
    double f = +5e1;
    if (f != 50.0) return 6;
    return 0;
}
