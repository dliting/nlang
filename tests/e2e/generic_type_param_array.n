// v0.12.3 dictionary model: T[] in a type position is a legal HANDLE
// position — the token interns over the type-parameter placeholder and
// the field is one slot whatever the instantiation binds (arrays enter
// from outside, e.g. through a constructor; see generic_arg_domain.n).
// Only array CREATION over T stays rejected (the sized declarator's
// gate, generic_sized_type_param_array.n).
class Box<T> {
    public T[] items;
}
int main() { return 0; }
