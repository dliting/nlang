//Positive guard: a container element read (`li.get(0)` on a
//List<int[]>) coerces to string through the same runtime dispatch.
int main() {
    int[] a = new int[2];
    a[0] = 1;
    a[1] = 2;
    List<int[]> li = new List<int[]>();
    li.add(a);
    string s = li.get(0);
    if (s == "[1, 2]")
        return 7;
    return 1;
}
