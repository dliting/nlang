import io;
import net;

// 0.12.9 net pass I-5: SocketException.errorCode carries the OS
// error number — a stable, locale-independent handle programs can
// branch on (10061 refused, AddrInUse in-use). Pinned with an in-use
// port bind: the named constant SocketException.AddrInUse resolves
// to the current OS's in-use number (WSAEADDRINUSE on Windows,
// EADDRINUSE on POSIX), so the assertion holds on any platform.
int main() {
    TcpListener first = TcpListener.bind("127.0.0.1", 0);
    int port = first.localPort();
    int code = 0;
    try { TcpListener.bind("127.0.0.1", port); return 1; }
    catch (SocketException e) { code = e.errorCode; }
    if (code != SocketException.AddrInUse) { return 2; }

    first.close();
    io.print("ok");
    return 0;
}
