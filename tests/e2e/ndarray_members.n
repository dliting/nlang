// .rank() (compile-time constant), .shape() (int[rank]), .length().
import io;
int main() {
    int[,] a = int[2,3];
    if (a.rank() != 2) return 1;
    int[] s = a.shape();
    if (s.length() != 2) return 2;
    if (s[0] != 2 || s[1] != 3) return 3;
    if (a.length() != 6) return 4;
    double[,,] b = double[2,1,4];
    if (b.rank() != 3) return 5;
    if (b.shape()[2] != 4) return 6;
    if (b.length() != 8) return 7;
    io.print(a.rank());
    return 0;
}
