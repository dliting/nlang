// 0.9.0: alias-named types work in the creation twins (P(args), P[n]).
using P = Point;

class Point {
    public int x;
    public int y;
    public int Point(int a) { x = a; y = a * 2; return 0; }
}

int main() {
    P p = P(5);
    P[] ps = P[2];
    ps[1] = P(7);
    return p.x + p.y + ps[1].x;
}
