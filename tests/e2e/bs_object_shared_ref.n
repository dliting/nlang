class Holder { public int v; }
class Pair { public Holder a; public Holder b; }

int main() {
    ByteStream bs = new ByteStream();
    Holder h = new Holder();
    h.v = 99;
    Pair p = new Pair();
    p.a = h;
    p.b = h;
    bs.writeObject(p);
    bs.reset();
    Pair p2 = bs.readObject("Pair");
    if (p2.a == p2.b) {
        return 1;
    }
    return 0;
}
