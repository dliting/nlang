import io;
import net;

// 0.12.9 net pass I-2: a datagram longer than the receive buffer is
// truncated to the buffer length — the prefix arrives, the excess is
// discarded, the sender address is reported (the manual's UDP page;
// POSIX/C#/Java behavior). Pre-fix a too-small buffer raised
// SocketException and destroyed the datagram.
int main() {
    UdpSocket rx = UdpSocket.bind("127.0.0.1", 0);
    int port = rx.localPort();
    UdpSocket tx = UdpSocket.bind("127.0.0.1", 0);

    string text = "";
    for (int i = 0; i < 100; i = i + 1) { text = text + "ab"; }  //200 bytes
    tx.sendTo(io.toBytes(text), "127.0.0.1", port);

    byte[] buf = byte[64];   //half the datagram
    string from;
    int fromPort = 0;
    int n = rx.recvFrom(buf, out from, out fromPort, 5000);
    if (n != 64) { return 1; }                    //truncated, not an error
    byte[] head = byte[64];
    for (int i = 0; i < 64; i = i + 1) { head[i] = buf[i]; }
    if (io.fromBytes(head) != text.substring(0, 64)) { return 2; }
    if (from != "127.0.0.1" || fromPort != tx.localPort()) { return 3; }

    rx.close();
    tx.close();
    io.print("ok");
    return 0;
}
