//0.9.11 D4/D9: a class with field initializers and no user constructor
//gets a synthesized public zero-arg constructor that applies every
//default in declaration order.
class Cfg {
	public int x = 5;
	public string s = "hi";
	public bool b = true;
	public float f = -1.5;
}

int main() {
	Cfg c = Cfg();
	int r = c.x;
	if (c.s == "hi") r = r + 10;
	if (c.b) r = r + 20;
	if (c.f == -1.5) r = r + 40;
	return r;
}
