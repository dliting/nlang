import io;
import boxchan;

int main()
{
    //Self-check before printing so a wrong value exits 9 with empty
    //stdout and the ctest regex cannot match (the match overrides the
    //exit code).
    Boxchan b = Boxchan();
    int r = b.poke();
    if (r != 7) { return 9; }
    io.print(r);
    return 0;
}
