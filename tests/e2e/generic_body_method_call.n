// v0.12.3 Task 1 window: a bodied member's clone on an instantiation
// is a signature surface only (no body, not native) — a call bound to
// it would reach the backend unregistered. Until instance execution
// lands, the member is not on the instantiation's call surface.
class Box<T> {
    public int get() { return 1; }
}
int main() {
    Box<int> b = Box();
    int x = b.get();
    return x;
}
