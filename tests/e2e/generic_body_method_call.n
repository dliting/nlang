// v0.12.3 dictionary model: a bodied member call on an instantiation
// rides the template row's compiled record — the clone is the
// signature surface type-checking reads, and the slot throat resolves
// the call to the template member. Exit = get() = 1.
class Box<T> {
    public int get() { return 1; }
}
int main() {
    Box<int> b = Box();
    int x = b.get();
    return x;
}
