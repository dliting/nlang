//0.7.3 T13 review pin: a formal nested past kMaxTypeDescDepth must not
//brick the module. The writer degrades the over-cap container to the
//NonSerialized placeholder (mirroring the loader's cap), so what ncc
//writes always loads — pre-guard this exact program compiled, but its
//own .nmod then failed with "type descriptor too deep". Same-module
//call uses the true types, so the run result pins both directions.
int deep(List<List<List<List<List<List<List<List<List<List<int>>>>>>>>>> a) {
    return 4;
}
int main() {
    List<List<List<List<List<List<List<List<List<List<int>>>>>>>>>> x = null;
    int r = 0;
    if (deep(x) == 4) r = 6;
    return r;
}
