import io;
import net;

// External review M12: a zero-length read must not masquerade as EOF
// — 0 is reserved for the end-of-stream signal, so an empty buffer is
// an argument error, and the pending byte survives the rejected call.

int main() {
    TcpListener srv = TcpListener.bind("127.0.0.1", 0);
    int port = srv.localPort();
    TcpStream cli = TcpStream.connect("127.0.0.1", port, 5000);
    TcpStream acc = srv.accept(5000);
    srv.close();

    cli.write("A");

    int bad = 0;
    byte[] empty = io.toBytes("");
    try {
        int n = acc.read(empty, 1000);
        if (n == 0) { bad = bad + 1; }   //the false EOF the fix removes
    } catch (SocketException e) { }

    //The rejected read consumed nothing: the byte is still pending.
    byte[] one = byte[1];
    int n2 = acc.read(one, 5000);
    if (n2 != 1 || io.fromBytes(one) != "A") { bad = bad + 2; }

    cli.close();
    acc.close();
    if (bad != 0) { return bad; }
    io.print("ok");
    return 0;
}
