// 0.13.1a: a T-argument construction inside a static member body
// composes its composition against the frame descriptor cell — the
// caller-forward channel fills it, so the construction resolves to the
// caller's instantiation (Box<int> here). The former instance-context
// rejection is gone; an unfilled cell degrades to the named runtime
// error at the call site.
class Box<T> {
    public T value;
}
class Hold<T> {
    public static Box<T> make() {
        Box<T> b = Box();
        return b;
    }
    public Box<T> viaInstance() { return make(); }
}
int main() {
    Hold<int> h = Hold();
    if (h.viaInstance() == null) { return 3; }
    return 0;
}
