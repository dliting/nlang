//foreach over an array VALUE via container subscript sugar: `l[0]` on a
//List<int[]> degrades to the element type like get() does — rejected at
//resolve time; assign to a local first.
int main() {
	List<int[]> l = new List<int[]>();
	int[] a = new int[2];
	a[0] = 10;
	a[1] = 20;
	l.add(a);
	int total = 0;
	foreach (int x in l[0]) {
		total = total + x;
	}
	return total;
}
