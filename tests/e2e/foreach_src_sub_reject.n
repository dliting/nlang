//foreach over an array VALUE via container subscript sugar: `l[0]` on a
//List<int[]> resolves to the array token like get() does. 0.7.3 B D10:
//accepted and routed through the array path (was rejected at resolve
//time).
int main() {
	List<int[]> l = new List<int[]>();
	int[] a = new int[2];
	a[0] = 10;
	a[1] = 20;
	l.add(a);
	int total = 0;
	foreach (int x in l[0]) {
		total = total + x;
	}
	return total;
}
