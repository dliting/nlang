class Point { public int x; public int y; public Point(int ax, int ay) { this.x = ax; this.y = ay; } }
int main() {
    Dict<Point, int> d = {};
    d.set(Point(1, 0), 100);
    d.set(Point(2, 0), 200);
    int count = 0;
    foreach (Point k in d) {
        count = count + 1;
    }
    return count;
}
