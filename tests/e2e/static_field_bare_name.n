//Bare-name access inside class methods; qualified access outside (D3).
class Ledger {
    public static int total;
    public static int add(int v) {
        total = total + v;
        return total;
    }
}
int main() {
    Ledger.add(40);
    Ledger.total = Ledger.total + 2;
    return Ledger.total;   //42
}
