//0.9.10 D2.4: a same-name zero-arg static must not satisfy the class
//init list's no-arg constructor requirement. Before the fix the check
//accepted the static, codegen selected the real A(int) ctor and the VM
//read an uninitialized formal.
class A {
	public int x;
	public static int A() { return 5; }
	public A(int v) { this.x = v;}
}
int main() {
	A a = A{x:7};
	return a.x;
}
