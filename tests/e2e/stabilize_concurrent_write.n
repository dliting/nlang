//v0.13.9 phase (2) cross-carrier coordination contract: one carrier
//writes a shared object's struct field in place ((x,y) pairs with the
//x==y invariant, alternating sources), two other carriers take
//snapshots — one in assignment form, one in declaration-initializer
//form — and both check the invariant inline and through a by-value
//parameter pass. Whole-record struct access is cell-granularity in the
//VM (no record-level lock; uncoordinated concurrent access is the
//user's data race), so the carriers coordinate with a Mutex — the
//documented duty (spec §10.1/§10.2). Under that coordination no
//snapshot is ever torn: any torn observation exits nonzero. The
//deterministic exit rides the torn counters plus the join
//happens-before edges only (no timing asserts); the commit batch runs
//this file 100x in a shell loop.
import thread;
import concurrent;

struct P {
    int x;
    int y;
}
class Shared {
    public P rec;
    public P a;
    public P b;
    public Mutex gate;
    public int torn = 0;
    public int tornDecl = 0;
    public void write() {
        for (int i = 0; i < 20000; i = i + 1) {
            this.gate.lock();
            if (i % 2 == 0) {
                this.rec = this.a;
            } else {
                this.rec = this.b;
            }
            this.gate.unlock();
        }
    }
    public void read() {
        for (int i = 0; i < 20000; i = i + 1) {
            this.gate.lock();
            P snap;
            snap = this.rec;
            this.gate.unlock();
            if (snap.x != snap.y) {
                this.torn = this.torn + 1;
            }
            if (check(snap) != 1) {
                this.torn = this.torn + 1;
            }
        }
    }
    public void readDecl() {
        for (int i = 0; i < 20000; i = i + 1) {
            this.gate.lock();
            P snap = this.rec;
            this.gate.unlock();
            if (snap.x != snap.y) {
                this.tornDecl = this.tornDecl + 1;
            }
            if (check(snap) != 1) {
                this.tornDecl = this.tornDecl + 1;
            }
        }
    }
}
int check(P s) {
    if (s.x == s.y) { return 1; }
    return 0;
}
int main() {
    Shared sh = Shared();
    sh.gate = Mutex();
    P a;
    a.x = 1;
    a.y = 1;
    sh.a = a;
    P b;
    b.x = 2;
    b.y = 2;
    sh.b = b;
    Thread w = thread.spawn(sh.write);
    Thread r = thread.spawn(sh.read);
    Thread rd = thread.spawn(sh.readDecl);
    thread.join(w);
    thread.join(r);
    thread.join(rd);
    if (sh.torn == 0 && sh.tornDecl == 0) {
        return 42;
    }
    return 1;
}
