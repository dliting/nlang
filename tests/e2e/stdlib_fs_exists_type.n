// stdlib_fs_exists_type — exists/isFile/isDirectory distinguish file,
// directory and missing paths; makeDirs creates parents (mkdir -p).
import io;
import fs;
int main() {
    fs.makeDirs("../temp/fs/fs_exists");
    if (fs.exists("../temp/fs/fs_exists/missing.txt")) return 1;
    io.writeFile("../temp/fs/fs_exists/file.txt", "abc");
    if (!fs.exists("../temp/fs/fs_exists/file.txt")) return 2;
    if (!fs.isFile("../temp/fs/fs_exists/file.txt")) return 3;
    if (fs.isDirectory("../temp/fs/fs_exists/file.txt")) return 4;
    fs.makeDirs("../temp/fs/fs_exists/sub");
    if (!fs.exists("../temp/fs/fs_exists/sub")) return 5;
    if (!fs.isDirectory("../temp/fs/fs_exists/sub")) return 6;
    if (fs.isFile("../temp/fs/fs_exists/sub")) return 7;
    return 0;
}
