//Phase 13 Step 2: cross-module negative — apply's Func formal cannot
//cross the .nmod type-descriptor grammar, so the compiler cannot
//verify the signature; the argument must be rejected by name instead
//of being silently misused as a heap index at runtime.
import lib;

int dbl(int x) { return x * 2; }

int main() {
    return lib.apply(dbl);
}
