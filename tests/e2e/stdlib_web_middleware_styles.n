// stdlib_web_middleware_styles — the middleware contract of the web package:
// one onion chain that mixes a free-function middleware with a web.Middleware
// subclass (D-3), the base-class default that advances instead of answering
// (D-3), answering without next() so the return trip never happens (D-4), a
// second next() call mapping to a 500 whose body is the fixed message (D-4), an
// http.HttpException keeping its own status and message through a rebuilt
// response versus any other exception getting 500 + "internal error" with
// onError firing only there (D-11), a fresh attribute store per request (D-6),
// the attribute accessor face, every response helper, and the Set-Cookie wire
// form with the cookie() lookup (D-12). Every leg runs its own server on an
// ephemeral port and ends by draining and closing it (D-22).
import io;
import url;
import http;
import json;
import web;

// What the middlewares observed. A middleware is a free function or a stateless
// subclass, so cross-request facts a leg asserts on live in static fields; every
// leg clears them first, so no leg reads another leg's residue.
class Trace {
    public static string log;            // the onion marks, in the order they ran
    public static int downstream;        // how many entries below the first one ran
    public static int onErrorCalls;      // times the onError hook was invoked
    public static string errorMsg;       // the message of the exception it was given

    public static void clear() {
        Trace.log = "";
        Trace.downstream = 0;
        Trace.onErrorCalls = 0;
        Trace.errorMsg = "";
    }
}

// Free-function style: marks the request leg, advances, marks the return leg in
// lowercase, which is what makes the chain order observable in one string.
void markA(RequestContext ctx) {
    Trace.log = Trace.log + "A";
    ctx.next();
    Trace.log = Trace.log + "a";
}

void markC(RequestContext ctx) {
    Trace.log = Trace.log + "C";
    ctx.next();
    Trace.log = Trace.log + "c";
}

// Subclass style, same marks; the marks differ from the free functions' so the
// leg can tell which style wrote what.
class Timing : web.Middleware {
    public void process(RequestContext ctx) {
        Trace.log = Trace.log + "B";
        ctx.next();
        Trace.log = Trace.log + "b";
    }
}

// Answers with the terminal body and marks that it did, so a leg can tell "the
// chain ran to the end" from "some middleware answered on the way down".
class Terminal : web.Middleware {
    public void process(RequestContext ctx) {
        Trace.log = Trace.log + "N";
        ctx.text(200, "N");
    }
}

// Writes no process override at all: the base-class default alone decides what
// happens to it, which is exactly what leg B pins.
class NoOverride : web.Middleware { }

// Answers on the way down and returns without advancing: no entry below it runs,
// and no entry sees a return trip.
void guard(RequestContext ctx) {
    ctx.text(401, "missing key");
}

// Counts itself and marks the return trip with a header, so leg C's "no X-Post"
// is an observation about the return trip rather than about the header table.
void postMark(RequestContext ctx) {
    Trace.downstream = Trace.downstream + 1;
    ctx.next();
    ctx.res.headers.set("X-Post", "1");
}

// Advances twice: the second advance breaks the one-advance-per-entry rule (D-4).
void twiceForward(RequestContext ctx) {
    ctx.next();
    ctx.next();
}

void countedDownstream(RequestContext ctx) {
    Trace.downstream = Trace.downstream + 1;
    ctx.text(200, "done");
}

// Writes a header before advancing: a response rebuilt by the error mapping must
// not carry it, which pins "rebuilt" rather than "patched" (D-11).
void halfMark(RequestContext ctx) {
    ctx.res.headers.set("X-Half", "1");
    ctx.next();
}

void throwTooLarge(RequestContext ctx) {
    Trace.downstream = Trace.downstream + 1;
    throw http.HttpException("too large here", 413);
}

void throwTeapot(RequestContext ctx) {
    throw http.HttpException("teapot", 418);
}

// HttpException's own default status is 0, meaning "not an HTTP status error"; a
// middleware that throws without picking one must not put 0 on the status line.
void throwStatusless(RequestContext ctx) {
    throw http.HttpException("statusless");
}

void throwSecret(RequestContext ctx) {
    throw Exception("boom-secret-detail");
}

// The onError hook: counts itself onto the wire and echoes the message it was
// handed, so a leg can see both that it ran and what it saw.
void countErrors(RequestContext ctx, Exception e) {
    Trace.onErrorCalls = Trace.onErrorCalls + 1;
    Trace.errorMsg = e.message;
    ctx.res.headers.set("X-OnError", Trace.onErrorCalls.toString());
    ctx.res.headers.set("X-Exc-Msg", e.message);
}

// Per-request attribute store probe: each request starts from an empty store, so
// the counter written into X-Hits is 1 for every request, never a running total.
void countHits(RequestContext ctx) {
    int hits = ctx.getInt("hits", 0) + 1;
    ctx.set("hits", hits);
    ctx.res.headers.set("X-Hits", hits.toString());
    ctx.next();
}

// The whole accessor face in one pass. Each check that fails adds its own bit, so
// X-Probe reads "0" exactly when every check holds and otherwise names the set
// that broke.
void probeAccessors(RequestContext ctx) {
    int code = 0;
    if (ctx.has("miss")) { code = code + 1; }
    if (ctx.get("miss") != null) { code = code + 2; }
    if (ctx.getString("miss") != "") { code = code + 4; }
    if (ctx.getInt("miss") != 0 || ctx.getInt("miss", 7) != 7) { code = code + 8; }
    ctx.set("k", 7);
    if (ctx.getString("k") != "7") { code = code + 16; }
    if (ctx.getInt("k") != 7) { code = code + 32; }
    ctx.set("n", "7abc");
    if (ctx.getInt("n", -1) != -1) { code = code + 64; }
    ctx.set("b", "TRUE");
    if (!ctx.getBool("b", false)) { code = code + 128; }
    ctx.set("b", "maybe");
    if (!ctx.getBool("b", true) || ctx.getBool("b", false)) { code = code + 256; }
    ctx.set("d", "1");
    if (!ctx.getBool("d", false)) { code = code + 512; }
    ctx.set("d", "0");
    if (ctx.getBool("d", true)) { code = code + 1024; }
    ctx.remove("k");
    if (ctx.has("k") || ctx.getString("k") != "" || ctx.getInt("k", -3) != -3) { code = code + 2048; }
    ctx.res.headers.set("X-Probe", code.toString());
    ctx.next();
}

// One response helper per path, so each response is observed on its own.
void pickHelper(RequestContext ctx) {
    if (ctx.path == "/text") {
        ctx.text(200, "hi");
    } else if (ctx.path == "/html") {
        ctx.html(200, "<p>");
    } else if (ctx.path == "/json") {
        json.JsonObject doc = json.JsonObject();
        doc.put("k", "v");
        ctx.json(201, doc);
    } else if (ctx.path == "/bytes") {
        ctx.bytes(200, io.toBytes("x"), "image/png");
    } else if (ctx.path == "/r302") {
        ctx.redirect("/x");
    } else if (ctx.path == "/r301") {
        ctx.redirect("/x", 301);
    } else if (ctx.path == "/nocontent") {
        ctx.noContent();
    }
}

// Writes three cookies, each exercising a different part of the attribute set,
// and reads the request's Cookie header back on the other path.
void cookieHandler(RequestContext ctx) {
    if (ctx.path == "/write") {
        ctx.setCookie("a", "1");
        ctx.setCookie("b", "2", "/app", 60, true, true, "Strict");
        ctx.setCookie("c", "3", "/", -1, false, false, "None");
        ctx.text(200, "w");
        return;
    }
    ctx.res.headers.set("X-C1", ctx.cookie("a"));
    ctx.res.headers.set("X-C2", ctx.cookie("nope"));
    ctx.res.headers.set("X-C3", ctx.cookie("b"));
    ctx.res.headers.set("X-C4", ctx.cookie("junk"));
    ctx.text(200, "r");
}

// The shared free-function client follows redirects, so the 302/301 pins need the
// redirect response itself: maxRedirects = 0 hands it back untranslated.
HttpResponse getNoRedirect(http.HttpClient cli, string urlText) {
    http.HttpRequest req = http.HttpRequest();
    req.url = Url.parse(urlText);
    return cli.request(req);
}

// A request that carries its own Cookie header, which the free functions cannot
// ask for.
HttpResponse getWithCookie(string urlText, string cookieHeader) {
    http.HttpRequest req = http.HttpRequest();
    req.url = Url.parse(urlText);
    req.headers.set("Cookie", cookieHeader);
    return http.request(req);
}

// Teardown for every leg: drain the server, which has nothing of ours in flight
// (a parked keep-alive connection is force-closed, not counted), then close it.
int closeServer(web.App app) {
    if (app.drain(5000) != 0) {
        io.print("the server drained with a residual connection");
        return 1;
    }
    app.close();
    return 0;
}

int main() {
    int bad = 0;
    if (legOnionOrder() != 0) { bad = bad + 1; }
    if (legBaseDefaultAdvances() != 0) { bad = bad + 1; }
    if (legShortCircuit() != 0) { bad = bad + 1; }
    if (legDoubleNext() != 0) { bad = bad + 1; }
    if (legHttpExceptionPassesThrough() != 0) { bad = bad + 1; }
    if (legUnlistedStatus() != 0) { bad = bad + 1; }
    if (legOtherException() != 0) { bad = bad + 1; }
    if (legPerRequestState() != 0) { bad = bad + 1; }
    if (legAccessors() != 0) { bad = bad + 1; }
    if (legResponseHelpers() != 0) { bad = bad + 1; }
    if (legCookies() != 0) { bad = bad + 1; }
    if (legFacadeForwards() != 0) { bad = bad + 1; }
    if (bad == 0) { io.print("ok"); }
    return bad;
}

// Leg A: three middlewares of both styles around a terminal entry. Every one of
// them sees both legs of the chain, so the marks must read ABC then N then cba.
int legOnionOrder() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(markA);
    app.use(Timing());
    app.use(markC);
    app.use(Terminal());
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (Trace.log != "ABCNcba") {
        io.print("leg A the chain logged " + Trace.log + ", want ABCNcba");
        bad = bad + 1;
    }
    if (res.statusCode != 200 || res.bodyText() != "N") {
        io.print("leg A the terminal answered " + res.statusCode.toString()
            + " body=" + res.bodyText());
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg B: a bare web.Middleware() instance and a subclass with no process override,
// one on each side of Timing(). Neither writes a mark of its own, so the marks
// around them are the visit evidence: B proves the bare instance advanced to
// Timing(), C proves the subclass advanced to markC(), and the unchanged log plus
// the terminal's 200 show the defaults contributed nothing but the advance.
int legBaseDefaultAdvances() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(markA);
    app.use(web.Middleware());
    app.use(Timing());
    app.use(NoOverride());
    app.use(markC);
    app.use(Terminal());
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (Trace.log != "ABCNcba") {
        io.print("leg B the chain logged " + Trace.log + ", want ABCNcba");
        bad = bad + 1;
    }
    if (res.statusCode != 200 || res.bodyText() != "N") {
        io.print("leg B the terminal answered " + res.statusCode.toString()
            + " body=" + res.bodyText());
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg C: the first middleware answers and returns, so nothing below it runs and
// the return trip never happens.
int legShortCircuit() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(guard);
    app.use(postMark);
    app.use(Terminal());
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (res.statusCode != 401 || res.bodyText() != "missing key") {
        io.print("leg C the short circuit answered " + res.statusCode.toString()
            + " body=" + res.bodyText());
        bad = bad + 1;
    }
    if (Trace.downstream != 0) {
        io.print("leg C " + Trace.downstream.toString() + " entries below the guard ran");
        bad = bad + 1;
    }
    if (res.headers.has("X-Post")) {
        io.print("leg C the response carries X-Post, so a return trip happened");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg D: an entry that advances twice. The violation surfaces as a 500 with the
// fixed message, and the entries below it still ran exactly once.
int legDoubleNext() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(twiceForward);
    app.use(countedDownstream);
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (res.statusCode != 500) {
        io.print("leg D the double next() answered " + res.statusCode.toString());
        bad = bad + 1;
    }
    if (res.bodyText() != "web: next() called more than once") {
        io.print("leg D the body was " + res.bodyText());
        bad = bad + 1;
    }
    if (Trace.downstream != 1) {
        io.print("leg D the downstream entry ran " + Trace.downstream.toString() + " times, want 1");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg E: an http.HttpException from deep in the chain keeps its own status,
// reason phrase and message; the half-written headers of the trip down are gone,
// because the response is rebuilt. onError stays out of this path.
int legHttpExceptionPassesThrough() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.onError(countErrors);
    app.use(halfMark);
    app.use(throwTooLarge);
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (res.statusCode != 413 || res.reasonPhrase != "Content Too Large"
            || res.bodyText() != "too large here") {
        io.print("leg E the exception answered " + res.statusCode.toString() + " "
            + res.reasonPhrase + " body=" + res.bodyText());
        bad = bad + 1;
    }
    if (res.headers.get("Content-Type") != "text/plain; charset=utf-8") {
        io.print("leg E the content type was " + res.headers.get("Content-Type"));
        bad = bad + 1;
    }
    if (res.headers.has("X-Half")) {
        io.print("leg E the rebuilt response kept the header written on the way in");
        bad = bad + 1;
    }
    if (Trace.onErrorCalls != 0 || res.headers.has("X-OnError")) {
        io.print("leg E onError ran on the HttpException path");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg F: a status with no entry in the reason table still carries the exception's
// own message; the phrase falls back to "Error", which is the table's boundary.
// The second half pins the other edge of the same mapping: an exception that
// picked no status at all is clamped to 500 instead of asking for status 0.
int legUnlistedStatus() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.onError(countErrors);
    app.use(throwTeapot);
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (res.statusCode != 418 || res.reasonPhrase != "Error" || res.bodyText() != "teapot") {
        io.print("leg F the exception answered " + res.statusCode.toString() + " "
            + res.reasonPhrase + " body=" + res.bodyText());
        bad = bad + 1;
    }
    if (Trace.onErrorCalls != 0) {
        io.print("leg F onError ran on the HttpException path");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);

    // The clamp: an exception that picked no status is answered with 500 and the
    // registered phrase for it, while its own message stays the body — the same
    // shape serveOne gives a handler exception (D-11).
    web.App untyped = web.App();
    untyped.use(throwStatusless);
    untyped.listen("127.0.0.1", 0);
    string zeroBase = "http://127.0.0.1:" + untyped.server().localPort().toString();
    http.HttpResponse zeroRes = http.get(zeroBase + "/");
    if (zeroRes.statusCode != 500 || zeroRes.reasonPhrase != "Internal Server Error"
            || zeroRes.bodyText() != "statusless") {
        io.print("leg F the statusless exception answered " + zeroRes.statusCode.toString()
            + " " + zeroRes.reasonPhrase + " body=" + zeroRes.bodyText());
        bad = bad + 1;
    }
    bad = bad + closeServer(untyped);
    return bad;
}

// Leg G: any other exception maps to a fixed 500 that leaks nothing of its
// message, and onError is the only hook that sees it — after the rebuild, so its
// own headers land on the wire.
int legOtherException() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.onError(countErrors);
    app.use(throwSecret);
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/");
    if (res.statusCode != 500 || res.reasonPhrase != "Internal Server Error") {
        io.print("leg G the exception answered " + res.statusCode.toString() + " " + res.reasonPhrase);
        bad = bad + 1;
    }
    if (res.bodyText() != "internal error" || res.bodyText().indexOf("boom") >= 0) {
        io.print("leg G the body was " + res.bodyText());
        bad = bad + 1;
    }
    if (Trace.onErrorCalls != 1) {
        io.print("leg G onError ran " + Trace.onErrorCalls.toString() + " times, want 1");
        bad = bad + 1;
    }
    if (res.headers.get("X-OnError") != "1") {
        io.print("leg G the wire says X-OnError=" + res.headers.get("X-OnError") + ", want 1");
        bad = bad + 1;
    }
    if (res.headers.get("X-Exc-Msg") != "boom-secret-detail") {
        io.print("leg G onError saw " + res.headers.get("X-Exc-Msg") + ", want boom-secret-detail");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg H: two requests to one server. The attribute store belongs to the request,
// so each one counts its own handler visit as the first.
int legPerRequestState() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(countHits);
    app.use(Terminal());
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse first = http.get(base + "/");
    http.HttpResponse second = http.get(base + "/");
    if (first.headers.get("X-Hits") != "1") {
        io.print("leg H the first request counted " + first.headers.get("X-Hits") + ", want 1");
        bad = bad + 1;
    }
    if (second.headers.get("X-Hits") != "1") {
        io.print("leg H the second request counted " + second.headers.get("X-Hits") + ", want 1");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg I: the attribute accessors, each absent key answering with its documented
// empty value instead of raising, each stored value read back in every kind.
int legAccessors() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(probeAccessors);
    app.use(Terminal());
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpResponse res = http.get(base + "/probe");
    if (res.headers.get("X-Probe") != "0") {
        io.print("leg I the accessor probe failed checks summing to " + res.headers.get("X-Probe"));
        bad = bad + 1;
    }
    if (res.statusCode != 200) {
        io.print("leg I the probe request answered " + res.statusCode.toString());
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg J: every response helper, one request each. The redirects need a client of
// their own with the follow limit at zero, so the 3xx itself is what gets read.
int legResponseHelpers() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(pickHelper);
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();
    http.HttpClient cli = http.HttpClient();
    cli.maxRedirects = 0;

    http.HttpResponse textRes = getNoRedirect(cli, base + "/text");
    if (textRes.statusCode != 200 || textRes.reasonPhrase != "OK"
            || textRes.headers.get("Content-Type") != "text/plain; charset=utf-8"
            || textRes.bodyText() != "hi") {
        io.print("leg J text answered " + textRes.statusCode.toString() + " " + textRes.reasonPhrase
            + " ct=" + textRes.headers.get("Content-Type") + " body=" + textRes.bodyText());
        bad = bad + 1;
    }

    http.HttpResponse htmlRes = getNoRedirect(cli, base + "/html");
    if (htmlRes.statusCode != 200 || htmlRes.headers.get("Content-Type") != "text/html; charset=utf-8"
            || htmlRes.bodyText() != "<p>") {
        io.print("leg J html answered " + htmlRes.statusCode.toString()
            + " ct=" + htmlRes.headers.get("Content-Type") + " body=" + htmlRes.bodyText());
        bad = bad + 1;
    }

    http.HttpResponse jsonRes = getNoRedirect(cli, base + "/json");
    if (jsonRes.statusCode != 201 || jsonRes.reasonPhrase != "Created"
            || jsonRes.headers.get("Content-Type") != "application/json"
            || jsonRes.bodyText() != "{\"k\":\"v\"}") {
        io.print("leg J json answered " + jsonRes.statusCode.toString() + " " + jsonRes.reasonPhrase
            + " ct=" + jsonRes.headers.get("Content-Type") + " body=" + jsonRes.bodyText());
        bad = bad + 1;
    }

    http.HttpResponse bytesRes = getNoRedirect(cli, base + "/bytes");
    if (bytesRes.statusCode != 200 || bytesRes.headers.get("Content-Type") != "image/png"
            || bytesRes.body == null || bytesRes.body.length() != 1
            || bytesRes.bodyText() != "x") {
        int byteLen = -1;
        if (bytesRes.body != null) { byteLen = bytesRes.body.length(); }
        io.print("leg J bytes answered " + bytesRes.statusCode.toString()
            + " ct=" + bytesRes.headers.get("Content-Type") + " len=" + byteLen.toString());
        bad = bad + 1;
    }

    http.HttpResponse foundRes = getNoRedirect(cli, base + "/r302");
    if (foundRes.statusCode != 302 || foundRes.reasonPhrase != "Found"
            || foundRes.headers.get("Location") != "/x") {
        io.print("leg J redirect answered " + foundRes.statusCode.toString() + " "
            + foundRes.reasonPhrase + " location=" + foundRes.headers.get("Location"));
        bad = bad + 1;
    }

    http.HttpResponse movedRes = getNoRedirect(cli, base + "/r301");
    if (movedRes.statusCode != 301 || movedRes.reasonPhrase != "Moved Permanently"
            || movedRes.headers.get("Location") != "/x") {
        io.print("leg J redirect(301) answered " + movedRes.statusCode.toString() + " "
            + movedRes.reasonPhrase + " location=" + movedRes.headers.get("Location"));
        bad = bad + 1;
    }

    http.HttpResponse emptyRes = getNoRedirect(cli, base + "/nocontent");
    if (emptyRes.statusCode != 204 || emptyRes.reasonPhrase != "No Content"
            || (emptyRes.body != null && emptyRes.body.length() != 0)) {
        int emptyLen = -1;
        if (emptyRes.body != null) { emptyLen = emptyRes.body.length(); }
        io.print("leg J noContent answered " + emptyRes.statusCode.toString() + " "
            + emptyRes.reasonPhrase + " len=" + emptyLen.toString());
        bad = bad + 1;
    }

    cli.close();
    bad = bad + closeServer(app);
    return bad;
}

// Leg K: the Set-Cookie lines the three calls build, each attribute in its
// documented position and the optional ones absent when they are not asked for;
// then the cookie() face, where the first pair of a name wins and a malformed
// segment is skipped rather than raised.
int legCookies() {
    Trace.clear();
    int bad = 0;
    web.App app = web.App();
    app.use(cookieHandler);
    app.listen("127.0.0.1", 0);
    string base = "http://127.0.0.1:" + app.server().localPort().toString();

    http.HttpResponse written = http.get(base + "/write");
    List<string> lines = written.headers.getAll("Set-Cookie");
    if (lines.length() != 3) {
        io.print("leg K the response carries " + lines.length().toString()
            + " Set-Cookie lines, want 3");
        bad = bad + 1;
    } else {
        if (lines[0] != "a=1; Path=/; HttpOnly; SameSite=Lax") {
            io.print("leg K the default cookie is " + lines[0]);
            bad = bad + 1;
        }
        if (lines[1] != "b=2; Path=/app; Max-Age=60; HttpOnly; Secure; SameSite=Strict") {
            io.print("leg K the full cookie is " + lines[1]);
            bad = bad + 1;
        }
        if (lines[2] != "c=3; Path=/; Max-Age=0; SameSite=None") {
            io.print("leg K the expired cookie is " + lines[2]);
            bad = bad + 1;
        }
    }

    http.HttpResponse read = getWithCookie(base + "/read", "a=1; a=2; junk; b=x");
    if (read.headers.get("X-C1") != "1") {
        io.print("leg K cookie(a) read " + read.headers.get("X-C1") + ", want the first value 1");
        bad = bad + 1;
    }
    if (read.headers.get("X-C2") != "") {
        io.print("leg K cookie(nope) read " + read.headers.get("X-C2") + ", want empty");
        bad = bad + 1;
    }
    if (read.headers.get("X-C3") != "x") {
        io.print("leg K cookie(b) read " + read.headers.get("X-C3") + ", want x");
        bad = bad + 1;
    }
    if (read.headers.get("X-C4") != "") {
        io.print("leg K cookie(junk) read " + read.headers.get("X-C4")
            + ", want empty for a segment with no =");
        bad = bad + 1;
    }
    bad = bad + closeServer(app);
    return bad;
}

// Leg L: the facade forwards the shutdown entry points to the http layer's state
// machine, which is the side that knows when nothing is left.
int legFacadeForwards() {
    int bad = 0;
    web.App app = web.App();
    app.use(Terminal());
    app.listen("127.0.0.1", 0);
    if (app.drain(5000) != 0) {
        io.print("leg L the idle facade drained a residual");
        bad = bad + 1;
    }
    app.close();
    if (app.server().isServing()) {
        io.print("leg L the facade server is still serving after close()");
        bad = bad + 1;
    }
    return bad;
}
