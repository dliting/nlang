//0.7.3 B review fix pin: an exact-type array argument through a delegate
//call stays accepted — the interned token is pointer-identical to the
//Func formal's type argument (distance 0, no conversion needed).
int sum(int[] a) {
    int t = 0;
    for (int i = 0; i < a.length; i = i + 1) { t = t + a[i]; }
    return t;
}

int main() {
    Func<int, int[]> d = sum;
    int[] a = new int[3];
    a[0] = 2;
    a[1] = 3;
    a[2] = 4;
    return d(a);
}
