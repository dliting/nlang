//0.13.10 lambda review: a void-returning closure rides a generic
//container. The func return slot's descriptor leaf must round-trip —
//the producer used to degrade the void node to "?" and the container
//creation detonated at descriptor intern time with "unresolved link
//key". Both halves pinned: void store/invoke, and the neighboring
//int-returning block body as the control shape.
int main() {
    List<func<void>> mut = List<func<void>>();
    mut.add(() -> { });
    mut.add(() -> { });
    func<void> first = mut.get(0);
    first();
    List<func<int>> rd = List<func<int>>();
    rd.add(() -> { return 7; });
    func<int> r = rd.get(0);
    if (r() != 7) {
        return 1;
    }
    return 0;
}
