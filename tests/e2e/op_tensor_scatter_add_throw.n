// Out-of-range scatterAdd index: uncaught Exception, exit 1 by design
// (the scatter family's discipline — the index and the range are
// named; NOT the silent wrap cupy chose). Both legs raise the same
// way: the device kernel flags the cell and the dispatcher raises
// from it, the CPU walk raises inline.
import tensor;

int main() {
    int[] acc = tensor.full(3, 1);
    int[] idx = int[2];
    idx[0] = 0;
    idx[1] = 9;
    int[] vals = int[2];
    vals[0] = 2; vals[1] = 3;
    int[] boom = tensor.scatterAdd(acc, 0, idx, vals);
    return 0;
}
