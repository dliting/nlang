// tensor reshape family: reshape1..8 reinterpret any source rank as the
// target shape in row-major order; the element count is validated at
// runtime (product(shape) must equal the source element count).
// flatten is the any-rank -> rank-1 shortcut.
import io;
import tensor;

int[] makeFlat() {
    int[] f = int[6];
    for (int i = 0; i < 6; i += 1) {
        f[i] = i + 1;
    }
    return f;
}

int main() {
    // flat 6 -> [2,3]
    int[] flat = makeFlat();                   // 1 2 3 4 5 6
    int[,] m = tensor.reshape2(flat, [2, 3]);
    if (m.shape()[0] != 2 || m.shape()[1] != 3) return 1;
    if (m[0,0] != 1 || m[0,2] != 3 || m[1,0] != 4 || m[1,2] != 6) return 2;

    // reshaping to the current shape is the identity in content
    // (a shaped source flattens first — the static source is rank-1)
    int[,] same = tensor.reshape2(tensor.flatten(m), m.shape());
    if (same[0,1] != 2 || same[1,2] != 6) return 3;

    // rank-3 target: flat 4 -> [2,1,2]
    int[] four = int[4];
    for (int i = 0; i < 4; i += 1) {
        four[i] = i + 1;
    }
    int[,,] c = tensor.reshape3(four, [2, 1, 2]);
    if (c.shape()[0] != 2 || c.shape()[1] != 1 || c.shape()[2] != 2) return 4;
    if (c[0,0,0] != 1 || c[0,0,1] != 2 || c[1,0,0] != 3 || c[1,0,1] != 4) {
        return 5;
    }

    // rank-1 wrapper restores a flat array
    int[] f6 = tensor.flatten(m);
    if (f6.length() != 6) return 6;
    if (f6[0] != 1 || f6[5] != 6) return 7;
    int[] f1 = tensor.reshape1(f6, [6]);
    if (f1.length() != 6 || f1[3] != 4) return 8;

    // long kind
    long[] lsrc = long[4];
    for (int i = 0; i < 4; i += 1) {
        lsrc[i] = 10 + i;
    }
    long[,] lm = tensor.reshape2(lsrc, [2, 2]);
    if (lm[0,1] != 11 || lm[1,1] != 13) return 9;
    long[] lback = tensor.flatten(lm);
    if (lback.length() != 4 || lback[2] != 12) return 10;

    // element-count mismatch raises the base Exception and is catchable
    bool caught = false;
    try {
        tensor.reshape2(four, [2, 3]);         // product 6 != 4 elements
    } catch (Exception e) {
        caught = true;
    }
    if (!caught) return 11;
    return 0;
}
