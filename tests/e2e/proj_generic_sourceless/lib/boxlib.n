//A user generic template distributed as a sourceless package: the
//class record must carry isTemplate and the type-parameter names, and
//the T-typed signatures their ordinal leaves, so the consumer can
//instantiate Box<int> without this source (v0.13.1 D7).
class Box<T>
{
    public T item;
    public Box(T v) { item = v; }
    public T get() { return item; }
    public string kind() { return typeName(T); }
}
