// v0.13.9 phase 4: the out argument marker is retired on every
// call, intrinsics included.
import io;
class Box { int v; }

int main() {
    List<int> li = {};
    li.add(1);
    int x = 0;
    li.get(out x);            // List intrinsic
    Dict<string, int> d = {};
    d.set("a", out x);        // Dict intrinsic
    string t = "abcd";
    t.equals(out t);          // string intrinsic
    Box b = Box();
    b.equals(out b);          // class Object-protocol intrinsic
    ByteStream bs = ByteStream();
    bs.writeInt(out x);       // stream intrinsic
    return 0;
}
