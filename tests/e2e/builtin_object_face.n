// builtin-decls phase 2 (0.11.10) delta 4: the four generic prelude
// classes carry the Object face — upcast to Object is legal, toString
// dispatches virtually to the instance's declared toString, and the
// inherited identity equals distinguishes distinct instances.
int main() {
    List<int> l = [7];
    Channel<int> ch = Channel(1);
    Object o = l;
    if (o.toString() != "[7]") { return 1; }
    Object p = ch;
    if (p.equals(l) || !p.equals(ch)) { return 2; }
    return 0;
}
