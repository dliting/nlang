//0.9.10 D3: object constants would need shared runtime storage and
//construction at load time. Only scalar and string constants exist;
//the declared type gate rejects this before foldability is considered.
class Box {
	public int v;
	public Box(int v) { this.v = v;}
}

interface IBox {
	static const Box B = Box(1);
}

int main() { return 0; }
