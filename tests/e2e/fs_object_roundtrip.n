class Holder { public int v; }

int main() {
    FileStream stream = new FileStream("_phase8_tmp/object_roundtrip.bin", "w");
    Holder h = new Holder();
    h.v = 42;
    stream.writeObject(h);
    stream.close();
    FileStream stream2 = new FileStream("_phase8_tmp/object_roundtrip.bin", "r");
    Holder h2 = stream2.readObject("Holder");
    stream2.close();
    return h2.v;
}
