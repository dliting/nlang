//0.9.10 D2.4: same shape as static_ctor_name with the static declared
//first — the constructor selection must not depend on member order.
class A {
	public int x;
	public static int A(string s) { return s.length(); }
	public int A(int v, int w) { this.x = v + w; return 0; }
}
int main() {
	A a = A(3, 4);
	return a.x * 10 + A.A("abc");
}
