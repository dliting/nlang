//D14: the instance side of the struct value boundary — obj.p = local,
//bare this-field writes inside methods, and brace-initializer fills all
//copy the struct value (manual 4.7.4: a struct moving into a field is
//deep-copied).
struct Point {
    public int x;
    public int y;
    Point(int a, int b) { x = a; y = b; }
}
class Holder {
    public Point p;
    public void setP(Point v) { p = v; }
}
struct Box2 {
    public Point inner;
}
int main() {
    Point local = Point(1, 2);
    Holder h = Holder();
    h.p = local;
    local.x = 100;
    if (h.p.x != 1) { return 1; }
    Point arg = Point(8, 9);
    h.setP(arg);
    arg.x = 50;
    if (h.p.x != 8) { return 2; }
    Point v3 = Point(4, 5);
    Holder h2 = Holder{p: v3};
    v3.y = 66;
    if (h2.p.y != 5) { return 3; }
    Point v4 = Point(6, 7);
    Box2 b = Box2{inner: v4};
    v4.x = 70;
    if (b.inner.x != 6) { return 4; }
    Point back = h2.p;
    back.x = 1;
    if (h2.p.x != 4) { return 5; }
    return 0;
}
