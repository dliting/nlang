int main() {
    int a = 10;
    int b = 3;
    int c = a - b;
    int d = a * b;
    int e = a / b;
    int f = a % b;
    if (c == 7) {
        if (d == 30) {
            if (e == 3) {
                if (f == 1) {
                    return 1;
                }
            }
        }
    }
    return 0;
}
