import io;
import thread;
import net;

class EchoHandler {
    public TcpStream conn;
    public void run() {
        byte[] buf = byte[16];
        int n = conn.read(buf, 5000);
        conn.write(buf, n);
        conn.close();
    }
}

int main() {
    TcpListener srv = TcpListener.bind("127.0.0.1", 0);
    int port = srv.localPort();
    EchoHandler h = EchoHandler();
    //Connect first: the listen backlog lets the kernel complete the
    //handshake, so accept immediately finds the pending connection; if
    //accept came first, the main context would park and connect would
    //never run.
    TcpStream cli = TcpStream.connect("127.0.0.1", port, 5000);
    h.conn = srv.accept(5000);
    Thread t = thread.spawn(h.run);
    cli.write(io.toBytes("ping"));
    //The 4-byte buffer exactly holds the single-segment loopback echo,
    //so a plain read suffices and fromBytes(whole buffer) is the message.
    byte[] buf = byte[4];
    int n = cli.read(buf, 5000);
    if (n != 4 || io.fromBytes(buf) != "ping") { return 1; }
    cli.close();
    thread.join(t);
    srv.close();
    io.print("ok");
    return 0;
}
