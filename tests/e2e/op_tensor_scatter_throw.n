// Out-of-range scatter index: uncaught Exception, exit 1 by design.
// The device kernel writes the cell error flags (both bounds; no
// negative wrap); the slot raises the named exception with the CPU
// walk's message.
import tensor;

int main() {
    int[] a = tensor.arange(0, 4, 1);
    int[] idx = int[1];
    idx[0] = -1;
    int[] r = tensor.scatter(a, 0, idx, 5);
    return 0;
}
