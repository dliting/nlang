//Concurrency gate hammer — Semaphore(2) must cap the section at two
//concurrent workers, with the Mutex-guarded counter observing the peak.
//The in-section tripwire turns any over-admission into an immediate
//throw (the failing worker's join rethrows into main), so a violation
//fails the run at once instead of only at the final print. 10000
//iterations x 4 workers with a yield inside the section (permit held)
//open the cross-carrier park/wake windows; the stale-stamp-wake family
//this pins showed as peak 3 > limit 2 and spurious "unlock without
//holding" errors at >= 3 carriers.
import thread;
import io;

class Section {
    public Semaphore slots;
    public Mutex gate;
    public int inside;
    public int total = 0;
    public int peak;
    public void work() {
        for (int i = 0; i < 10000; i += 1) {
            slots.acquire();
            gate.lock();
            total += 1;
            inside = inside + 1;
            if (inside > peak) {
                peak = inside;
            }
            if (inside > 2) {
                gate.unlock();
                throw IOException("gate invariant violated");
            }
            gate.unlock();
            thread.yield();
            gate.lock();
            inside = inside - 1;
            gate.unlock();
            slots.release();
        }
    }
}

int main() {
    Section s = Section();
    s.slots = Semaphore(2);
    s.gate = Mutex();
    Thread a = thread.spawn(s.work);
    Thread b = thread.spawn(s.work);
    Thread c = thread.spawn(s.work);
    Thread d = thread.spawn(s.work);
    thread.join(a);
    thread.join(b);
    thread.join(c);
    thread.join(d);
    int peakObserved = s.peak;
    int total = s.total;
    io.print("peak inside the section: ${peakObserved} (limit 2), total: ${total}");
    if (s.peak == 2 && s.total == 40000) {
        return 17;
    }
    return 1;
}
