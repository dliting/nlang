// tensor.neg: elementwise negation across kinds — int/long wrap like
// language arithmetic, float keeps -0.0 and the sign of zero.
import tensor;

int main() {
    int[] ai = tensor.arange(-2, 3, 1);          // -2 -1 0 1 2
    int[] ni = tensor.neg(ai);
    if (tensor.sum(ni) != 0) return 1;
    if (ni[0] != 2 || ni[4] != -2) return 2;

    long[] nl = tensor.neg(tensor.fullL(3, 5000000000));
    if (nl[2] != -5000000000) return 3;

    float[] nf = tensor.neg(tensor.fullF(2, 0.5 as float));
    if (nf[0] != -0.5 as float || nf[1] >= 0.0 as float) return 4;

    double[] nd = tensor.neg(tensor.fullD(2, 1.5));
    if (nd[0] != -1.5) return 5;

    //Negation of an expression rides the same native.
    float[] expr = tensor.neg(tensor.add(tensor.fullF(2, 1.0 as float),
                                        tensor.fullF(2, 1.0 as float)));
    if (expr[1] != -2.0 as float) return 6;
    return 0;
}
