// Phase 9c audit round 4: default with binary expression on no-arg funcs
// (substitute for "globals" since NLang has no module-scope vars).
int g1() { return 3; }
int g2() { return 7; }
int foo(int a = g1() + g2(), int b = a * 2) { return a + b; }
int main() {
    //a = 3+7 = 10; b = 10*2 = 20; result = 30
    return foo();
}
