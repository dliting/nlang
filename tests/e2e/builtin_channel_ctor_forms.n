// builtin-decls phase 2 (0.11.11): Channel declares TWO ctor overloads —
// unbounded (zero-formal) and bounded (capacity). The three user-visible
// construction forms must route to the right intrinsic: the zero-arg
// intrinsic never reads the unstaged capacity slot. (`new ...` spellings
// are not NLang — new is an ordinary identifier since 0.9.0 D8.)
int main() {
    Channel<int> a = {};
    a.send(11);
    Channel<int> b = Channel(2);
    b.send(21);
    Channel<int> c = Channel();
    c.send(41);
    int sum = a.recv() + b.recv() + c.recv();
    if (sum != 73) { return 1; }
    return 0;
}
