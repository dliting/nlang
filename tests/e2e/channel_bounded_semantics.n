//K3: bounded channel — capacity construction, park-at-full send, and
//close waking a parked sender with the catchable exception.
import concurrent;
import io;
import thread;

class Pump {
    public Channel<int> ch;
    public Channel<int> ready;
    public void fill() {
        ch.send(1);
        ch.send(2);
        ready.send(0);
        try {
            ch.send(3);
        } catch (ChannelClosedException e) {
            io.write("E");
        }
    }
}

//A readiness channel gives close a causal edge: once ready delivers,
//both values sit in the buffer, so the third send either parks and is
//aborted by close or arrives at the closed channel — the same
//catchable exception either way. A yield-based race let a slow-
//starting sender lose to close under multi-carrier ASan builds.
int main() {
    Pump p = Pump();
    p.ch = Channel(2);
    p.ready = Channel(1);
    Thread t = thread.spawn(p.fill);
    p.ready.recv();
    p.ch.close();
    int first = p.ch.recv();
    int second = p.ch.recv();
    thread.join(t);
    io.write("v" + first + second);
    return 0;
}
