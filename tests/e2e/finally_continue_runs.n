//Phase 9d-2: continue inside a try-with-finally must run the finally
//body copy before jumping to the loop's continue target. i=1,3 hit
//continue (finally still runs); i=2,4 fall through to the counter.
int main() {
    int g = 0;
    int i = 0;
    int fellThrough = 0;
    while (i < 4) {
        i = i + 1;
        try {
            if (i % 2 == 1) { continue; }
            fellThrough = fellThrough + 1;
        } finally {
            g = g + 1;
        }
    }
    if (g == 4 && fellThrough == 2) { return 7; }
    return 1;
}
