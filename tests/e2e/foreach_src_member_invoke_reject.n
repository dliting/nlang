//foreach over an array VALUE from a bound method call: `b.mk()` where
//mk returns int[] — the member arm of the value family (the member
//field is the SnFunction; the array-ness lives on the invoke's return
//token). 0.7.3 B D10: accepted.
class Box {
	public int[] mk() {
		int[] a = [10, 20, 30];
		return a;
	}
}

int main() {
	Box b = new Box();
	int total = 0;
	foreach (int x in b.mk()) {
		total = total + x;
	}
	return total;
}
