// ND creation, element read/write, cross-element independence.
import io;
int main() {
    int[,] a = int[2,3];
    a[1,2] = 7;
    if (a[1,2] != 7) return 1;
    if (a[0,0] != 0) return 2;
    a[0,2] = 9;
    if (a[0,2] != 9 || a[1,2] != 7) return 3;
    double[,] d = double[2,2];
    d[1,1] = 2.5;
    if (d[1,1] != 2.5) return 4;
    long[,] l = long[2,2];
    l[1,1] = 4294967296;
    if (l[1,1] != 4294967296) return 5;
    string[,] strs = string[2,2];
    strs[0,1] = "hi";
    if (strs[0,1] != "hi") return 6;
    //Chained shape subscript in a module with no rank-1 declaration:
    //the shape mint must register int[] eagerly at codegen.
    if (a.shape()[1] != 3) return 7;
    io.print(a.length());
    return 0;
}
