import math;
int main() {
    //Lock: NLang float-to-int narrowing (`as int`) truncates toward zero
    //(C/C#/Java style), not floor (Python math.floor).
    //0.7.5: narrowing is explicit-only (TCK_Explicit).
    //-3.7 → -3 (truncate toward zero), not -4 (floor). Pairs with the
    //existing cast_float_to_int test which only covers the positive case
    //(3.5 → 3, ambiguous between truncate and floor).
    //
    //Returns 7 only if both negative and positive cases truncate toward
    //zero. Any other behavior (floor, round-half-to-even, etc.) returns 1.
    float neg = -3.7f;
    float pos = 3.7f;
    int ni = neg as int;
    int pi = pos as int;
    if (ni == -3 && pi == 3) {
        return 7;
    }
    return 1;
}
