// v0.13.9 phase 4: the out mark inside the func type retires; the
// virtual-bound-method subject now lives behind the reference mark.
class B {
    public virtual void grab(out int r) { r = 1; }
}

void apply(func<void, out int> f) { }

int main() {
    B b = B();
    apply(b.grab);
    return 0;
}
