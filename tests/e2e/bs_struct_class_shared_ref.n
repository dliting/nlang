class Holder {
    public int v;
}

struct Pair {
    Holder a;
    Holder b;
}

int main() {
    ByteStream bs = new ByteStream();
    Holder h = new Holder();
    h.v = 7;
    Pair p;
    p.a = h;
    p.b = h;
    bs.writeStruct(p);
    bs.reset();
    Pair q = bs.readStruct("Pair");
    if (q.a == q.b) {
        return 1;
    }
    return 0;
}
