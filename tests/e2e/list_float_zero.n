int main() {
	//Phase 8e-1 OP_Box fix: float 0.0 is now correctly boxed (always
	//allocates heap slot). Symmetric to list_int_zero_throws.
	List<float> nums = new List<float>();
	nums.add(0.0f);
	nums.add(3.14f);
	float x = nums.get(0);
	float y = nums.get(1);
	if (x == 0.0f && y == 3.14f) return 7;
	return 1;
}
