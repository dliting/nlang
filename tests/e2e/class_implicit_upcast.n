class Animal { public int legs; }
class Dog : Animal { public int teeth; }

//Cover implicit upcast: Dog-typed local assigned to Animal-typed
//local. This is the basic polymorphism pattern. Existing class_inherit
//tests field/method inheritance but doesn't directly verify that a
//derived instance can be stored in a base-typed local without an
//explicit cast (the resolver checks "is-a" relationship).
int main() {
    Dog d = new Dog();
    d.legs = 4;
    d.teeth = 42;
    Animal a = d;
    return a.legs;
}
