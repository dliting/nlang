//I/O fixture for the embed tests (keys "io_demo.<name>"). Depends on the
//stdlib io module — the only embed fixture that does. The closure is one
//addImportDir: io.n declarations, stdlib.npkg and nlang_io.dll all
//resolve from that directory (native modules follow the import-dir
//search list, not the test exe's location).
import io;

int emitBoth() {
    io.print("to-out");
    io.eprint("to-err");
    return 0;
}

int readWhenNoChannel() {
    try {
        string line = io.readLine();
        return -1;   //got a line somehow — not our path
    } catch (IOException e) {
        return 1;   //NoChannel default: first read raises IOException
    }
}

int main() {
    return 0;
}
