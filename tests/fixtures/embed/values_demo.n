//Embedding test fixture: free functions exercised through the by-name
//entry and Interpreter::call(). Qualified keys are "values_demo.<name>"
//(the declaring TU stem).
int add(int a, int b) {
    return a + b;
}

string greet(string name) {
    return "hello, " + name;
}

int withDefaults(int a, int b = 5, int c = 9) {
    return a * 100 + b * 10 + c;
}

int usesDefaults(int a) {
    return withDefaults(a, 5, 9);
}

int boom() {
    throw new Exception("embedded-boom");
}

int withOut(int a, out int b) {
    b = a * 2;
    return a;
}

struct Pair {
    int a;
    int b;
}

Pair makePair(int a, int b) {
    Pair p;
    p.a = a;
    p.b = b;
    return p;
}

int sumPair(Pair p) {
    return p.a + p.b;
}

int twice(int x) {
    return x * 2;
}

func<int, int> makeFunc() {
    return twice;
}

int applyFunc(func<int, int> f, int x) {
    return f(x);
}

//Native-method fixture: callNativeMethod instantiates the class and calls
//its native method, so a VM-level test can attach a host table registered
//under the bare method name (the only key form a method callee can match)
//and pin the dispatch-boundary guard in HostFunctionTable::Call.
class NativeOps {
    public native int bump(int x);
}

int callNativeMethod() {
    NativeOps ops = new NativeOps();
    return ops.bump(1);
}

void logNothing() {
    int pad = 0;
}

int main() {
    return 7;
}
