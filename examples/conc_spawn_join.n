//Concurrency example 1 of 8 — spawn and join.
//thread.spawn turns a bound method into a task and returns a Thread
//handle; thread.join parks the caller until that task finishes. The
//progress lines interleave freely; only the line after both joins has
//a guaranteed position.
import thread;
import io;

class Summer {
    public string name;
    public int count;
    public void run() {
        io.print("${name}: summing 0..${count}");
        int total = 0;
        for (int i = 0; i < count; i = i + 1) {
            total = total + i;
        }
        io.print("${name}: total ${total}");
    }
}

int main() {
    Summer a = Summer();
    a.name = "A";
    a.count = 10;
    Summer b = Summer();
    b.name = "B";
    b.count = 6;
    Thread ta = thread.spawn(a.run);
    Thread tb = thread.spawn(b.run);
    thread.join(ta);
    thread.join(tb);
    io.print("both tasks finished");
    return 13;
}
