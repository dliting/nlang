// inheritance_super.n — extends, super(), overriding, virtual dispatch.
import io;
class Shape {
    public string name;

    public Shape(string name) {
        this.name = name;
    }

    public virtual int sides() { return 0; }

    public string toString() { return name; }
}

class Triangle : Shape {
    public Triangle() {
        super("triangle");
    }

    public int sides() { return 3; }
}

class Square : Shape {
    public Square() {
        super("square");
    }

    public int sides() { return 4; }
}

int main() {
    Shape s = Triangle();      // base-typed reference
    io.print(s.toString() + " has " + s.sides() + " sides");
    if (s.sides() != 3)
        return 1;
    s = Square();
    io.print(s.toString() + " has " + s.sides() + " sides");
    if (s.sides() == 4)
        return 4;
    return 1;
}
