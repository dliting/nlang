// tensor_tour — creation, elementwise and reduction kernels of the
// tensor package across element kinds.
import io;
import tensor;

int main() {
    // creation across kinds
    int[] ai = tensor.arange(10, 0, -3);          // 10 7 4 1
    double[] ad = tensor.arange(0.0, 1.0, 0.25);  // 0.0 0.25 0.5 0.75
    io.print(ai.length());                         // 4
    io.print(ai[0]);                               // 10
    io.print(ad[3]);                               // 0.75

    // elementwise binary (same-name overload picks double here)
    double[] c = tensor.add(ad, tensor.full(4, 2.0));
    io.print(tensor.sum(c));                       // 9.5

    // reductions: mean always double, dot widens int to long
    io.print(tensor.mean(ai));                     // 5.5
    int[] big = tensor.full(3, 100000);
    io.print(tensor.dot(big, big));                // 30000000000

    // error semantics follow the language families
    try {
        int m = tensor.max(int[0]);
        io.print(m);
    } catch (Exception e) {
        io.print("max of empty raises");
    }
    return 0;
}
