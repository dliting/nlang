// interpolation_tour.n — "${identifier}" interpolation + toString coercion.
import io;
class Money {
    public int cents;

    public int Money(int cents) {
        this.cents = cents;
        return 0;
    }

    public string toString() {
        return "${cents}c";
    }
}

int main() {
    string who = "nlang";
    int year = 2026;
    io.print("hello, ${who}");     // hello, nlang
    io.print("year: ${year}");     // year: 2026
    Money price = new Money(4990);
    io.print("costs " + price);    // costs 4990c
    string banner = "${who} ${year}";
    if (banner == "nlang 2026")
        return 9;
    return 1;
}
