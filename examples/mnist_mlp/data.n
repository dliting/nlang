// data.n — MNIST subset loading: fs.readFloats for the image planes and
// fs.readBytes for the label planes, so both halves of the fs binary
// read pair do real work. The binaries are headerless (generated by
// tools/mnist_subset.py), so the record count and pixel width arrive as
// arguments and the actual file sizes are asserted against them once,
// at load time.
import fs;
import tensor;

struct Dataset {
    float[,] images;   // count x pixels
    int[] labels;      // count
    int count;
}

Dataset loadDataset(string imageFile, string labelFile, int count,
                    int pixels) {
    float[] flatImages = fs.readFloats(imageFile);
    int[] labels = fs.readBytes(labelFile);
    assert(flatImages.length() == count * pixels);
    assert(labels.length() == count);

    // The file bytes are already row-major count x pixels and the source
    // array is contiguous, so reshape hands back a view — no element is
    // copied here.
    int[] shape = int[2];
    shape[0] = count;
    shape[1] = pixels;
    Dataset d;
    d.images = tensor.reshape(flatImages, shape);
    d.labels = labels;
    d.count = count;
    return d;
}

// One mini-batch: a contiguous block of rows, taken as a zero-copy view.
// The subset keeps the upstream file order, which is already shuffled,
// so consecutive row blocks are random batches; the batch grouping is a
// deterministic function of the seed (the whole run is reproducible).
float[,] batchImages(Dataset d, int first, int rows) {
    return d.images[first:first + rows, :];
}

int[] batchLabels(Dataset d, int first, int rows) {
    int[] picked = int[rows];
    for (int i = 0; i < rows; i += 1) {
        picked[i] = d.labels[first + i];
    }
    return picked;
}
