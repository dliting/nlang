//Concurrency example 4 of 8 — shared state under a Mutex.
//Four tasks each increment a shared counter ten times. The mutex makes
//every read-modify-write atomic, so the final value can only be 40;
//without it, an interleaving could lose updates.
import concurrent;
import thread;
import io;

class Counter {
    public Mutex gate;
    public int value;
    public void bumpTen() {
        for (int i = 0; i < 10; i = i + 1) {
            gate.lock();
            value = value + 1;
            gate.unlock();
        }
    }
}

int main() {
    Counter c = Counter();
    c.gate = Mutex();
    Thread a = thread.spawn(c.bumpTen);
    Thread b = thread.spawn(c.bumpTen);
    Thread d = thread.spawn(c.bumpTen);
    Thread e = thread.spawn(c.bumpTen);
    thread.join(a);
    thread.join(b);
    thread.join(d);
    thread.join(e);
    int total = c.value;
    io.print("counter after 4x10 increments: ${total}");
    if (total == 40) {
        return 16;
    }
    return 1;
}
