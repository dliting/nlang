// cast_operator.n — the `as` cast: boxed unbox + reference downcast.
// (Numeric float->int is an implicit assignment conversion, not `as`;
//  `as` targets are single type names — primitives (unbox) or classes
//  (downcast) — never generic instantiations.)
import io;
class Config {
    public int answer;
}

int main() {
    float price = 9.9;
    int units = price;             // implicit conversion truncates toward zero: 9
    io.print(units);
    Object boxed = units;          // box the int into an Object
    int back = boxed as int;       // `as` unbox recovers the value
    Object o = new Config();
    Config c = o as Config;        // `as` reference downcast
    c.answer = 10;
    io.print(c.answer);
    if (units == 9 && back == 9 && c.answer == 10)
        return 10;
    return 1;
}
