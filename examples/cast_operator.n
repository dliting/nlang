// cast_operator.n — the `as` cast: explicit narrowing, boxed unbox,
// reference downcast. (0.7.5: float->int narrowing moved from implicit
//  assignment to `as`; `as` targets are single type names — primitives
//  or classes — never generic instantiations.)
import io;
class Config {
    public int answer;
}

int main() {
    float price = 9.9;
    int units = price as int;      // explicit narrowing truncates toward zero: 9
    io.print(units);
    Object boxed = units;          // box the int into an Object
    int back = boxed as int;       // `as` unbox recovers the value
    Object o = new Config();
    Config c = o as Config;        // `as` reference downcast
    c.answer = 10;
    io.print(c.answer);
    if (units == 9 && back == 9 && c.answer == 10)
        return 10;
    return 1;
}
