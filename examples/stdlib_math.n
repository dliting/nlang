// stdlib_math.n — math namespace tour (Phase 11).
// Trigonometry is radians; log is ln; floor/ceil/round return int.

import io;
import math;
int main() {
    io.print(math.sqrt(2.0));             // 1.41421
    io.print(math.pow(2.0, 10.0));        // 1024
    io.print(math.log(math.exp(1.0)));    // 1 — log is the natural log
    io.print(math.floor(-1.5));           // -2
    io.print(math.round(-2.5));           // -3 — half away from zero
    io.print(math.maxi(3, 7));            // 7
    io.print(math.clampf(5.0, 0.0, 1.0)); // 1
    math.srand(42);
    float first = math.random();
    math.srand(42);
    float second = math.random();
    if (first != second) return 1;        // srand reseeds deterministically
    io.print(math.randomi(1, 6));         // dice roll, inclusive bounds
    return 0;
}
