//Standard library source for the "builtins" prelude package — the
//language core and the base containers only (D1: everything else
//needs an import). Implicitly imported into every compilation unit
//(JLS §7.5.3 analogue): the names are visible without an import
//statement, and user declarations shadow them by the ordinary
//innermost-wins rule. Native class: the implementations live in the
//VM (intrinsic channel), so class members are declared native.
//Compile-time inline only: the stdlib.npkg pack list excludes this
//file; the build-tree stdlib copy keeps it for disk-first development.
//Concurrency: import thread; / import concurrent;

//Resizing sequence of elements of one type. Elements are boxed at the
//runtime boundary for primitive type arguments (erasure); class and
//struct elements travel as references. Indexing sugar: lst[i].
class List<T> {
    public native List();
    public native void add(T item);
    public native T get(int index);
    public native void set(int index, T value);
    public native int length();
    public native void removeAt(int index);
    public native int indexOf(T item);
    public native bool contains(T item);
    public native void clear();
    public native string toString();
}

//Key-value map with insertion-ordered keys. Indexing sugar: dict[k].
class Dict<K, V> {
    public native Dict();
    public native void set(K key, V value);
    public native V get(K key);
    public native bool containsKey(K key);
    public native int remove(K key);
    public native void clear();
    public native int count();
    public native List<K> keys();
    public native string toString();
}

//Base class of every catchable runtime failure. message carries the
//diagnostic text; backtrace is the call chain at the throw point,
//innermost first.
class Exception {
    public string message;
    public List<string> backtrace;
    public native Exception(string message);
}

class NullPointerException : Exception {
    public native NullPointerException(string message);
}

class DivByZeroException : Exception {
    public native DivByZeroException(string message);
}

class IndexOutOfBoundsException : Exception {
    public native IndexOutOfBoundsException(string message);
}

class AssertionException : Exception {
    public native AssertionException(string message);
}

class IOException : Exception {
    public native IOException(string message);
}

class InvalidCastException : Exception {
    public native InvalidCastException(string message);
}

//Root of the class hierarchy: every class without a declared base
//inherits these three protocol methods. Override them with the exact
//signatures to customize per-class behavior.
class Object {
    public virtual native int equals(Object other);
    public virtual native int getHashCode();
    public virtual native string toString();
}

//String's method face — the declaration-level source of truth for the
//string keyword type (C# alias model: `string` is the user spelling,
//String is the declared face class). Instances are the pooled string
//objects themselves; this class cannot be instantiated or extended,
//and it stays out of the class hierarchy (no implicit Object base),
//so its methods are never virtual overrides.
//substring(start) with one argument means "through the end".
class String {
    public native int length();
    public native int getHashCode();
    public native int equals(string other);
    public native string toString();
    public native string substring(int start);
    public native string substring(int start, int end);
    public native int indexOf(string sub);
    public native bool startsWith(string prefix);
    public native bool endsWith(string suffix);
    public native bool contains(string sub);
    public native string toUpper();
    public native string toLower();
    public native string trim();
    public native List<string> split(string sep);
    public native string replace(string old, string new_);
    public native int toInt();
    public native float toFloat();
    public native char charAt(int byteIdx);
    public native int charCount();
    public native char toChar();
    public native long toLong();
    public native double toDouble();
    public native bool toBool();
}

//Array's method face — declaration-level source of truth for every
//array type (int[], string[,], …; rank rides the array type itself).
//length() is the element count (total elements for rank > 1), rank()
//the static rank, shape() the per-dimension sizes as int[rank]. Face
//holder only: not instantiable, not extendable, no Object base.
class Array {
    public native int length();
    public native int rank();
    public native int[] shape();
    public native string toString();
}
