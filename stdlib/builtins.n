//Standard library source for the "builtins" package — authoritative
//declarations for the builtin classes. Implicitly imported into every
//compilation unit (JLS §7.5.3 analogue): the names are visible without
//an import statement, and user declarations shadow them by the
//ordinary innermost-wins rule. Native class: the implementations live
//in the VM (intrinsic channel), so class members are declared native.
//Compile-time inline only: the stdlib.npkg pack list excludes this
//file; the build-tree stdlib copy keeps it for disk-first development.

//Mutual exclusion: lock() parks the caller while the mutex is held;
//unlock() hands ownership to the front waiter (FIFO handoff).
//tryLock() takes the mutex only if it is free; never parks.
class Mutex {
    public native Mutex();
    public native void lock();
    public native void unlock();
    public native bool tryLock();
}

//Counting semaphore with FIFO handoff: acquire() parks at zero permits
//and release() hands the permit directly to the front waiter.
//tryAcquire() never parks; over-release is legal.
class Semaphore {
    public native Semaphore(int initial);
    public native void acquire();
    public native void release();
    public native bool tryAcquire();
}
