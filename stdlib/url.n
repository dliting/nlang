// Standard library source for the "url" package — authoritative
// declarations, indexed by langservice::SymbolIndex and inlined into
// every build. The package comes from this file's path (the stem
// "url"). The whole package is plain NLang on top of io's byte/string
// converters; there is no native code.
import io;

// Raised for malformed URLs: syntax errors, out-of-range ports,
// truncated or invalid percent escapes, and input over the maxBytes
// budget.
const class UrlException : IOException {
    public UrlException(string message, Exception cause = null) {
        super(message, cause);
    }
}

// An immutable URL value (RFC 3986). Url.parse is the only
// construction entry point. Two normalizations are applied at parse
// time: scheme and host are lowercased (RFC 3986 6.2.2/6.2.3); no
// dot-segment removal happens outside resolve. query and fragment
// distinguish "absent" from "present but empty" through the
// hasQuery/hasFragment flags (the empty string is a legitimate present
// value, so presence cannot ride on the value): "http://h" has
// hasQuery == false,
// "http://h?" has hasQuery == true with query == "". userInfo keeps
// its bytes undecoded.
const class Url {
    public string scheme;
    public string userInfo;
    public string host;
    public int port;
    public string path;
    public string query;
    public bool hasQuery;
    public string fragment;
    public bool hasFragment;

    private Url(string reference, int maxBytes = 0) {
        if (maxBytes > 0 && reference.length() > maxBytes) {
            throw UrlException("url: input exceeds " + maxBytes.toString() + " bytes");
        }
        string rest = reference;
        query = "";
        fragment = "";
        int h = rest.indexOf("#");
        hasFragment = h >= 0;
        if (h >= 0) {
            fragment = rest.substring(h + 1);
            rest = rest.substring(0, h);
        }
        int q = rest.indexOf("?");
        hasQuery = q >= 0;
        if (q >= 0) {
            query = rest.substring(q + 1);
            rest = rest.substring(0, q);
        }
        userInfo = "";
        host = "";
        port = -1;
        // Scheme: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":". The
        // scan stops at the first byte that cannot appear in a scheme,
        // so a colon in a later segment never reads as one; a colon
        // reached inside the first segment with an invalid scheme is an
        // error (RFC 3986 4.2: a relative-ref may not contain a colon
        // there).
        scheme = "";
        int colon = -1;
        for (int i = 0; i < rest.length(); i = i + 1) {
            int c = rest[i];
            if (c == 58) { colon = i; break; }
            bool ok = (c >= 48 && c <= 57) || (c >= 43 && c <= 43)
                || (c >= 45 && c <= 46) || isAlpha(c);
            if (!ok) { break; }
        }
        if (colon >= 0) {
            if (colon == 0 || !isAlpha(rest[0])) {
                throw UrlException("url: invalid scheme in \"" + reference + "\"");
            }
            scheme = asciiLower(rest.substring(0, colon));
            rest = rest.substring(colon + 1);
        }
        path = rest;
        if (rest.length() >= 2 && (rest[0]) == 47 && (rest[1]) == 47) {
            rest = rest.substring(2);
            int end = rest.length();
            for (int i = 0; i < rest.length(); i = i + 1) {
                if ((rest[i]) == 47) { end = i; break; }
            }
            string auth = rest.substring(0, end);
            path = rest.substring(end);
            int at = -1;
            for (int i = auth.length() - 1; i >= 0; i = i - 1) {
                if ((auth[i]) == 64) { at = i; break; }
            }
            string hostpart = auth;
            if (at >= 0) {
                userInfo = auth.substring(0, at);
                hostpart = auth.substring(at + 1);
            }
            if (hostpart.length() > 0 && (hostpart[0]) == 91) {
                int close = hostpart.indexOf("]");
                if (close < 0) {
                    throw UrlException("url: unterminated IPv6 host literal in \"" + reference + "\"");
                }
                host = asciiLower(hostpart.substring(0, close + 1));
                string tail = hostpart.substring(close + 1);
                if (tail.length() > 0) {
                    if ((tail[0]) != 58) {
                        throw UrlException("url: unexpected text after IPv6 host literal in \"" + reference + "\"");
                    }
                    port = parsePort(tail.substring(1), reference);
                }
            } else {
                int pc = -1;
                for (int i = hostpart.length() - 1; i >= 0; i = i - 1) {
                    if ((hostpart[i]) == 58) { pc = i; break; }
                }
                string hostRaw = hostpart;
                if (pc >= 0) {
                    hostRaw = hostpart.substring(0, pc);
                    port = parsePort(hostpart.substring(pc + 1), reference);
                }
                host = asciiLower(hostRaw);
            }
        }
    }

    // Parses an absolute URL or a relative reference. maxBytes > 0
    // bounds the input length (a longer reference raises UrlException).
    // Syntax errors raise UrlException.
    public static Url parse(string reference, int maxBytes = 0) {
        return Url(reference, maxBytes);
    }

    public bool isAbsolute() {
        return scheme != "";
    }

    // Reassembles the components. Round-trips: parsing the output
    // yields the same field values. The authority ("//") is emitted
    // only when host or userInfo are present: a path-absolute path
    // without an authority ("http:/foo") must stay path-absolute, or
    // the first path segment would reparse as the host.
    public string toString() {
        string text = "";
        if (scheme != "" || host != "" || userInfo != "") {
            if (scheme != "") { text = text + scheme + ":"; }
            if (host != "" || userInfo != "") {
                text = text + "//";
                if (userInfo != "") { text = text + userInfo + "@"; }
                text = text + host;
                if (port >= 0) { text = text + ":" + port.toString(); }
            }
        }
        text = text + path;
        if (hasQuery) { text = text + "?" + query; }
        if (hasFragment) { text = text + "#" + fragment; }
        return text;
    }

    private static bool isAlpha(int c) {
        return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    }

    // ASCII-only lowercasing (scheme/host normalization).
    private static string asciiLower(string s) {
        byte[] b = io.toBytes(s);
        for (int i = 0; i < b.length(); i = i + 1) {
            int c = b[i];
            if (c >= 65 && c <= 90) { b[i] = (c + 32) as byte; }
        }
        return io.fromBytes(b);
    }

    // Digits only, 0..65535; an empty port ("http://h:/p") means
    // "not given" (-1).
    private static int parsePort(string ps, string reference) {
        if (ps.length() == 0) { return -1; }
        int p = 0;
        for (int i = 0; i < ps.length(); i = i + 1) {
            int c = ps[i];
            if (c < 48 || c > 57) {
                throw UrlException("url: invalid port in \"" + reference + "\"");
            }
            p = p * 10 + (c - 48);
            if (p > 65535) {
                throw UrlException("url: port out of range in \"" + reference + "\"");
            }
        }
        return p;
    }
}

// Percent-encode one full component value: every byte outside the
// RFC 3986 unreserved set (A-Z a-z 0-9 - . _ ~) becomes %XX, '/'
// included. The contract is a single component value — encode path
// segments separately and join them with '/'.
string percentEncode(string s) {
    byte[] src = io.toBytes(s);
    byte[] dst = byte[src.length() * 3];
    int j = 0;
    for (int i = 0; i < src.length(); i = i + 1) {
        int v = src[i];
        if (v < 0) { v = v + 256; }
        if ((v >= 65 && v <= 90) || (v >= 97 && v <= 122)
            || (v >= 48 && v <= 57) || v == 45 || v == 46 || v == 95 || v == 126) {
            dst[j] = v as byte;
            j = j + 1;
        } else {
            dst[j] = 37 as byte;
            int hi = v / 16;
            int lo = v % 16;
            int dh = hi;
            if (dh < 10) { dh = dh + 48; } else { dh = dh + 55; }
            dst[j + 1] = dh as byte;
            int dl = lo;
            if (dl < 10) { dl = dl + 48; } else { dl = dl + 55; }
            dst[j + 2] = dl as byte;
            j = j + 3;
        }
    }
    return io.fromBytes(dst[0:j]);
}

// Decodes %XX escapes; '+' is NOT a space here. A truncated escape or
// a non-hex digit raises UrlException.
string percentDecode(string s) {
    byte[] src = io.toBytes(s);
    byte[] dst = byte[src.length()];
    int j = 0;
    for (int i = 0; i < src.length(); i = i + 1) {
        int v = src[i];
        if (v < 0) { v = v + 256; }
        if (v == 37) {
            if (i + 2 >= src.length()) {
                throw UrlException("url: truncated percent escape in \"" + s + "\"");
            }
            int hi = src[i + 1];
            int lo = src[i + 2];
            if (hi < 0) { hi = hi + 256; }
            if (lo < 0) { lo = lo + 256; }
            int hv = -1;
            if (hi >= 48 && hi <= 57) { hv = hi - 48; }
            else if (hi >= 65 && hi <= 70) { hv = hi - 55; }
            else if (hi >= 97 && hi <= 102) { hv = hi - 87; }
            int lv = -1;
            if (lo >= 48 && lo <= 57) { lv = lo - 48; }
            else if (lo >= 65 && lo <= 70) { lv = lo - 55; }
            else if (lo >= 97 && lo <= 102) { lv = lo - 87; }
            if (hv < 0 || lv < 0) {
                throw UrlException("url: invalid percent escape in \"" + s + "\"");
            }
            dst[j] = (hv * 16 + lv) as byte;
            j = j + 1;
            i = i + 2;
        } else {
            dst[j] = v as byte;
            j = j + 1;
        }
    }
    return io.fromBytes(dst[0:j]);
}

// application/x-www-form-urlencoded component encoding: like
// percentEncode but spaces become '+'.
string formEncode(string s) {
    byte[] src = io.toBytes(s);
    byte[] dst = byte[src.length() * 3];
    int j = 0;
    for (int i = 0; i < src.length(); i = i + 1) {
        int v = src[i];
        if (v < 0) { v = v + 256; }
        if (v == 32) {
            dst[j] = 43 as byte;
            j = j + 1;
        } else if ((v >= 65 && v <= 90) || (v >= 97 && v <= 122)
            || (v >= 48 && v <= 57) || v == 45 || v == 46 || v == 95 || v == 126) {
            dst[j] = v as byte;
            j = j + 1;
        } else {
            dst[j] = 37 as byte;
            int hi = v / 16;
            int lo = v % 16;
            int dh = hi;
            if (dh < 10) { dh = dh + 48; } else { dh = dh + 55; }
            dst[j + 1] = dh as byte;
            int dl = lo;
            if (dl < 10) { dl = dl + 48; } else { dl = dl + 55; }
            dst[j + 2] = dl as byte;
            j = j + 3;
        }
    }
    return io.fromBytes(dst[0:j]);
}

// Decodes '+' as space and %XX escapes; malformed escapes raise
// UrlException.
string formDecode(string s) {
    byte[] src = io.toBytes(s);
    byte[] dst = byte[src.length()];
    int j = 0;
    for (int i = 0; i < src.length(); i = i + 1) {
        int v = src[i];
        if (v < 0) { v = v + 256; }
        if (v == 43) {
            dst[j] = 32 as byte;
            j = j + 1;
        } else if (v == 37) {
            if (i + 2 >= src.length()) {
                throw UrlException("url: truncated percent escape in \"" + s + "\"");
            }
            int hi = src[i + 1];
            int lo = src[i + 2];
            if (hi < 0) { hi = hi + 256; }
            if (lo < 0) { lo = lo + 256; }
            int hv = -1;
            if (hi >= 48 && hi <= 57) { hv = hi - 48; }
            else if (hi >= 65 && hi <= 70) { hv = hi - 55; }
            else if (hi >= 97 && hi <= 102) { hv = hi - 87; }
            int lv = -1;
            if (lo >= 48 && lo <= 57) { lv = lo - 48; }
            else if (lo >= 65 && lo <= 70) { lv = lo - 55; }
            else if (lo >= 97 && lo <= 102) { lv = lo - 87; }
            if (hv < 0 || lv < 0) {
                throw UrlException("url: invalid percent escape in \"" + s + "\"");
            }
            dst[j] = (hv * 16 + lv) as byte;
            j = j + 1;
            i = i + 2;
        } else {
            dst[j] = v as byte;
            j = j + 1;
        }
    }
    return io.fromBytes(dst[0:j]);
}
