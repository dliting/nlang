/* ------------------------------------------------------------------
 * form.n — the request-body form parser and the multipart builder
 * (module web.form; spec docs/dev/web_framework_design.md 6.9, D-17,
 * D-18, D-19, D-20, D-21 and rulings 18/20).
 * FormOptions carries D-18's three limits, each owning its side:
 * maxBytes bounds the body bytes read by either parser, while maxParts
 * and maxPartBytes belong to multipart parts alone — a urlencoded body
 * is never capped by them (leg K). FormData stores names in
 * first-appearance order across both channels: every field value of a
 * name in arrival order, and its file parts — FormFile objects whose
 * data is a view onto the body bytes (D-18) — in arrival order too;
 * names(), getAll(), getFiles() and files() hand out copies so a
 * caller editing them cannot corrupt the form. Form.parse runs the
 * five steps ruling 18 pins in a fixed order: an empty request body
 * answers an empty form before the content type is consulted (i), the
 * content type gate answers its named 415 without reading a body byte
 * (the http layer drains the unread body and the connection stays
 * reusable), a multipart content type also yields its boundary
 * parameter — a repeated one and a missing or empty one are their own
 * named 400s — maxBytes
 * guards the read with the named 413, and the urlencoded split or the
 * multipart walk runs last, the walk enforcing the maxParts and
 * maxPartBytes budgets with their own named 413s as ruling 30 i pins
 * (the count check before a part's headers, the body check right after
 * the scan). On the multipart side the delimiter
 * matching is anchored to line starts and tolerates the shapes D-19
 * lists (preamble and epilogue ignored, trailing horizontal whitespace
 * on delimiter lines, quoted boundaries, all-LF and all-CR bodies,
 * obs-fold continuation lines, case-sensitive boundary compare),
 * nested multipart stays opaque and binary part bytes stay bytes, a
 * missing part Content-Type registers the bare "text/plain", and the
 * client's directory path is stripped off the filename on both
 * separators with nothing else touched (D-20). A body with no
 * delimiter line at all, a body that never closes with a delimiter
 * line, and the malformed parts D-19 lists — a missing or non-form-data
 * content-disposition, a missing or empty name parameter, a name past
 * its byte budget, a header block past its byte budget — each answer
 * their own named 400, judged in the fixed order ruling 30 pins. The
 * media type trio
 * is a private static scanner of Form rather than free functions
 * (ruling 20 keeps this module surface-class-only): it honours
 * quoted-string parameters because a multipart boundary may legally
 * contain ';' inside its quotes (D-17), and both arms read parameters
 * through mediaTypeParam.
 * The same module carries the construction side of spec 6.9 (D-21):
 * MultipartBody assembles a multipart request body byte-exactly, with the
 * boundary discipline of ruling 37, the preconditions and the escape
 * subset of ruling 38, and the add-time data copy of ruling 39, while
 * FormFile's save-to-disk face (ruling 29 ii) pins the cleaning order of
 * ruling 33 i with a random suffix spliced before the extension.
 * ------------------------------------------------------------------ */
import io;
import http;
import url;
import web;
import fs;
import math;

// The three limits spec 6.9 gives a fresh options object (D-18). The
// defaults are assigned in the constructor body because a field
// initializer only takes literals (ruling 11); the computed 8 MiB and
// 4 MiB spellings live in the private static consts instead.
class FormOptions {
    private static const long DEFAULT_MAX_FORM_BYTES = 8 * 1024 * 1024;
    private static const int DEFAULT_MAX_FORM_PARTS = 1000;
    private static const int DEFAULT_MAX_FORM_PART_BYTES = 4 * 1024 * 1024;

    public long maxBytes;
    public int maxParts;
    public int maxPartBytes;

    public FormOptions() {
        maxBytes = DEFAULT_MAX_FORM_BYTES;
        maxParts = DEFAULT_MAX_FORM_PARTS;
        maxPartBytes = DEFAULT_MAX_FORM_PART_BYTES;
    }
}

// One file part of a parsed multipart form (spec 6.9): the name the
// part arrived under, its filename with the client's directory path
// stripped and otherwise verbatim — an empty string is a real answer
// (D-19, D-20), the part's registered Content-Type (the bare
// "text/plain" when the part spelled none, D-19), and data, a view
// onto the body bytes rather than a copy (D-18). The class is not
// const because it holds a byte[] field (spec 3.1) and declares no
// constructor: the parser assigns all four fields before handing the
// object to FormData.addFile, and a hand-built instance rides the same
// loader. The save-to-disk face (ruling 29 ii): safeName() answers the
// cleaned name, saveTo() writes the bytes into an existing directory
// under that name plus a random suffix spliced before the extension,
// and saveAs() writes an exact path verbatim.
class FormFile {
    private static const int DEFAULT_MAX_NAME_BYTES = 120;
    private static const int DEFAULT_SUFFIX_BYTES = 4;
    // The kept whitespace band: TAB through CR stay through the control
    // filter (the next step folds them like spaces), DEL joins the drops.
    private static const int CTRL_KEEP_MIN = 9;
    private static const int CTRL_KEEP_MAX = 13;
    private static const int OCTET_DEL = 127;
    private static const int OCTET_SPACE = 32;
    private static const int OCTET_DOT = 46;
    private static const int OCTET_SLASH = 47;
    private static const int OCTET_BACKSLASH = 92;
    // A UTF-8 continuation byte is 0x80..0xBF: a truncation cut may only
    // land on a lead byte (0xC0 and above) or an ASCII byte.
    private static const int UTF8_CONTINUATION_MIN = 0x80;
    private static const int UTF8_LEAD_MIN = 0xC0;

    public string field;
    public string filename;
    public string contentType;
    public byte[] data;

    public int size() { return data.length(); }
    public string text() { return io.fromBytes(data); }

    // Save under the cleaned name plus a fresh 8-hex random suffix spliced
    // in before the extension (ruling 33 ii): two uploads that clean to
    // the same name never collide in one directory. The directory must
    // already exist — saveTo creates nothing, and fs.writeBytes names its
    // failure through an IOException.
    public void saveTo(string dir) {
        fs.writeBytes(fs.join(dir, FormFile.insertBeforeExt(this.safeName(), "-" + hexEncode(math.randomBytes(DEFAULT_SUFFIX_BYTES)))), data);
    }

    // Save to an exact path, verbatim: no cleaning and no suffix — the
    // caller owns the name it chose.
    public void saveAs(string path) { fs.writeBytes(path, data); }

    // The cleaning order of ruling 33 i, six steps whose sequence is
    // itself the pinned behaviour (the corpus row that strips the path
    // before judging the device name depends on it): control bytes out,
    // whitespace runs folded to one space and the ends trimmed, a bare
    // "." or ".." dropped, the client path stripped on both separators,
    // a Windows device name prefixed with "_", and a UTF-8-boundary-safe
    // truncation at DEFAULT_MAX_NAME_BYTES — bytes 0x80 and above are
    // never touched by the filters because a byte-level scan cannot see
    // code points. A name that cleaned away to nothing answers "upload".
    public string safeName() {
        // Step 1: the byte-wise control filter. 0x09..0x0D are whitespace
        // for step 2, not control noise; nothing at or above 0x80 moves.
        List<byte> kept = {};
        byte[] src = io.toBytes(filename);
        for (int i = 0; i < src.length(); i = i + 1) {
            int v = src[i] & 0xFF;
            bool drop = v < CTRL_KEEP_MIN || (v > CTRL_KEEP_MAX && v < OCTET_SPACE)
                || v == OCTET_DEL;
            if (!drop) { kept.add(src[i]); }
        }
        // Step 2: a whitespace run (the kept band plus spaces) writes one
        // space; trim then peels the ends, the only whitespace a folded
        // name can carry there.
        List<byte> folded = {};
        bool inWs = false;
        for (int i = 0; i < kept.length(); i = i + 1) {
            int v = kept[i] & 0xFF;
            if (v == OCTET_SPACE || (v >= CTRL_KEEP_MIN && v <= CTRL_KEEP_MAX)) {
                if (!inWs) {
                    folded.add(OCTET_SPACE as byte);
                    inWs = true;
                }
            } else {
                folded.add(kept[i]);
                inWs = false;
            }
        }
        string s = io.fromBytes(HttpParser.toByteArray(folded));
        s = s.trim();
        // Step 3: a bare dot segment is no usable filename on Windows or
        // POSIX; ".gitignore" is not a dot segment.
        if (s == "." || s == "..") { s = ""; }
        // Step 4: strip the client's directory path (ruling 31: this
        // class carries its own stripper, Form.stripPath is unreachable).
        s = FormFile.tailOf(s);
        // Step 5: a device name keeps its spelling and gains an "_".
        if (FormFile.isReservedName(s)) { s = "_" + s; }
        // Step 6: back the cut off while it would split a UTF-8 sequence,
        // so the saved name never holds half a character.
        byte[] cells = io.toBytes(s);
        if (cells.length() > DEFAULT_MAX_NAME_BYTES) {
            int cut = DEFAULT_MAX_NAME_BYTES;
            while (cut > 0 && (cells[cut] & 0xFF) >= UTF8_CONTINUATION_MIN
                   && (cells[cut] & 0xFF) < UTF8_LEAD_MIN) {
                cut = cut - 1;
            }
            s = s.substring(0, cut);
        }
        // Step 7: the fallback for names that cleaned away to nothing.
        if (s.length() == 0) { return "upload"; }
        return s;
    }

    // The client-path stripper of ruling 31, class-local because
    // Form.stripPath is a Form private. Both separators count; the scan
    // runs over byte indices (charAt would throw inside a UTF-8
    // sequence) and answers after the last hit, so a trailing separator
    // yields the empty name and step 7's fallback.
    private static string tailOf(string s) {
        byte[] cells = io.toBytes(s);
        for (int i = cells.length() - 1; i >= 0; i = i - 1) {
            int v = cells[i] & 0xFF;
            if (v == OCTET_SLASH || v == OCTET_BACKSLASH) { return s.substring(i + 1); }
        }
        return s;
    }

    // The Windows device-name verdict (ruling 33 i): the stem before the
    // last dot (the whole name when it spells none), trailing spaces and
    // dots stripped, case-folded, matched against the fixed table.
    // Windows judges these names regardless of extension and case, so
    // "nul.txt" and "CON.TXT" both hit; an empty stem never matches and
    // stays with step 7.
    private static bool isReservedName(string s) {
        byte[] cells = io.toBytes(s);
        int dot = -1;
        for (int i = 0; i < cells.length(); i = i + 1) {
            if ((cells[i] & 0xFF) == OCTET_DOT) { dot = i; }
        }
        string stem = s;
        if (dot >= 0) { stem = s.substring(0, dot); }
        byte[] stemCells = io.toBytes(stem);
        int end = stemCells.length();
        while (end > 0 && ((stemCells[end - 1] & 0xFF) == OCTET_SPACE
                           || (stemCells[end - 1] & 0xFF) == OCTET_DOT)) {
            end = end - 1;
        }
        string core = stem.substring(0, end);
        core = core.toLower();
        string[] reserved = ["con", "prn", "aux", "nul",
            "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
            "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"];
        for (int i = 0; i < reserved.length(); i = i + 1) {
            if (core == reserved[i]) { return true; }
        }
        return false;
    }

    // The suffix slot of ruling 33 ii: the infix lands before the last
    // dot only when that dot sits past index 0 — a leading dot is a
    // dotfile's own first character, not an extension, so ".gitignore"
    // gets its suffix appended (corpus leg A3); a name with no dot
    // appends too.
    private static string insertBeforeExt(string name, string infix) {
        byte[] cells = io.toBytes(name);
        int dot = 0;
        for (int i = 0; i < cells.length(); i = i + 1) {
            if ((cells[i] & 0xFF) == OCTET_DOT) { dot = i; }
        }
        if (dot > 0) { return name.substring(0, dot) + infix + name.substring(dot); }
        return name + infix;
    }
}

// One parsed form: names in first-appearance order across both
// channels, each name mapped to its field values in arrival order and,
// on the file side, to its file parts in arrival order — same-name
// parts are never coalesced (D-19). names(), getAll(), getFiles() and
// files() return copies, so mutating what the caller received leaves
// the form untouched (leg L, leg H); get() answers "" for an absent
// name instead of throwing (spec 6.9).
class FormData {
    private List<string> m_order;
    private Dict<string, List<string>> m_values;
    private List<FormFile> m_files;

    public FormData() {
        m_order = {};
        m_values = {};
        m_files = {};
    }

    // A copy of the first-appearance name list, never the storage.
    public List<string> names() {
        List<string> copy = {};
        for (int i = 0; i < m_order.length(); i = i + 1) {
            string name = m_order[i];
            copy.add(name);
        }
        return copy;
    }

    public bool has(string name) {
        return m_order.indexOf(name) >= 0;
    }

    public string get(string name) {
        List<string> vs = this.valuesOf(name);
        if (vs.length() == 0) {
            return "";
        }
        string first = vs[0];
        return first;
    }

    // A copy of one name's values in arrival order.
    public List<string> getAll(string name) {
        List<string> copy = {};
        List<string> vs = this.valuesOf(name);
        for (int i = 0; i < vs.length(); i = i + 1) {
            string value = vs[i];
            copy.add(value);
        }
        return copy;
    }

    // The first file part registered under one name in appearance
    // order, or null when the name carries no files (spec 6.9).
    public FormFile getFile(string name) {
        for (int i = 0; i < m_files.length(); i = i + 1) {
            FormFile f = m_files[i];
            if (f.field == name) {
                return f;
            }
        }
        return null;
    }

    // A copy of one name's file parts in arrival order.
    public List<FormFile> getFiles(string name) {
        List<FormFile> copy = {};
        for (int i = 0; i < m_files.length(); i = i + 1) {
            FormFile f = m_files[i];
            if (f.field == name) {
                copy.add(f);
            }
        }
        return copy;
    }

    // A copy of every file part in global appearance order.
    public List<FormFile> files() {
        List<FormFile> copy = {};
        for (int i = 0; i < m_files.length(); i = i + 1) {
            FormFile f = m_files[i];
            copy.add(f);
        }
        return copy;
    }

    // The field-channel sum: a name that only registered file parts
    // owns an empty value list and contributes nothing here (leg H's
    // fc/filec pair).
    public int fieldCount() {
        int total = 0;
        for (int i = 0; i < m_order.length(); i = i + 1) {
            string key = m_order[i];
            // Dict.get throws on a miss (ruling 14); the guard also
            // keeps this sum safe if a future loader ever lags a name.
            if (m_values.containsKey(key)) {
                List<string> vs = m_values.get(key);
                total = total + vs.length();
            }
        }
        return total;
    }

    // The file-channel count: every file part counts once, even when
    // several share a name (spec 6.9).
    public int fileCount() {
        return m_files.length();
    }

    // The two channels' sum: names() dedupes while the counts do not,
    // so a name carrying both fields and files enters names() once and
    // contributes one unit per value and per file part (spec 6.9).
    public int partCount() {
        return this.fieldCount() + this.fileCount();
    }

    // The value list behind one name: the storage itself (every caller
    // copies it out), and an empty list for an unknown name so get()
    // and getAll() share one path.
    private List<string> valuesOf(string name) {
        if (!m_values.containsKey(name)) {
            return {};
        }
        return m_values.get(name);
    }

    // The loader of the field channel (D-18): the name registers on
    // its first appearance, values append in arrival order. The guard
    // reads m_order so addFile shares this one registration path: a
    // name first seen on a file part enters names() through the same
    // move, and its m_values entry stays an empty list that
    // fieldCount() never sums (D-19). Public because Form is a
    // different class (cross-class privates do not reach, ruling 14)
    // and assembling a FormData by hand is a legitimate caller move
    // too; the cost is one public method beyond spec 6.9, recorded for
    // the Task 17 manual pass.
    public void addField(string name, string value) {
        if (m_order.indexOf(name) < 0) {
            m_order.add(name);
            m_values.set(name, {});
        }
        List<string> vs = m_values.get(name);
        vs.add(value);
    }

    // The loader of the file channel: the name registers through the
    // same path as addField, then the part appends to m_files in
    // arrival order so getFile(), getFiles() and files() see every part
    // in appearance order. Public for the same reasons as addField.
    public void addFile(FormFile f) {
        string name = f.field;
        if (m_order.indexOf(name) < 0) {
            m_order.add(name);
            m_values.set(name, {});
        }
        m_files.add(f);
    }
}

// The parse entry point of spec 6.9: the one-argument shape rides the
// default options, the two-argument shape treats a null opts the same.
class Form {
    // D-19's two grammar budgets (ruling 30 ii): a part's header block
    // never runs past DEFAULT_MAX_PART_HEADER_BYTES bytes, and a
    // disposition name parameter never past DEFAULT_MAX_FIELD_NAME_BYTES
    // bytes. Both overruns are named 400s whose texts compose their
    // number from the constant, so each limit is written exactly once in
    // this module.
    private static const int DEFAULT_MAX_PART_HEADER_BYTES = 16384;
    private static const int DEFAULT_MAX_FIELD_NAME_BYTES = 100;

    // The octets the media type scanner compares (byte domain).
    private static const int OCTET_TAB = 9;
    private static const int OCTET_SEMICOLON = 59;
    private static const int OCTET_EQUALS = 61;
    private static const int OCTET_SPACE = 32;
    private static const int OCTET_QUOTE = 34;

    public static FormData parse(RequestContext ctx) {
        return Form.parse(ctx, FormOptions());
    }

    public static FormData parse(RequestContext ctx, FormOptions opts) {
        // Step 1: a null opts rides the defaults (spec 6.9).
        if (opts == null) {
            opts = FormOptions();
        }

        // Step 2 (ruling 18 i): an empty request body answers an empty
        // form before the content type is consulted, without reading a
        // single byte. The framing facts come from the http layer's own
        // parse (stdlib/http.n framingOf): MODE_NONE covers GET and any
        // bodyless request, MODE_LENGTH ∧ framingLength == 0 is the
        // hand-written Content-Length: 0 arm the client never spells by
        // itself for an empty body.
        if (ctx.req.framingMode == HttpParser.MODE_NONE
            || (ctx.req.framingMode == HttpParser.MODE_LENGTH
                && ctx.req.framingLength == 0)) {
            return FormData();
        }

        // Step 3: the content type gate. The first flat-table cell is
        // bound to a local before it is compared (ruling 12). The 415
        // stays the else arm of the dispatch rather than an early
        // return so the verdict lands before a single body byte is
        // read (the http layer drains the unread body and the
        // connection stays reusable). A multipart header also carries
        // the boundary parameter, taken here before the body is
        // touched: a header spelling the boundary parameter more than
        // once is a named 400, judged before the missing-or-empty
        // verdict (D-19, ruling 30 i: leg B4 pins that a second empty
        // value still answers multiple-boundary, and leg H4 the count
        // check before any body byte is read).
        string header = ctx.req.headers.get("Content-Type");
        List<string> mt = Form.readMediaType(header);
        string type = mt[0];
        bool isUrl = type.equalsIgnoreCase("application/x-www-form-urlencoded");
        bool isMultipart = type.equalsIgnoreCase("multipart/form-data");
        if (!isUrl && !isMultipart) {
            throw http.HttpException(
                "web.form.Form.parse: unsupported content type for form parsing.", 415);
        }
        string boundary = "";
        if (isMultipart) {
            int bndCount = 0;
            boundary = Form.mediaTypeParam(header, "boundary", bndCount);
            if (bndCount > 1) {
                throw http.HttpException(
                    "web.form.Form.parse: multiple boundary parameters in content type.", 400);
            }
            if (bndCount == 0 || boundary.length() == 0) {
                throw http.HttpException(
                    "web.form.Form.parse: missing boundary parameter.", 400);
            }
        }

        // Step 4: the read, then the web-layer cap (the http layer's
        // own body cap sits far above at 16 MiB, stdlib/http.n),
        // shared by both arms.
        byte[] raw = ctx.req.bodyReader.readAll();
        if (raw.length() > opts.maxBytes) {
            throw http.HttpException(
                "web.form.Form.parse: form body exceeds maxBytes (" + opts.maxBytes + " bytes).", 413);
        }

        // Step 5: the arm dispatch. The urlencoded side keeps the raw
        // '&' split with the first '=' as the name/value border: an
        // empty segment carries no field, a segment without '=' is a
        // bare name with an empty value (D-17).
        if (isUrl) {
            string text = io.fromBytes(raw);
            List<string> pairs = text.split("&");
            FormData fd = FormData();
            for (int i = 0; i < pairs.length(); i = i + 1) {
                string pair = pairs[i];
                if (pair.length() == 0) {
                    continue;
                }
                string name = pair;
                string value = "";
                int eq = pair.indexOf("=");
                if (eq >= 0) {
                    name = pair.substring(0, eq);
                    value = pair.substring(eq + 1);
                }
                string decodedName = Form.decodeField(name);
                string decodedValue = Form.decodeField(value);
                fd.addField(decodedName, decodedValue);
            }
            return fd;
        }
        return Form.parseMultipart(raw, boundary, opts);
    }

    // '+' to space and %XX with the decoded bytes taken as UTF-8 —
    // url.formDecode's own contract. A truncated or non-hexadecimal
    // escape raises url.UrlException, whose message echoes the
    // offending client text; ruling 18 ii wants the 400 body to quote
    // no request byte, so the message is replaced wholesale here.
    private static string decodeField(string s) {
        try {
            return url.formDecode(s);
        } catch (url.UrlException e) {
            throw http.HttpException("web: malformed percent escape in form body", 400);
        }
    }

    // The multipart arm (D-19): the body is walked as bytes with the
    // delimiter anchored to line starts, preamble and epilogue fall out
    // of that scan for free, and every part between two delimiter lines
    // registers through the shared FormData loaders. The opts budgets
    // gate the walk: maxParts is checked before each part's headers are
    // scanned, maxPartBytes right after the scan (ruling 30 i), so the
    // count verdict outranks every part-level verdict. A
    // body whose first delimiter line already closes the form is the
    // empty form (leg I); a scan that runs out of delimiter candidates
    // before a closing line is the named 400 (D-19, ruling 30 i: the
    // early-return arm in front of the loop keeps the closing-only body
    // the empty form, while the loop's missing-closing verdict judges
    // every other part first). The byte
    // values compared inside the scanners (13, 10, 45 …) are protocol
    // constants inlined in the stdlib/http.n style, and every byte
    // read goes through & 0xFF because HttpParser.byteAt is a private
    // static of another class (ruling 14).
    private static FormData parseMultipart(byte[] raw, string boundary, FormOptions opts) {
        byte[] bnd = io.toBytes(boundary);
        bool firstClosing = false;
        int start = Form.findDelimiter(raw, 0, bnd, firstClosing);
        if (start < 0) {
            throw http.HttpException(
                "web.form.Form.parse: no boundary delimiter in multipart body.", 400);
        }
        int lineEnd = Form.matchDelimiter(raw, start, bnd, firstClosing);
        if (firstClosing) {
            return FormData();
        }
        FormData fd = FormData();
        while (true) {
            bool closing = false;
            int next = Form.findDelimiter(raw, lineEnd, bnd, closing);
            if (next < 0) {
                throw http.HttpException(
                    "web.form.Form.parse: missing closing boundary delimiter.", 400);
            }
            int nextEnd = Form.matchDelimiter(raw, next, bnd, closing);
            // The break before the delimiter line belongs to the
            // delimiter line, not to the span above it (D-19: leg A's
            // value carries no \r\n), and floor stops a zero-length
            // body from eating the previous part's bytes (legs C, F).
            int spanEnd = Form.trimPrecedingBreak(raw, next, lineEnd);
            // The count budget judges the next part before its headers
            // are even scanned (ruling 30 i): a part over the cap
            // answers the named 413 even when its own headers would
            // also fail a 400. The compare is >= because partCount is
            // what has registered so far — a cap of n allows exactly n
            // parts, and the closing-only body never reaches here.
            if (fd.partCount() >= opts.maxParts) {
                throw http.HttpException(
                    "web.form.Form.parse: form exceeds maxParts (" + opts.maxParts + " parts).", 413);
            }
            http.HttpHeaders hd = http.HttpHeaders();
            int bodyStart = lineEnd;
            Form.scanPartHeaders(raw, lineEnd, spanEnd, hd, bodyStart);
            if (bodyStart > spanEnd) {
                bodyStart = spanEnd;
            }
            // The single-part body budget (ruling 30 i): the clamp
            // above pins the span, so the subtraction cannot go
            // negative; the header block is not counted here — it
            // belongs to scanPartHeaders' grammar budget — and a body
            // of exactly maxPartBytes bytes still parses (the compare
            // is >).
            if (spanEnd - bodyStart > opts.maxPartBytes) {
                throw http.HttpException(
                    "web.form.Form.parse: part exceeds maxPartBytes (" + opts.maxPartBytes + " bytes).", 413);
            }
            byte[] body = raw[bodyStart:spanEnd];
            // Part registration: a part without a form-data content-
            // disposition, without a name parameter or with a name past
            // the byte budget raises its own named 400 here, before
            // anything registers — one violation rejects the whole form
            // (D-19; ruling 30 i: the header budget already ran inside
            // scanPartHeaders, and the closing-line verdict only judges
            // the part after this one). readMediaType lowercases the
            // disposition type so the form-data check is
            // case-insensitive, while the name parameter keeps the
            // client's spelling (leg D).
            string cd = hd.get("content-disposition");
            List<string> cdt = Form.readMediaType(cd);
            if (cd.length() == 0 || cdt.length() == 0 || cdt[0] != "form-data") {
                throw http.HttpException(
                    "web.form.Form.parse: part missing form-data content-disposition.", 400);
            }
            int nameCount = 0;
            string name = Form.mediaTypeParam(cd, "name", nameCount);
            if (name.length() == 0) {
                // A missing parameter and an empty value share this arm:
                // mediaTypeParam answers "" when it finds no value.
                throw http.HttpException(
                    "web.form.Form.parse: part content-disposition has no name parameter.", 400);
            }
            if (name.length() > DEFAULT_MAX_FIELD_NAME_BYTES) {
                // string.length() is the byte count (temp/pf19.n), so
                // the budget measures bytes, not characters (leg G).
                throw http.HttpException("web.form.Form.parse: field name exceeds "
                    + DEFAULT_MAX_FIELD_NAME_BYTES.toString() + " bytes.", 400);
            }
            int fnCount = 0;
            string filename = Form.mediaTypeParam(cd, "filename", fnCount);
            if (fnCount > 0) {
                // A filename parameter that exists is a file part even
                // with an empty value (D-19: the channel split rides the
                // parameter's existence, not its content); the data
                // field keeps the view slice, never a string roundtrip.
                FormFile f = FormFile();
                f.field = name;
                f.filename = Form.stripPath(filename);
                string ct = hd.get("content-type");
                if (ct.length() == 0) {
                    ct = "text/plain";
                }
                f.contentType = ct;
                f.data = body;
                fd.addFile(f);
            } else {
                // The field channel decodes the body as UTF-8 and does
                // nothing else — percent escapes stay as written, unlike
                // the urlencoded arm (D-19).
                fd.addField(name, io.fromBytes(body));
            }
            if (closing) {
                break;
            }
            // Without this advance the scan would match the very same
            // delimiter line forever.
            lineEnd = nextEnd;
        }
        return fd;
    }

    // Whether p opens a delimiter line, answered with the index after
    // that line or -1. The two dashes and, for the closing shape, the
    // trailing "--" must hug the boundary — Go's match likewise, so
    // "--Bx --" stays body text while "--Bx-- " matches — and after
    // optional horizontal whitespace only CR, LF, CRLF or the body end
    // may follow, which is what drops the lookalikes "--Bx-" and
    // "--BxY" back into the body (D-19, leg E6). The boundary bytes
    // compare case-sensitively: only the media type name and parameter
    // names fold case, never a parameter value (leg K3). closing
    // reports the "--boundary--" spelling.
    private static int matchDelimiter(byte[] raw, int p, byte[] bnd, bool& closing) {
        closing = false;
        int n = raw.length();
        if (p + 2 + bnd.length() > n) {
            return -1;
        }
        if ((raw[p] & 0xFF) != 45 || (raw[p + 1] & 0xFF) != 45) {
            return -1;
        }
        for (int i = 0; i < bnd.length(); i = i + 1) {
            if ((raw[p + 2 + i] & 0xFF) != (bnd[i] & 0xFF)) {
                return -1;
            }
        }
        int j = p + 2 + bnd.length();
        if (j + 1 < n && (raw[j] & 0xFF) == 45 && (raw[j + 1] & 0xFF) == 45) {
            closing = true;
            j = j + 2;
        }
        while (j < n && ((raw[j] & 0xFF) == 32 || (raw[j] & 0xFF) == 9)) {
            j = j + 1;
        }
        if (j >= n) {
            return j;
        }
        int v = raw[j] & 0xFF;
        if (v == 13) {
            if (j + 1 < n && (raw[j + 1] & 0xFF) == 10) {
                return j + 2;
            }
            return j + 1;
        }
        if (v == 10) {
            return j + 1;
        }
        return -1;
    }

    // The next delimiter line at or after from, reported by its line
    // start; closing is the successful match's answer. A candidate is
    // any line start: index 0 (only reachable when from == 0) or any
    // position whose previous byte is CR or LF. The preamble is
    // therefore ignored without special casing (D-19), and neither an
    // indented delimiter line nor a boundary string mid-line ever
    // matches (legs K2, E9). The match's answer travels through a
    // local because a reference formal cannot be handed straight to
    // another reference formal (this toolchain rejects the binding).
    private static int findDelimiter(byte[] raw, int from, byte[] bnd, bool& closing) {
        closing = false;
        int n = raw.length();
        for (int i = from; i < n; i = i + 1) {
            bool lineStart = (i == 0) || ((raw[i - 1] & 0xFF) == 13)
                || ((raw[i - 1] & 0xFF) == 10);
            if (!lineStart) {
                continue;
            }
            bool hitClosing = false;
            int lineEnd = Form.matchDelimiter(raw, i, bnd, hitClosing);
            if (lineEnd >= 0) {
                closing = hitClosing;
                return i;
            }
        }
        return -1;
    }

    // The header block of one part, scanned from up to the span's end:
    // a blank (zero-length) line ends the block and bodyStart opens the
    // body right after that line, while a block that reaches spanEnd
    // with no blank line leaves bodyStart == spanEnd — the header eats
    // the whole span and the body is empty, never the next part's
    // bytes. Line breaks tolerate all three shapes (D-19). A line
    // starting with a space or tab is an obs-fold continuation: its
    // leading horizontal whitespace is stripped and it joins the
    // previous logical header's value with one space (RFC 7230 3.2.4,
    // D-19, leg E5). Every other line splits on its first colon — a
    // line without one is ignored (ruling 29 iii, leg D) — with the
    // name and the value each losing their surrounding horizontal
    // whitespace (RFC 7230 OWS); the header table's own lowercased
    // keys take care of the name's case (D-19) and a repeated name
    // overwrites (HttpHeaders.set). D-19's header budget lives in this
    // method alone: the block runs from the from index, past the
    // first delimiter line and its own break (neither is counted), and
    // every line — the obs-fold continuations and the terminating
    // blank line included —
    // adds its content bytes and its line break to the running total
    // before the blank-line exit can fire, so a block cannot escape the
    // budget through its closing line (ruling 30 ii; leg F2 is that
    // order's witness).
    private static void scanPartHeaders(byte[] raw, int from, int spanEnd,
                                        http.HttpHeaders hd, int& bodyStart) {
        string prev = "";
        int consumed = 0;
        int i = from;
        while (i < spanEnd) {
            int e = i;
            while (e < spanEnd && (raw[e] & 0xFF) != 13 && (raw[e] & 0xFF) != 10) {
                e = e + 1;
            }
            int after = e;
            if (e < spanEnd) {
                after = e + 1;
                if ((raw[e] & 0xFF) == 13 && e + 1 < spanEnd
                    && (raw[e + 1] & 0xFF) == 10) {
                    after = e + 2;
                }
            }
            consumed = consumed + (e - i) + (after - e);
            if (consumed > DEFAULT_MAX_PART_HEADER_BYTES) {
                throw http.HttpException("web.form.Form.parse: part headers exceed "
                    + DEFAULT_MAX_PART_HEADER_BYTES.toString() + " bytes.", 400);
            }
            if (e == i) {
                bodyStart = after;
                return;
            }
            if ((raw[i] & 0xFF) == 32 || (raw[i] & 0xFF) == 9) {
                // obs-fold: nothing to fold into before the first
                // logical header line, so such a stray is dropped.
                if (prev.length() > 0) {
                    int t = i;
                    while (t < e && ((raw[t] & 0xFF) == 32 || (raw[t] & 0xFF) == 9)) {
                        t = t + 1;
                    }
                    string tail = io.fromBytes(raw[t:e]);
                    string joined = hd.get(prev) + " " + tail;
                    hd.set(prev, joined);
                }
                i = after;
                continue;
            }
            int colon = -1;
            for (int k = i; k < e; k = k + 1) {
                if ((raw[k] & 0xFF) == 58) {
                    colon = k;
                    break;
                }
            }
            if (colon >= 0) {
                string name = io.fromBytes(raw[i:colon]);
                name = name.trim();
                string value = io.fromBytes(raw[colon + 1:e]);
                value = value.trim();
                hd.set(name, value);
                prev = name;
            }
            i = after;
        }
        bodyStart = spanEnd;
    }

    // Backs one line-break shape off the delimiter line at p so the
    // break the delimiter line owns is not counted as the end of the
    // span above it (D-19: the CRLF before a delimiter line belongs to
    // the delimiter line). floor is the span's start: a zero-length
    // body starts at the span's end and has nothing to give back.
    private static int trimPrecedingBreak(byte[] raw, int p, int floor) {
        int q = p;
        if (q > floor && (raw[q - 1] & 0xFF) == 10) {
            q = q - 1;
            if (q > floor && (raw[q - 1] & 0xFF) == 13) {
                q = q - 1;
            }
        } else if (q > floor && (raw[q - 1] & 0xFF) == 13) {
            q = q - 1;
        }
        return q;
    }

    // The filename parameter's last path segment: browsers send a full
    // path and both separators count (D-20 quotes the browser's
    // "C:\fakepath\x.png"), while everything else stays untouched — no
    // percent decoding, no dot-segment handling, duties of
    // FormFile.safeName() (Task 14, and that method carries its own
    // tailOf because cross-class privates do not reach, ruling 31).
    // The walk runs over bytes because charAt throws when an index
    // lands inside a UTF-8 sequence, which a backwards charAt scan
    // would hit on a non-ASCII filename such as "报告.txt" (probes
    // pf19, pf22); substring takes byte indexes and both separators
    // are ASCII, so the cut always lands on a character boundary.
    private static string stripPath(string name) {
        byte[] b = io.toBytes(name);
        for (int i = b.length() - 1; i >= 0; i = i - 1) {
            int v = b[i] & 0xFF;
            if (v == 47 || v == 92) {
                return name.substring(i + 1);
            }
        }
        return name;
    }

    // The flat media type table of D-17: [type, name1, value1, name2,
    // value2, …], parameters in order and repeated names left unmerged
    // so a caller can count how often one appeared. A quoted-string
    // value keeps its ';' and blanks verbatim — the spelling
    // boundary="…;…" needs. The walk runs over bytes: the token domain
    // is ASCII and a stray non-ASCII octet must not cut a multi-byte
    // character mid-scan. A missing Content-Type arrives here as ""
    // (the http header table's answer for an absent name), which
    // simply yields the one empty type cell. The table stops at the
    // first spelling the grammar cannot complete — a trailing ';', a
    // parameter without '=', junk after a closing quote, an
    // unterminated quote — because a malformed header is the client's
    // syntax error and this scanner refuses nothing: the 415/400
    // verdicts fall out of the dispatch anyway.
    private static List<string> readMediaType(string header) {
        List<string> cells = {};
        byte[] src = io.toBytes(header);
        int n = src.length();

        // The type segment runs up to the first ';' (or to the end),
        // then loses its surrounding blanks and folds case (media type
        // names are ASCII, and toLower() is an ASCII-only builtin).
        int typeEnd = n;
        for (int k = 0; k < n; k = k + 1) {
            if ((src[k] & 0xFF) == OCTET_SEMICOLON) {
                typeEnd = k;
                break;
            }
        }
        string type = io.fromBytes(src[0:typeEnd]);
        type = type.trim();
        type = type.toLower();
        cells.add(type);

        // Parameter segments: ';' OWS name '=' OWS value OWS, value
        // quoted or bare. D-19 (RFC 2046 §5.1) strips the horizontal
        // whitespace padding a value on both sides: here before the
        // quoted-versus-bare decision, and after a closing quote
        // before the ';' requirement (the bare arm's trim() already
        // covers its trailing side).
        int i = typeEnd;
        while (i < n) {
            i = i + 1;
            while (i < n && ((src[i] & 0xFF) == OCTET_SPACE
                             || (src[i] & 0xFF) == OCTET_TAB)) {
                i = i + 1;
            }
            if (i >= n) {
                break;
            }
            int nameStart = i;
            while (i < n && (src[i] & 0xFF) != OCTET_EQUALS
                   && (src[i] & 0xFF) != OCTET_SEMICOLON) {
                i = i + 1;
            }
            if (i >= n || (src[i] & 0xFF) != OCTET_EQUALS) {
                break;
            }
            string pname = io.fromBytes(src[nameStart:i]);
            pname = pname.trim();
            pname = pname.toLower();
            i = i + 1;
            while (i < n && ((src[i] & 0xFF) == OCTET_SPACE
                             || (src[i] & 0xFF) == OCTET_TAB)) {
                i = i + 1;
            }
            string pvalue = "";
            if (i < n && (src[i] & 0xFF) == OCTET_QUOTE) {
                i = i + 1;
                int quotedStart = i;
                bool closed = false;
                while (i < n) {
                    if ((src[i] & 0xFF) == OCTET_QUOTE) {
                        closed = true;
                        break;
                    }
                    i = i + 1;
                }
                if (!closed) {
                    break;
                }
                pvalue = io.fromBytes(src[quotedStart:i]);
                i = i + 1;
                while (i < n && ((src[i] & 0xFF) == OCTET_SPACE
                                 || (src[i] & 0xFF) == OCTET_TAB)) {
                    i = i + 1;
                }
                if (i < n && (src[i] & 0xFF) != OCTET_SEMICOLON) {
                    break;
                }
            } else {
                int bareStart = i;
                while (i < n && (src[i] & 0xFF) != OCTET_SEMICOLON) {
                    i = i + 1;
                }
                pvalue = io.fromBytes(src[bareStart:i]);
                pvalue = pvalue.trim();
            }
            cells.add(pname);
            cells.add(pvalue);
        }
        return cells;
    }

    // The lowercased type name of a header: cell 0 of the flat table.
    private static string mediaTypeOf(string header) {
        List<string> cells = Form.readMediaType(header);
        string type = cells[0];
        return type;
    }

    // The first value of one parameter plus how often that parameter
    // appeared: the multipart arm reads its boundary through it and
    // rejects a repeated, missing or empty parameter through the count,
    // the repeated verdict first (D-17, D-19, ruling 30 i). count is a
    // reference formal (the out marker is retired on this toolchain), so callers
    // bind a declared local: Form.mediaTypeParam(h, "boundary", cnt).
    // The name compare is case-sensitive and readMediaType lowercases
    // the stored parameter names, so callers pass lowercase spellings.
    private static string mediaTypeParam(string header, string name, int& count) {
        List<string> cells = Form.readMediaType(header);
        string first = "";
        count = 0;
        for (int i = 1; i + 1 < cells.length(); i = i + 2) {
            string pname = cells[i];
            string pvalue = cells[i + 1];
            if (pname == name) {
                count = count + 1;
                if (count == 1) {
                    first = pvalue;
                }
            }
        }
        return first;
    }
}

// The multipart message under construction (spec 6.9, D-21): addField and
// addFile register parts, contentType() answers the request's content
// type and toBytes() assembles the wire bytes — the body opens on
// "--boundary" with no leading break, every later part and the closing
// line carry their own break before the delimiter, one blank line follows
// every header block, and a zero-part body is the closing line alone (the
// shape Go's multipart writer emits and Task 11's parser accepts). The
// storage representation is boundary-independent header blocks rather
// than one assembled blob: a boundary re-roll only rewrites delimiter
// lines and can never leave an already-built header block naming the old
// boundary (ruling 37), and contentType() and toBytes() answer from one
// m_bnd field. The boundary is 40 lower-case hex characters from
// math.randomBytes — D-21's hex-only subset dodges the punctuation Blink
// strips in form upload tests. resolveBoundary() re-rolls while some part
// body carries "--boundary" at a line start (RFC 2046), scanning bodies
// only: no header block can hit a 40-hex delimiter at a line start once
// escapeParam has run (ruling 37). escapeParam covers exactly the two
// quoted parameter values — quote, CR and LF percent-escaped, nothing
// else, because D-21 forbids any other escapes — while the Content-Type
// value rides unescaped and CR/LF inside it is rejected outright (a
// newline there would invent a header line). addFile copies its data at
// registration so the caller may reuse the buffer for the next message
// (ruling 39); addField needs no copy because io.toBytes already
// allocates. All three precondition verdicts are judged before anything
// registers, the empty-field one first (ruling 38), so a rejected add
// leaves no half part behind.
class MultipartBody {
    private static const string MP_PREFIX = "multipart/form-data; boundary=";
    private static const int DEFAULT_BOUNDARY_BYTES = 20;
    private static const int DEFAULT_BOUNDARY_TRIES = 8;
    private List<string> m_heads;              // per-part header block (boundary-independent, blank line included)
    private List<byte[]> m_bodies;
    private string m_bnd;                      // the current boundary candidate

    public MultipartBody() {
        m_heads = {};
        m_bodies = {};
        m_bnd = hexEncode(math.randomBytes(DEFAULT_BOUNDARY_BYTES));
    }

    // The content type a request carrying toBytes() must send; both this
    // and toBytes() resolve the same boundary field, so they can never
    // disagree.
    public string contentType() { return MP_PREFIX + this.resolveBoundary(); }

    // Register a field part: no Content-Type and no filename parameter
    // (the HTML encoding omits both for non-file fields, D-21).
    public void addField(string name, string value) {
        if (name.length() == 0) {
            throw Exception("web.form.MultipartBody.addField: name must not be empty.");
        }
        m_heads.add("Content-Disposition: form-data; name=\"" + MultipartBody.escapeParam(name) + "\"\r\n\r\n");
        m_bodies.add(io.toBytes(value));
    }

    // Register a file part. The verdict order is ruling 38's: the empty
    // field first, then a Content-Type carrying CR or LF (it is not
    // escaped, only rejected); an empty Content-Type fills the
    // application/octet-stream default (RFC 7578 §4.4) and an explicit
    // empty filename is sent as filename="" (ruling 38 iii). The data
    // array is copied here and nowhere else (ruling 39).
    public void addFile(string field, string filename, string contentType, byte[] data) {
        if (field.length() == 0) {
            throw Exception("web.form.MultipartBody.addFile: field must not be empty.");
        }
        if (contentType.contains("\r") || contentType.contains("\n")) {
            throw Exception("web.form.MultipartBody.addFile: contentType must not contain CR or LF.");
        }
        string mime = contentType;
        if (mime.length() == 0) { mime = "application/octet-stream"; }
        m_heads.add("Content-Disposition: form-data; name=\"" + MultipartBody.escapeParam(field) + "\"; filename=\"" + MultipartBody.escapeParam(filename) + "\"\r\nContent-Type: " + mime + "\r\n\r\n");
        m_bodies.add(MultipartBody.copyBytes(data));
    }

    // Assemble the message. The per-cell copy into List<byte> is the
    // language's only growable byte sequence at work (stdlib/http.n
    // 321-322); there is no appendBytes to borrow.
    public byte[] toBytes() {
        string bnd = this.resolveBoundary();
        List<byte> acc = {};
        for (int i = 0; i < m_heads.length(); i = i + 1) {
            if (i > 0) { HttpParser.appendAscii(acc, "\r\n"); }
            HttpParser.appendAscii(acc, "--" + bnd + "\r\n");
            HttpParser.appendAscii(acc, m_heads[i]);
            byte[] body = m_bodies[i];
            for (int j = 0; j < body.length(); j = j + 1) { acc.add(body[j]); }
        }
        if (m_heads.length() == 0) {
            HttpParser.appendAscii(acc, "--" + bnd + "--\r\n");
        } else {
            HttpParser.appendAscii(acc, "\r\n--" + bnd + "--\r\n");
        }
        return HttpParser.toByteArray(acc);
    }

    // The D-21 escape subset for the two quoted parameter values. The
    // three replacement texts hold no quote, CR or LF, so the full
    // non-overlapping replaces commute in any order; everything else —
    // backslash and percent included — stays verbatim.
    private static string escapeParam(string raw) {
        return raw.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A");
    }

    // Hand out a boundary no part body carries at a line start, re-rolling
    // m_bnd in place so every later call sees the same winner (the write-
    // back is what lets toBytes() re-roll first and contentType() still
    // agree). Exhausting the tries is constructible only by 40-hex
    // coincidence, but it must surface as a named verdict rather than a
    // silent colliding value.
    private string resolveBoundary() {
        for (int t = 0; t < DEFAULT_BOUNDARY_TRIES; t = t + 1) {
            if (!MultipartBody.bodiesContainAtLineStart(m_bodies, m_bnd)) { return m_bnd; }
            m_bnd = hexEncode(math.randomBytes(DEFAULT_BOUNDARY_BYTES));
        }
        throw Exception("web.form.MultipartBody: cannot pick a boundary that the part bodies do not contain at a line start.");
    }

    // RFC 2046's line-start delimiter rule: a body line beginning with
    // "--boundary" would end the message early. A line starts at index 0
    // or right after a CR (13) or an LF (10) — the same pair findDelimiter
    // above accepts, so a part body cannot dodge this precheck by spelling
    // its collision after a bare CR; bodies are compared byte-wise, and
    // header blocks are exempt because their only line starts are the two
    // fixed prefixes, their parameter values escape-clean and the candidate
    // is 40 hex.
    private static bool bodiesContainAtLineStart(List<byte[]> bodies, string bnd) {
        byte[] line = io.toBytes("--" + bnd);
        for (int p = 0; p < bodies.length(); p = p + 1) {
            byte[] body = bodies[p];
            for (int i = 0; i + line.length() <= body.length(); i = i + 1) {
                if (i > 0 && (body[i - 1] & 0xFF) != 13
                    && (body[i - 1] & 0xFF) != 10) { continue; }
                bool hit = true;
                for (int k = 0; k < line.length(); k = k + 1) {
                    if (body[i + k] != line[k]) { hit = false; break; }
                }
                if (hit) { return true; }
            }
        }
        return false;
    }

    // The ruling 39 copy: a registered body must not alias a caller
    // buffer that keeps being written.
    private static byte[] copyBytes(byte[] src) {
        byte[] dst = byte[src.length()];
        for (int i = 0; i < src.length(); i = i + 1) { dst[i] = src[i]; }
        return dst;
    }
}
