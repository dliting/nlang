// Standard library source for the "thread" package — authoritative
// declarations for the virtual-thread primitives and the handle classes
// they mint (Thread, Future, Promise). Native package: the
// implementations are built into the VM itself (not nlang_<ns>.dll), so
// the wire shape is the intrinsic channel, not the host ABI. Needs an
// explicit `import thread;`. spawn's typed form (func<T> delegate →
// Future<T>) is bound by a dedicated compiler arm; the prototype below
// shows the func<void> form.

// Spawns a new virtual thread running the zero-argument delegate and
// returns immediately: func<void> yields a Thread handle, func<T> yields
// a Future<T> whose get() delivers the return value.
native Thread spawn(func<void> f);

// Parks the calling context until the target finishes; a failed target
// rethrows its original exception object into this context.
native void join(Thread t);

// Non-blocking failure probes. isFailed reports whether the target
// finished with an uncaught exception (false while running and after a
// clean finish); it never marks the failure as observed. failure
// returns the failed task's original exception object — the same
// instance join rethrows — or null when the target has not failed, and
// the retrieval counts as observation (no run-end report for it).
native bool isFailed(Thread t);
native Exception failure(Thread t);

// Voluntary yield: the context goes to the back of the run queue.
native void yield();

// The current context's identifier; main is always 0.
native int id();

// Parks until the deadline; sleep(0) equals yield; negative is a
// runtime error.
native void sleep(int ms);

// Handle of a spawned virtual thread: the runtime context id lives in
// the hidden native slot. Instances are minted by thread.spawn — there
// is no user-callable constructor.
class Thread {
}

// Read handle of a spawned or promised computation: promise.future() and
// thread.spawn mint instances (no user-callable constructor). get()
// parks until the outcome is decided and returns the value (or re-raises
// the failure); isDone() peeks without parking.
class Future<T> {
    public native T get();
    public native bool isDone();
}

// Completion source: a user-constructed counterpart of spawn-minted
// futures. complete()/completeExceptionally() decide the outcome exactly
// once (first call wins, later calls return false); future() mints a
// reader handle that can be passed anywhere and awaited with get().
class Promise<T> {
    public native Promise();
    public native Future<T> future();
    public native bool complete(T value);
    public native bool completeExceptionally(Exception reason);
}
