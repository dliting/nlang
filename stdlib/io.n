// Standard library source for the "io" package — authoritative
// declarations, indexed by langservice::SymbolIndex and inlined into every
// build. The package comes from this file's path (the stem "io"), not from
// any in-file wrapper. The native functions are implemented in the host
// (nlang_io.dll); any plain NLang function would compile from this file.
// Edit freely.

// Print a value to stdout followed by a newline and flush.
// The parameter is a string: array and scalar primitive values convert
// implicitly (an array renders as e.g. [1, 2]); a class, interface
// or enum value must call .toString() first, and null is rejected.
native void print(string s);

// Write a value to stdout with NO newline, flush included — print's
// prompt-building counterpart, so a typed reply lands on the same line.
// Same implicit conversion as print.
native void write(string s);

// Print a value to stderr followed by a newline and flush — print's
// diagnostic twin, keeping diagnostics separable from normal output.
// Inside a debug session the two streams merge into the session's
// single output view. Same implicit conversion as print.
native void eprint(string s);

// Probe whether more input is available (never raises): true means the
// next readLine() returns a line (possibly "") rather than the
// end-of-input sentinel. Exact for file/pipe redirection; a console
// reports only already-buffered input; a debug session reports only
// parked (already delivered) lines. A host without an input channel
// answers false once its first read raised IOException (a bare probe
// before any read cannot tell and still answers true).
native bool hasInput();

// Read one line from stdin; trailing '\r' is stripped.
// EOF and an empty input line both return "" — tell them apart with
// hasInput(). After a token read, the REMAINDER of that line comes
// back first (C++ cin>>/getline semantics).
native string readLine();

// Read the next whitespace-delimited token, skipping whitespace across
// lines. Raises IOException when the input ended before a token.
native string readToken();

// Read the next non-whitespace character as a full Unicode code point
// (the literal-character semantics — string.toChar's numeric parse is
// different). Raises IOException at end of input; an invalid UTF-8
// sequence raises Exception.
native char readChar();

// Typed readers: one token parsed by the matching string method. End
// of input raises IOException (from readToken); a malformed value
// raises exactly like that string method. The brace sits on the
// declaration line so the language-service index (and IDE completion)
// sees them — a one-line body is invisible to it.
int readInt() {
    return readToken().toInt();
}

long readLong() {
    return readToken().toLong();
}

float readFloat() {
    return readToken().toFloat();
}

double readDouble() {
    return readToken().toDouble();
}

bool readBool() {
    return readToken().toBool();
}

// Read a whole text file as bytes.
// Raises IOException on failure; capped at 16 MiB.
native string readFile(string path);
// Create or truncate path and write content.
// Raises IOException on failure.
native void writeFile(string path, string content);

// Create or append content to path.
// Raises IOException on failure.
native void appendFile(string path, string content);

// In-memory binary stream (v0.12.7 Task 8.5: declared here like every
// other builtin class; the C++ registry row is retired). Writes append
// at the position; reads advance it. length() is the byte count,
// position() the next read/write offset; reset() rewinds to 0.
class ByteStream {
    // Empty stream. The write family appends; readInt etc. consume from
    // the position and raise IOException at the end of the buffer.
    public native ByteStream();

    // Scalar readers: 4-byte int/float and 8-byte long/double wire
    // forms; readString is length-prefixed UTF-8.
    public native int readInt();
    public native float readFloat();
    public native long readLong();
    public native double readDouble();
    public native string readString();

    // Stream control: byte count, next offset, rewind, release.
    public native int length();
    public native int position();
    public native void reset();
    public native void close();

    // Scalar writers: the argument kind matches the declared formal
    // (an int argument may be any integer of at most 32 bits; a long
    // or double argument widens from narrower kinds).
    public native void writeInt(int v);
    public native void writeFloat(float v);
    public native void writeLong(long v);
    public native void writeDouble(double v);
    public native void writeString(string s);

    // Structured serialization: writeStruct takes a struct value;
    // writeObject takes a class value, an array value or null (an
    // interface-typed reference serializes the actual object; an array
    // value serializes by logical content — a view materializes
    // first). readStruct/readObject take the type name as a STRING
    // LITERAL and return a value of that declared type — the compiler
    // resolves the literal to the declaration and the runtime checks
    // polymorphic reads. readArray reads back a written array as a
    // self-describing record; cast the Object result with `as` to the
    // annotated array type (the cast checks rank and element type).
    public native void writeStruct(Object s);
    public native void writeObject(Object o);
    public native Object readStruct(string typeName);
    public native Object readObject(string typeName);
    public native Object readArray();
}

// File-backed binary stream with the ByteStream method family minus
// reset (a file stream rewinds by re-opening); mode is "read" or
// "write" (case-insensitive). Writing in read mode, reading a missing
// file, and any host I/O failure raise IOException.
class FileStream {
    // Open path in the given mode. Raises IOException on failure.
    public native FileStream(string path, string mode);

    public native int readInt();
    public native float readFloat();
    public native long readLong();
    public native double readDouble();
    public native string readString();
    public native int length();
    public native int position();
    public native void close();
    public native void writeInt(int v);
    public native void writeFloat(float v);
    public native void writeLong(long v);
    public native void writeDouble(double v);
    public native void writeString(string s);
    public native void writeStruct(Object s);
    public native void writeObject(Object o);
    public native Object readStruct(string typeName);
    public native Object readObject(string typeName);
    public native Object readArray();
}

// Park the current virtual thread until fd is ready (events: 1 = read,
// 2 = write) or the absolute deadline is reached (deadlineMs <= 0 means
// no deadline); fd < 0 is a pure deadline park (timed wakeup), and
// fd < 0 with no deadline returns immediately — nothing can wake such
// a park. The call returns after the wake — the caller re-checks its
// condition and may park again.
native void parkForIo(int fd, int events, long deadlineMs);

// string is a byte container; these helpers convert between text and
// byte arrays (the raw UTF-8 byte sequence, bypassing the string method
// surface). Moved from the net package — generic byte conversion is not
// network-specific.
native byte[] toBytes(string s);
native string fromBytes(byte[] data);

// ---- Base64 codecs (RFC 4648) ---------------------------------------------
// Standard alphabet with '=' padding; malformed input raises Exception.
string base64Encode(byte[] data) {
    const string ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    int n = data.length();
    byte[] dst = byte[((n + 2) / 3) * 4];
    int j = 0;
    for (int i = 0; i < n; i = i + 3) {
        int b0 = data[i];
        if (b0 < 0) { b0 = b0 + 256; }
        int b1 = 0;
        if (i + 1 < n) { b1 = data[i + 1]; if (b1 < 0) { b1 = b1 + 256; } }
        int b2 = 0;
        if (i + 2 < n) { b2 = data[i + 2]; if (b2 < 0) { b2 = b2 + 256; } }
        int v0 = b0 / 4;
        int v1 = (b0 % 4) * 16 + b1 / 16;
        int v2 = 0;
        if (i + 1 < n) { v2 = (b1 % 16) * 4 + b2 / 64; }
        int v3 = 0;
        if (i + 2 < n) { v3 = b2 % 64; }
        dst[j] = ALPHABET[v0] as byte;
        dst[j + 1] = ALPHABET[v1] as byte;
        if (i + 1 < n) { dst[j + 2] = ALPHABET[v2] as byte; } else { dst[j + 2] = 61 as byte; }
        if (i + 2 < n) { dst[j + 3] = ALPHABET[v3] as byte; } else { dst[j + 3] = 61 as byte; }
        j = j + 4;
    }
    return fromBytes(dst[0:j]);
}

// Decode standard Base64: length must be a multiple of 4; '=' padding
// only in the last one or two positions with zero leftover bits.
byte[] base64Decode(string s) {
    int len = s.length();
    if (len % 4 != 0) {
        throw Exception("base64Decode: input length must be a multiple of 4.");
    }
    const string ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    int[] rev = int[256];
    for (int i = 0; i < 256; i = i + 1) { rev[i] = -1; }
    for (int i = 0; i < 64; i = i + 1) { rev[ALPHABET[i]] = i; }
    if (len == 0) { return byte[0]; }
    int pad = 0;
    if ((s[len - 1]) == 61) {
        pad = pad + 1;
        if ((s[len - 2]) == 61) { pad = pad + 1; }
    }
    byte[] dst = byte[len / 4 * 3 - pad];
    int j = 0;
    for (int i = 0; i < len; i = i + 4) {
        int v0 = rev[s[i]];
        int v1 = rev[s[i + 1]];
        int v2 = 0;
        if (i + 2 < len - pad) { v2 = rev[s[i + 2]]; }
        int v3 = 0;
        if (i + 3 < len - pad) { v3 = rev[s[i + 3]]; }
        if (v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0) {
            throw Exception("base64Decode: input contains a character outside the Base64 alphabet.");
        }
        int groupBytes = 3;
        if (i == len - 4) {
            // The padding-bit checks apply only to the final group: pad is a
            // tail property, and the low bits of a full group are data.
            groupBytes = 3 - pad;
            if (pad == 2 && (v1 % 16) != 0) {
                throw Exception("base64Decode: non-zero bits in padding.");
            }
            if (pad == 1 && (v2 % 4) != 0) {
                throw Exception("base64Decode: non-zero bits in padding.");
            }
        }
        dst[j] = (v0 * 4 + v1 / 16) as byte;
        if (groupBytes >= 2) { dst[j + 1] = ((v1 % 16) * 16 + v2 / 4) as byte; }
        if (groupBytes >= 3) { dst[j + 2] = ((v2 % 4) * 64 + v3) as byte; }
        j = j + groupBytes;
    }
    return dst;
}

// URL-safe alphabet ('-' '_') without padding, JWT style.
string base64UrlEncode(byte[] data) {
    string s = base64Encode(data);
    s = s.replace("+", "-");
    s = s.replace("/", "_");
    int end = s.length();
    while (end > 0 && (s[end - 1]) == 61) { end = end - 1; }
    return s.substring(0, end);
}

// Decode URL-safe Base64 with or without padding; a length of 1 mod 4
// is malformed.
byte[] base64UrlDecode(string s) {
    string t = s.replace("-", "+");
    t = t.replace("_", "/");
    int rem = t.length() % 4;
    if (rem == 1) {
        throw Exception("base64UrlDecode: input length is not a valid Base64 length.");
    }
    while (t.length() % 4 != 0) { t = t + "="; }
    return base64Decode(t);
}
