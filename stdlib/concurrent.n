// Standard library source for the "concurrent" package — the
// coordination handle classes (Mutex, Semaphore, ReentrantMutex,
// AtomicInt, Channel) and pure NLang utilities built on them. The
// handle classes are native (implemented in the VM, intrinsic
// channel); the utilities are ordinary NLang code. Needs an explicit
// `import concurrent;`.

// Mutual exclusion: lock() parks the caller while the mutex is held;
// unlock() hands ownership to the front waiter (FIFO handoff).
// tryLock() takes the mutex only if it is free; never parks.
class Mutex {
    public native Mutex();
    public native void lock();
    public native void unlock();
    public native bool tryLock();
}

// Counting semaphore with FIFO handoff: acquire() parks at zero permits
// and release() hands the permit directly to the front waiter.
// tryAcquire() never parks; over-release is legal.
class Semaphore {
    public native Semaphore(int initial);
    public native void acquire();
    public native void release();
    public native bool tryAcquire();
}

// Reentrant lock: the owning context may lock() again without parking
// (a per-owner hold count); unlock() must be called once per lock() and
// releases only when the count reaches zero. The plain Mutex stays
// non-reentrant — pick ReentrantMutex when methods compose or recurse.
class ReentrantMutex {
    public native ReentrantMutex();
    public native void lock();
    public native void unlock();
    public native bool tryLock();
}

// Atomic integer: lock-free single-value primitives for cross-carrier
// shared state — counters, flags. All operations are atomic; getAndX
// returns the previous value, xAndGet the new one.
class AtomicInt {
    public native AtomicInt(int initial = 0);
    public native int load();
    public native void store(int v);
    public native int getAndSet(int v);
    public native bool compareExchange(int expect, int v);
    public native int getAndAdd(int delta);
    public native int addAndGet(int delta);
    public native int incrementAndGet();
    public native int getAndIncrement();
}

// Raised by Channel receive/send after the channel is closed.
class ChannelClosedException : Exception {
    public native ChannelClosedException(string message);
}

// Synchronous rendezvous channel of one element type; capacity 0 is
// unbounded. send parks when full, recv parks when empty; operations on
// a closed channel raise ChannelClosedException.
class Channel<T> {
    public native Channel();
    public native Channel(int capacity);
    public native void send(T item);
    public native T recv();
    public native void close();
}

// Counts outstanding units of work; wait() blocks the calling virtual
// thread until the counter reaches zero. Contract (Go WaitGroup shape):
// add() must happen before wait(), and every added unit calls done()
// exactly once — a done() without a matching add() releases waiters
// early, an add() without done()s parks them at the deadlock guard.
// The counter is mutex-guarded like any shared mutable state, so
// correctness does not lean on the interpreter's coarse-grained GIL
// windows.
class WaitGroup {
    private int m_pending;
    private Mutex m_gate;
    private Channel<int> m_done;

    public WaitGroup() {
        this.m_pending = 0;
        this.m_gate = Mutex();
        this.m_done = Channel(0);
    }

    public void add(int n) {
        m_gate.lock();
        m_pending = m_pending + n;
        m_gate.unlock();
    }

    public void done() {
        m_gate.lock();
        m_pending = m_pending - 1;
        m_gate.unlock();
        m_done.send(1);
    }

    public void wait() {
        bool pending = true;
        while (pending) {
            m_gate.lock();
            pending = m_pending > 0;
            m_gate.unlock();
            if (pending) {
                m_done.recv();
            }
        }
    }
}
