/* ------------------------------------------------------------------
 * http.n — HTTP/1.1 protocol library (spec docs/dev/http_library_design.md).
 * Pure nlang on top of net.n: hardened parsing, buffered and streaming
 * messages, a threaded server and a pooled client. The gzip codec lives
 * in the gzip package.
 * ------------------------------------------------------------------ */
import io;
import net;
import concurrent;
import thread;
import system;
import gzip;
import url;

const class HttpException : IOException {
    public int status;                       // 0 = not an HTTP status error
    public HttpException(string message, int status = 0, Exception cause = null) {
        super(message, cause);
        this.status = status;
    }
}

// Case-insensitive header table: keys are matched lowercased, the
// original spelling is kept for writing. List fields are read as
// shallow copies (manual §12), so every mutation reads into locals and
// writes the fields back.
class HttpHeaders {
    private List<string> m_names;            // original spelling
    private List<string> m_lower;            // parallel lowercased keys
    private List<string> m_values;           // parallel values

    public HttpHeaders() {
        m_names = {};
        m_lower = {};
        m_values = {};
    }

    private static string lower(string s) {
        // ASCII-only folding; header field names are ASCII (RFC 9110).
        byte[] b = io.toBytes(s);
        for (int i = 0; i < b.length(); i = i + 1) {
            int c = b[i];
            if (c < 0) { c = c + 256; }
            if (c >= 65 && c <= 90) { b[i] = (c + 32) as byte; }
        }
        return io.fromBytes(b);
    }

    public string get(string name) {
        List<string> vs = this.getAll(name);
        if (vs.length() == 0) { return ""; }
        return vs[0];
    }

    public List<string> getAll(string name) {
        List<string> matched = {};
        string key = lower(name);
        List<string> ls = m_lower;
        List<string> vs = m_values;
        for (int i = 0; i < ls.length(); i = i + 1) {
            if (ls[i] == key) { matched.add(vs[i]); }
        }
        return matched;
    }

    public void set(string name, string value) {
        // this-qualified: a bare remove() would also see fs.remove(string).
        this.remove(name);
        this.add(name, value);
    }

    public void add(string name, string value) {
        // D9 write-boundary guard: a CR/LF in a name or value would
        // inject a whole header line (or a request-splitting prefix).
        // The parser validates the wire bytes before calling add(); this
        // protects the programmatic path (client/server user headers).
        if (name.indexOf("\r") >= 0 || name.indexOf("\n") >= 0
                || value.indexOf("\r") >= 0 || value.indexOf("\n") >= 0) {
            throw HttpException("http: header name/value must not contain CR or LF", 0);
        }
        List<string> ns = m_names;
        List<string> ls = m_lower;
        List<string> vs = m_values;
        ns.add(name);
        ls.add(lower(name));
        vs.add(value);
        m_names = ns;
        m_lower = ls;
        m_values = vs;
    }

    public void remove(string name) {
        string key = lower(name);
        List<string> ns = {};
        List<string> ls = {};
        List<string> vs = {};
        for (int i = 0; i < m_lower.length(); i = i + 1) {
            if (m_lower[i] != key) {
                ns.add(m_names[i]);
                ls.add(m_lower[i]);
                vs.add(m_values[i]);
            }
        }
        m_names = ns;
        m_lower = ls;
        m_values = vs;
    }

    public bool has(string name) {
        return m_lower.indexOf(lower(name)) >= 0;
    }

    public List<string> names() {
        // Deduplicated original spellings, first-seen order.
        List<string> uniqNames = {};
        List<string> seen = {};
        for (int i = 0; i < m_lower.length(); i = i + 1) {
            if (!seen.contains(m_lower[i])) {
                seen.add(m_lower[i]);
                uniqNames.add(m_names[i]);
            }
        }
        return uniqNames;
    }

    public int count() {
        return m_names.length();
    }

    // Shallow copy preserving order and original spellings (consumed
    // by HttpClient.execute so redirects/retries never mutate the
    // caller's headers).
    public HttpHeaders copy() {
        HttpHeaders merged = HttpHeaders();
        for (int i = 0; i < m_names.length(); i = i + 1) {
            merged.add(m_names[i], m_values[i]);
        }
        return merged;
    }
}

class HttpRequest {
    public string method = "GET";
    public Url url;
    public string version = "HTTP/1.1";
    public HttpHeaders headers;
    public byte[] body;                      // client: buffered body (exclusive with bodyChannel)
    public Channel<byte[]> bodyChannel;      // client: streaming upload (chunked, D16)
    public HttpBodyReader bodyReader;        // server: framing-aware streaming body (D5)
    // Documented extensions beyond the spec field list (ledger Ruling):
    public bool connectionClose;             // parsed "Connection: close" (D9)
    public int framingMode;                  // HttpParser.MODE_*
    public int framingLength = -1;           // Content-Length when MODE_LENGTH

    public HttpRequest() {
        headers = HttpHeaders();
    }

    public string bodyText() {
        // A server-side request carries its body in the framing-aware
        // reader (D5); a client-side request carries the buffered `body`.
        if (bodyReader != null) { return bodyReader.bodyText(); }
        if (body != null) { return io.fromBytes(body); }
        return "";
    }
}

class HttpResponse {
    public int statusCode = 200;
    public string reasonPhrase = "OK";
    public string version = "HTTP/1.1";
    public HttpHeaders headers;
    public byte[] body;
    public Channel<byte[]> bodyChannel;      // server: streaming response (chunked + backpressure)
    public Url requestUrl;                   // final URL after redirects (D12)
    public bool compressBody = false;        // server: gzip the buffered body when accepted (D21)
    public bool connectionClose;
    public int framingMode;
    public int framingLength = -1;

    public HttpResponse() {
        headers = HttpHeaders();
    }

    public string bodyText() {
        if (body != null) { return io.fromBytes(body); }
        return "";
    }
}

// Pure functions over a byte buffer: buffer + bytes available → message
// + consumed, or "need more" (null). No socket, no state — the whole
// hardening surface (D9) is testable offline (red line 3).
class HttpParser {
    public static const int MODE_NONE = 0;
    public static const int MODE_LENGTH = 1;
    public static const int MODE_CHUNKED = 2;
    public static const int MODE_EOF = 3;
    // Max bytes handed to one TcpStream.write call (D7): HttpConn.writeAll
    // slices larger payloads into WRITE_SLICE chunks so each slice gets its
    // own timeout budget — a slow reader can never hold one write forever.
    public static const int WRITE_SLICE = 65536;

    public static HttpRequest parseRequest(byte[] buf, int have,
        int maxHeaderBytes, int maxHeaders, out int consumed) {
        consumed = 0;
        int end = findEndOfHeaders(buf, have);
        int blockLen = have;
        if (end >= 0) { blockLen = end + 4; }
        checkHeaderBytes(buf, blockLen, end < 0);          // 400
        if (end < 0) {
            if (have > maxHeaderBytes) {
                throw HttpException("http: header block exceeds " + maxHeaderBytes.toString() + " bytes", 431);
            }
            return null;
        }
        if (blockLen > maxHeaderBytes) {
            throw HttpException("http: header block exceeds " + maxHeaderBytes.toString() + " bytes", 431);
        }
        List<string> lines = headerLines(buf, blockLen);
        if (lines.length() - 1 > maxHeaders) {
            throw HttpException("http: too many header fields", 431);
        }
        string line0 = lines[0];
        int sp1 = line0.indexOf(" ");
        int sp2 = -1;
        if (sp1 >= 0) { sp2 = line0.indexOf(" ", sp1 + 1); }
        if (sp1 < 0 || sp2 < 0 || line0.indexOf(" ", sp2 + 1) >= 0) {
            throw HttpException("http: malformed request line", 400);
        }
        HttpRequest req = HttpRequest();
        req.method = line0.substring(0, sp1);
        try {
            req.url = Url.parse(line0.substring(sp1 + 1, sp2));
        } catch (UrlException e) {
            throw HttpException("http: malformed request target", 400);
        }
        req.version = line0.substring(sp2 + 1);
        if (!isToken(req.method)) {
            throw HttpException("http: malformed method", 400);
        }
        if (req.version != "HTTP/1.1" && req.version != "HTTP/1.0") {
            throw HttpException("http: unsupported version " + req.version, 505);
        }
        checkTarget(req.url);
        parseInto(req.headers, lines);
        checkHost(req.headers, req.version);
        int fl = 0;
        req.framingMode = framingOf(req.headers, false, 200, out fl);
        req.framingLength = fl;
        req.connectionClose = hasCloseToken(req.headers);
        if (req.version == "HTTP/1.0" && !hasKeepAliveToken(req.headers)) {
            req.connectionClose = true;             // D7, RFC 9112 §9
        }
        consumed = blockLen;
        return req;
    }

    public static HttpResponse parseResponse(byte[] buf, int have,
        int maxHeaderBytes, out int consumed) {
        consumed = 0;
        int end = findEndOfHeaders(buf, have);
        int blockLen = have;
        if (end >= 0) { blockLen = end + 4; }
        checkHeaderBytes(buf, blockLen, end < 0);
        if (end < 0) {
            if (have > maxHeaderBytes) {
                throw HttpException("http: header block exceeds " + maxHeaderBytes.toString() + " bytes", 431);
            }
            return null;
        }
        if (blockLen > maxHeaderBytes) {
            throw HttpException("http: header block exceeds " + maxHeaderBytes.toString() + " bytes", 431);
        }
        List<string> lines = headerLines(buf, blockLen);
        string line0 = lines[0];
        int sp1 = line0.indexOf(" ");
        if (sp1 < 0) { throw HttpException("http: malformed status line", 400); }
        HttpResponse res = HttpResponse();
        res.version = line0.substring(0, sp1);
        if (res.version != "HTTP/1.1" && res.version != "HTTP/1.0") {
            throw HttpException("http: unsupported version " + res.version, 505);
        }
        string rest = line0.substring(sp1 + 1);
        int sp2 = rest.indexOf(" ");
        string codeText = rest;
        string reason = "";
        if (sp2 >= 0) {
            codeText = rest.substring(0, sp2);
            reason = trimOws(rest.substring(sp2 + 1));
        }
        res.reasonPhrase = reason;
        res.statusCode = parseDigits(codeText);
        if (res.statusCode < 100 || res.statusCode > 999) {
            throw HttpException("http: malformed status code", 400);
        }
        parseInto(res.headers, lines);
        int fl = 0;
        res.framingMode = framingOf(res.headers, true, res.statusCode, out fl);
        res.framingLength = fl;
        res.connectionClose = hasCloseToken(res.headers);
        if (res.version == "HTTP/1.0" && !hasKeepAliveToken(res.headers)) {
            res.connectionClose = true;             // D7, RFC 9112 §9
        }
        consumed = blockLen;
        return res;
    }

    public static byte[] encodeChunk(byte[] data) {
        List<byte> acc = {};
        appendAscii(acc, toHex(data.length()) + "\r\n");
        for (int i = 0; i < data.length(); i = i + 1) { acc.add(data[i]); }
        appendAscii(acc, "\r\n");
        return toByteArray(acc);
    }

    // List<byte> accumulators are the language's only growable byte
    // sequence (Array<T> has no add); materialize at API boundaries.
    public static byte[] toByteArray(List<byte> src) {
        byte[] d = byte[src.length()];
        for (int i = 0; i < src.length(); i = i + 1) { d[i] = src.get(i); }
        return d;
    }

    public static byte[] encodeLastChunk() {
        return io.toBytes("0\r\n\r\n");
    }

    // null + consumed==0 → need more; payload + consumed>0 → progress;
    // payload (possibly empty) + consumed<0 → stream ended (|consumed|
    // bytes consumed, last chunk and trailer included).
    public static byte[] decodeChunked(byte[] buf, int have, out int consumed) {
        consumed = 0;
        List<byte> payload = {};
        int pos = 0;
        while (true) {
            int crlf = findCrlf(buf, pos, have);
            if (crlf < 0) { return chunkProgress(payload); }
            int size = parseChunkSize(buf, pos, crlf);     // 400 on malformed
            int dataStart = crlf + 2;
            if (size == 0) {
                int t = dataStart;
                while (true) {
                    int tcr = findCrlf(buf, t, have);
                    if (tcr < 0) { return chunkProgress(payload); }
                    if (tcr == t) { break; }               // empty line ends trailers
                    checkTrailerLine(buf, t, tcr);        // 400 on malformed
                    t = tcr + 2;
                }
                consumed = -(t + 2);
                return toByteArray(payload);
            }
            if (have < dataStart + size + 2) { return chunkProgress(payload); }
            if (byteAt(buf, dataStart + size) != 13 || byteAt(buf, dataStart + size + 1) != 10) {
                throw HttpException("http: chunk data not CRLF-terminated", 400);
            }
            for (int i = 0; i < size; i = i + 1) { payload.add(buf[dataStart + i]); }
            pos = dataStart + size + 2;
            // Only ever set after a whole chunk: a "need more" exit then
            // reports progress (consumed > 0), while nothing complete yet
            // keeps consumed == 0 (the contract above).
            consumed = pos;
        }
    }

    // Need-more exit: a partial chunk collected so far is still progress
    // (return it with the caller's consumed>0); nothing complete yet →
    // null with consumed==0 (the contract above).
    private static byte[] chunkProgress(List<byte> payload) {
        if (payload.length() > 0) { return toByteArray(payload); }
        return null;
    }

    public static bool isToken(string s) {
        if (s.length() == 0) { return false; }
        for (int i = 0; i < s.length(); i = i + 1) {
            if (!isTchar(s[i])) { return false; }
        }
        return true;
    }

    public static List<string> splitTokens(string value) {
        List<string> toks = {};
        string tok = "";
        for (int i = 0; i <= value.length(); i = i + 1) {
            bool sep = i == value.length() || value[i] == 44 || value[i] == 32 || value[i] == 9;
            if (sep) {
                if (tok.length() > 0) { toks.add(tok); }
                tok = "";
            } else {
                tok = tok + value.substring(i, i + 1);
            }
        }
        return toks;
    }

    // ---- private helpers ----

    private static int byteAt(byte[] b, int i) {
        int c = b[i];
        if (c < 0) { c = c + 256; }
        return c;
    }

    private static int findCrlf(byte[] buf, int from, int have) {
        for (int i = from; i + 1 < have; i = i + 1) {
            if (byteAt(buf, i) == 13 && byteAt(buf, i + 1) == 10) { return i; }
        }
        return -1;
    }

    private static int findEndOfHeaders(byte[] buf, int have) {
        for (int i = 0; i + 3 < have; i = i + 1) {
            if (byteAt(buf, i) == 13 && byteAt(buf, i + 1) == 10
                && byteAt(buf, i + 2) == 13 && byteAt(buf, i + 3) == 10) { return i; }
        }
        return -1;
    }

    // Rejects control chars (400) and bare CR/LF (400); HTAB stays legal
    // as OWS / field-value content (RFC 9110 OWS = SP / HTAB). A trailing
    // CR in undecided input is not yet known to be bare → tolerated until
    // more bytes arrive.
    private static void checkHeaderBytes(byte[] buf, int len, bool undecided) {
        for (int i = 0; i < len; i = i + 1) {
            int c = byteAt(buf, i);
            if (c == 13) {
                if (i + 1 < len) {
                    if (byteAt(buf, i + 1) != 10) { throw HttpException("http: bare CR in header block", 400); }
                    i = i + 1;
                } else if (!undecided) {
                    throw HttpException("http: bare CR in header block", 400);
                }
            } else if (c == 10) {
                if (i == 0 || byteAt(buf, i - 1) != 13) { throw HttpException("http: bare LF in header block", 400); }
            } else if ((c < 32 && c != 9) || c == 127) {
                throw HttpException("http: control character in header block", 400);
            }
        }
    }

    private static List<string> headerLines(byte[] buf, int blockLen) {
        // blockLen ends with CRLFCRLF; split on CRLF, drop the final empty.
        List<string> lines = {};
        int start = 0;
        for (int i = 0; i + 1 < blockLen - 2; i = i + 1) {
            if (byteAt(buf, i) == 13 && byteAt(buf, i + 1) == 10) {
                lines.add(io.fromBytes(buf[start:i]));
                start = i + 2;
                i = i + 1;
            }
        }
        return lines;
    }

    private static void parseInto(HttpHeaders headers, List<string> lines) {
        for (int i = 1; i < lines.length(); i = i + 1) {
            string ln = lines[i];
            int colon = ln.indexOf(":");
            if (colon <= 0) { throw HttpException("http: malformed header line", 400); }
            int sp = ln.indexOf(" ");
            int tab = ln.indexOf("\t");
            if ((sp >= 0 && sp < colon) || (tab >= 0 && tab < colon)) {
                throw HttpException("http: whitespace before header colon", 400);
            }
            string name = ln.substring(0, colon);
            if (!isToken(name)) { throw HttpException("http: malformed header name", 400); }
            headers.add(name, trimOws(ln.substring(colon + 1)));
        }
    }

    private static void checkHost(HttpHeaders headers, string version) {
        int n = headers.getAll("Host").length();
        if (version == "HTTP/1.1") {
            if (n != 1) { throw HttpException("http: exactly one Host header required", 400); }
        } else if (n > 1) {
            throw HttpException("http: exactly one Host header required", 400);
        }
    }

    // TE/CL validation + framing decision (D9/D5). `isResponse` + status
    // select the no-body statuses. Returns the framing mode; the CL value
    // (-1 when absent) comes back in `framingLength`. Callers write both
    // onto their own typed message — no Object pun, no downcast. The
    // parser stays method-agnostic: the HEAD body-suppression rule
    // (RFC 9112 §6.3) is the client's job (readResponse's requestWasHead
    // override), because the parser never sees the request method.
    private static int framingOf(HttpHeaders headers, bool isResponse,
        int status, out int framingLength) {
        int chunked = 0;
        foreach (string v in headers.getAll("Transfer-Encoding")) {
            foreach (string tok in splitTokens(v)) {
                if (tok.equalsIgnoreCase("chunked")) { chunked = chunked + 1; }
                else { throw HttpException("http: unsupported transfer encoding", 400); }
            }
        }
        if (chunked > 1) { throw HttpException("http: multiple chunked Transfer-Encoding", 400); }
        List<string> cls = headers.getAll("Content-Length");
        int contentLength = -1;
        if (cls.length() > 0) {
            if (chunked == 1) { throw HttpException("http: Content-Length with Transfer-Encoding", 400); }
            foreach (string c in cls) {
                int d = parseDigits(c);
                if (d < 0) { throw HttpException("http: invalid Content-Length", 400); }
                if (contentLength >= 0 && d != contentLength) {
                    throw HttpException("http: conflicting Content-Length", 400);
                }
                contentLength = d;
            }
        }
        int mode = MODE_NONE;
        if (isResponse && (status < 200 || status == 204 || status == 304)) {
            mode = MODE_NONE;                       // no body regardless (RFC 9112 §6.3)
        } else if (chunked == 1) {
            mode = MODE_CHUNKED;
        } else if (contentLength >= 0) {
            mode = MODE_LENGTH;
        } else if (isResponse) {
            mode = MODE_EOF;                        // 1.1 without CL: read to close
        }
        framingLength = contentLength;
        return mode;
    }

    private static bool hasCloseToken(HttpHeaders headers) {
        foreach (string v in headers.getAll("Connection")) {
            foreach (string tok in splitTokens(v)) {
                if (tok.equalsIgnoreCase("close")) { return true; }
            }
        }
        return false;
    }

    // D7: HTTP/1.0 defaults to closing; it persists only when a
    // Connection token says keep-alive (RFC 9112 §9).
    private static bool hasKeepAliveToken(HttpHeaders headers) {
        foreach (string v in headers.getAll("Connection")) {
            foreach (string tok in splitTokens(v)) {
                if (tok.equalsIgnoreCase("keep-alive")) { return true; }
            }
        }
        return false;
    }

    private static void checkTarget(Url u) {
        string t = u.toString();
        if (t == "*") { return; }
        if (t.length() > 0 && t[0] == 47) { return; }          // origin-form "/"
        if (u.isAbsolute()) { return; }                        // absolute-form
        throw HttpException("http: malformed request target", 400);
    }

    private static void checkTrailerLine(byte[] buf, int start, int cr) {
        for (int i = start; i < cr; i = i + 1) {
            int c = byteAt(buf, i);
            // Same rule as header fields: HTAB is legal value content.
            if ((c < 32 && c != 9) || c == 127) { throw HttpException("http: control character in trailer", 400); }
        }
        string ln = io.fromBytes(buf[start:cr]);
        if (ln.indexOf(":") <= 0) { throw HttpException("http: malformed trailer line", 400); }
    }

    private static int parseDigits(string s) {
        // Strict all-digits → int; -1 on empty/non-digit/overflow.
        if (s.length() == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < s.length(); i = i + 1) {
            int c = s[i];
            if (c < 48 || c > 57) { return -1; }
            // Pre-check before mul-add: a post-check would read already
            // wrapped state. 214748364 = (INT_MAX - 7) / 10.
            if (v > 214748364 || (v == 214748364 && (c - 48) > 7)) { return -1; }
            v = v * 10 + (c - 48);
        }
        return v;
    }

    private static int parseChunkSize(byte[] buf, int start, int crlf) {
        // hex digits, optional ";ext" ignored; 400 on malformed.
        int v = -1;
        int acc = 0;
        for (int i = start; i < crlf; i = i + 1) {
            int c = byteAt(buf, i);
            if (c == 59) { break; }                            // ';' extension
            int d = -1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else if (c >= 97 && c <= 102) { d = c - 87; }
            else if (c >= 65 && c <= 70) { d = c - 55; }
            if (d < 0) { throw HttpException("http: malformed chunk size", 400); }
            if (v < 0) { v = 0; }
            // Pre-check before mul-add; 0x7FFFFFF = 0x7FFFFFFF / 16 keeps
            // acc * 16 + 15 within int32.
            if (acc > 0x7FFFFFF) { throw HttpException("http: chunk size overflow", 400); }
            acc = acc * 16 + d;
            v = acc;
        }
        if (v < 0) { throw HttpException("http: malformed chunk size", 400); }
        return v;
    }

    private static string toHex(int v) {
        if (v == 0) { return "0"; }
        string digits = "0123456789abcdef";
        string s = "";
        while (v > 0) {
            s = digits.substring(v % 16, v % 16 + 1) + s;
            v = v / 16;
        }
        return s;
    }

    // Public: HttpConn/HttpClient serialize headers through this helper
    // too (nlang has no friend access for private statics).
    public static void appendAscii(List<byte> dest, string s) {
        byte[] b = io.toBytes(s);
        for (int i = 0; i < b.length(); i = i + 1) { dest.add(b[i]); }
    }

    private static string trimOws(string s) {
        int a = 0;
        int b = s.length();
        while (a < b && (s[a] == 32 || s[a] == 9)) { a = a + 1; }
        while (b > a && (s[b - 1] == 32 || s[b - 1] == 9)) { b = b - 1; }
        return s.substring(a, b);
    }

    private static bool isTchar(int c) {
        // RFC 9110 tchar = ALPHA / DIGIT / "!" "#" "$" "%" "&" "'" "*"
        // "+" "-" "." "^" "_" "`" "|" "~" ":"
        if (c >= 97 && c <= 122) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 48 && c <= 57) { return true; }
        if (c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39
            || c == 42 || c == 43 || c == 45 || c == 46 || c == 94
            || c == 95 || c == 96 || c == 124 || c == 126 || c == 58) { return true; }
        return false;
    }
}

// RFC 1123 IMF-fixdate, always UTC (DateTime is a UTC calendar type).
class HttpDate {
    public static string format(long epochMs) {
        DateTime dt = DateTime.fromUnixMillis(epochMs);
        string[] days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
        string[] months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                           "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return days[dt.dayOfWeek()] + ", " + pad2(dt.day) + " " + months[dt.month - 1]
            + " " + pad4(dt.year) + " " + pad2(dt.hour) + ":" + pad2(dt.minute)
            + ":" + pad2(dt.second) + " GMT";
    }

    private static string pad2(int v) {
        if (v < 10) { return "0" + v.toString(); }
        return v.toString();
    }

    private static string pad4(int v) {
        string s = v.toString();
        while (s.length() < 4) { s = "0" + s; }
        return s;
    }
}

// Framing-aware body source over an HttpConn (D5): the request body is read
// on demand instead of being buffered up front, so a large upload never has
// to fit in memory. The server hands one to the handler as req.bodyReader;
// the client's streaming open() path reuses the class in Task 5.
class HttpBodyReader {
    private static const int READALL_WINDOW = 8192;
    private static const int DRAIN_WINDOW = 4096;

    private HttpConn m_conn;
    private int m_mode;
    private long m_remaining;          // MODE_LENGTH
    private long m_max;                // readAll/drain bound (<=0 = unlimited)
    private bool m_done;
    private bool m_closed;
    private byte[] m_chunkBuf;         // MODE_CHUNKED: decoded chunk not yet consumed
    private int m_chunkPos;
    private int m_timeoutMs;           // D7: per-read deadline

    public HttpBodyReader(HttpConn conn, int framingMode, int framingLength,
        long maxBodyBytes, int bodyTimeoutMs) {
        m_conn = conn;
        m_mode = framingMode;
        m_remaining = framingLength;
        m_max = maxBodyBytes;
        m_done = (framingMode == HttpParser.MODE_NONE);
        m_closed = false;
        m_chunkBuf = byte[0];
        m_chunkPos = 0;
        m_timeoutMs = bodyTimeoutMs;
    }

    // Copies the next body bytes into buf; returns the count, or -1 once the
    // body has ended. timeoutMs <= 0 falls back to the constructor budget
    // (D7), so net's raw "<=0 = forever" spelling never leaks through here.
    public int read(byte[] buf, int timeoutMs = 0) {
        if (m_closed || m_done) { return -1; }
        if (buf.length() == 0) { return 0; }
        if (timeoutMs <= 0) { timeoutMs = m_timeoutMs; }
        if (m_mode == HttpParser.MODE_LENGTH) {
            if (m_remaining <= 0) { m_done = true; return -1; }
            int want = buf.length();
            if (want > m_remaining) { want = m_remaining as int; }
            byte[] tmp = byte[want];
            int n = m_conn.readBuffered(tmp, timeoutMs);
            if (n <= 0) { m_done = true; return -1; }   // early EOF = end of body
            for (int i = 0; i < n; i = i + 1) { buf[i] = tmp[i]; }
            m_remaining = m_remaining - n;
            return n;
        }
        if (m_mode == HttpParser.MODE_CHUNKED) {
            // A decoded chunk larger than the caller's buf is capped here and
            // the remainder stashed, so the caller's buffer size stays
            // independent of the peer's chunk size (Go's chunkedReader). The
            // loop, not an if: a zero-length chunk before the trailer must not
            // make this read return 0 with no progress.
            while (m_chunkPos >= m_chunkBuf.length()) {
                byte[] chunk = m_conn.decodeChunk(timeoutMs);
                if (chunk == null) { m_done = true; return -1; }
                m_chunkBuf = chunk;
                m_chunkPos = 0;
            }
            int n = m_chunkBuf.length() - m_chunkPos;
            if (n > buf.length()) { n = buf.length(); }
            for (int i = 0; i < n; i = i + 1) { buf[i] = m_chunkBuf[m_chunkPos + i]; }
            m_chunkPos = m_chunkPos + n;
            return n;
        }
        // MODE_EOF: read until the peer closes.
        int n = m_conn.readBuffered(buf, timeoutMs);
        if (n <= 0) { m_done = true; return -1; }
        return n;
    }

    // Reads the whole body; throws HttpException(413) past maxBodyBytes (D5).
    public byte[] readAll() {
        List<byte> acc = {};
        byte[] tmp = byte[READALL_WINDOW];
        while (true) {
            int n = this.read(tmp, m_timeoutMs);
            if (n < 0) { break; }
            if (m_max > 0 && acc.length() + n > m_max) {
                throw HttpException("http: body exceeds " + m_max.toString() + " bytes", 413);
            }
            for (int i = 0; i < n; i = i + 1) { acc.add(tmp[i]); }
        }
        return HttpParser.toByteArray(acc);
    }

    public string bodyText() {
        return io.fromBytes(this.readAll());
    }

    public void close() {
        m_closed = true;
    }

    // Consumes whatever is left of the body so the connection can be reused;
    // false when the remainder exceeded maxBytes (the caller must then close
    // the connection — the server's drain cap, D5).
    public bool drain(int maxBytes) {
        byte[] tmp = byte[DRAIN_WINDOW];
        int total = 0;
        while (true) {
            int n = this.read(tmp, m_timeoutMs);
            if (n < 0) { return true; }
            total = total + n;
            if (total > maxBytes) { return false; }
        }
    }
}

// Buffered socket wrapper: incremental parsing needs a growable read buffer
// shared between the message parser and the body reader, because a peer can
// coalesce a head and body into one segment or split a head across several.
class HttpConn {
    private static const int FILL_WINDOW = 8192;
    private static const int DEFAULT_DRAIN_CAP = 262144;
    private static const int CLOSE_SINK_WINDOW = 4096;
    private static const int CLOSE_GRACE_MS = 200;

    public TcpStream stream;
    private byte[] m_buf;
    private int m_cap;
    private int m_have;
    private bool m_eof;
    private bool m_chunkDone;   // chunked terminator seen; reset per message
    private HttpServer m_srv;   // owning server; null for client-pool connections

    public HttpConn(TcpStream s, HttpServer srv = null) {
        stream = s;
        m_srv = srv;
        m_buf = byte[FILL_WINDOW];
        m_cap = FILL_WINDOW;
        m_have = 0;
        m_eof = false;
        m_chunkDone = false;
    }

    // One socket read appended to the buffer; false on EOF. Array<T> has no
    // add: m_buf is a fixed byte[] whose capacity doubles (copying the m_have
    // valid bytes) when a read would overrun it.
    public bool fill(int timeoutMs) {
        if (m_eof) { return false; }
        if (m_cap - m_have < FILL_WINDOW) { this.grow(); }
        byte[] tmp = byte[FILL_WINDOW];
        int n = stream.read(tmp, timeoutMs);
        if (n <= 0) { m_eof = true; return false; }
        for (int i = 0; i < n; i = i + 1) { m_buf[m_have + i] = tmp[i]; }
        m_have = m_have + n;
        return true;
    }

    // Body bytes may already sit in m_buf behind a parsed head (the peer
    // coalesced head and body into one segment). Drain the buffer first, then
    // read the socket directly; returns the bytes copied into dst[0..]
    // (0 = EOF, or dst empty).
    public int readBuffered(byte[] dst, int timeoutMs) {
        if (dst.length() == 0) { return 0; }
        if (m_have > 0) {
            int n = m_have;
            if (n > dst.length()) { n = dst.length(); }
            for (int i = 0; i < n; i = i + 1) { dst[i] = m_buf[i]; }
            this.discard(n);
            return n;
        }
        if (m_eof) { return 0; }
        return stream.read(dst, timeoutMs);
    }

    // D7: the timeout bounds each ≤64KB slice, not the whole write — a
    // slow-drip peer must not fail a large body at its first slice.
    public void writeAll(byte[] data, int timeoutMs) {
        int off = 0;
        while (off < data.length()) {
            int n = data.length() - off;
            if (n > HttpParser.WRITE_SLICE) { n = HttpParser.WRITE_SLICE; }
            stream.write(data[off:off + n], n, timeoutMs);
            off = off + n;
        }
    }

    // Parses one request from the buffer, refilling as needed. The first wait
    // (no bytes yet) is the keep-alive idle timeout; once bytes have started
    // arriving the header phase is bounded by headerTimeoutMs as a total
    // budget (Slowloris, D7). null = the peer closed.
    public HttpRequest readRequest(int keepAliveTimeoutMs, int headerTimeoutMs,
        int maxHeaderBytes, int maxHeaders) {
        m_chunkDone = false;   // fresh message: the prior chunked stream is over
        long deadline = -1;    // header-phase total deadline, set on the first byte
        while (true) {
            int consumed = 0;
            HttpRequest req = HttpParser.parseRequest(m_buf, m_have,
                maxHeaderBytes, maxHeaders, out consumed);
            if (req != null) {
                this.discard(consumed);
                return req;
            }
            int timeoutMs = keepAliveTimeoutMs;
            if (m_have > 0) {
                if (deadline < 0) { deadline = system.monoMs() + headerTimeoutMs; }
                long left = deadline - system.monoMs();
                if (left <= 0) {
                    throw HttpException("http: header phase timeout", 408);
                }
                timeoutMs = headerTimeoutMs;
                if (left < headerTimeoutMs) { timeoutMs = left as int; }
            }
            if (!this.fill(timeoutMs)) { return null; }
        }
    }

    // Parses one response head from the buffer, refilling as needed (client
    // side; mirrors readRequest). EOF before a complete head → HttpException.
    // The parser never sees the request method, so a HEAD caller passes
    // requestWasHead down and the body framing is suppressed here: a HEAD
    // response keeps Content-Length but carries no body (RFC 9112 §6.3), so
    // without this readAll would wait for bytes that never come.
    public HttpResponse readResponse(int timeoutMs, int maxHeaderBytes,
        bool requestWasHead = false) {
        m_chunkDone = false;   // fresh message: the prior chunked stream is over
        while (true) {
            int consumed = 0;
            HttpResponse res = HttpParser.parseResponse(m_buf, m_have,
                maxHeaderBytes, out consumed);
            if (res != null) {
                if (requestWasHead) {
                    res.framingMode = HttpParser.MODE_NONE;
                    res.framingLength = 0;
                }
                this.discard(consumed);
                return res;
            }
            if (!this.fill(timeoutMs)) {
                throw HttpException("connection closed", 0);
            }
        }
    }

    // Decodes one chunk payload, refilling as needed. null = the chunked
    // stream ended (terminator seen or connection EOF). The terminator sets
    // m_chunkDone, not m_eof: the socket may still carry the next pipelined
    // message, and readRequest/readResponse reset the flag per message.
    public byte[] decodeChunk(int timeoutMs) {
        if (m_chunkDone) { return null; }
        while (true) {
            int consumed = 0;
            byte[] payload = HttpParser.decodeChunked(m_buf, m_have, out consumed);
            if (consumed < 0) {
                this.discard(-consumed);
                m_chunkDone = true;
                return payload;
            }
            if (payload != null) {
                this.discard(consumed);
                return payload;
            }
            if (!this.fill(timeoutMs)) { return null; }
        }
    }

    // Serializes and writes the response (D5/D14/D21): status line, headers
    // (Date filled when absent), then the body per framing — buffered with
    // Content-Length, a chunked pump for bodyChannel, or no body at all. A
    // HEAD response keeps Content-Length and suppresses the bytes.
    public void writeResponse(HttpResponse res, HttpRequest req, bool head, int writeTimeoutMs) {
        bool noBody = res.statusCode < 200 || res.statusCode == 204 || res.statusCode == 304;
        // D21: compress the buffered body before Content-Length is set, only
        // when the handler opted in and the client accepts gzip.
        byte[] body = res.body;
        if (!noBody && res.compressBody && body != null && acceptsGzip(req)) {
            body = gzip.compress(body);
            res.headers.set("Content-Encoding", "gzip");
            res.headers.set("Vary", "Accept-Encoding");
        }
        bool chunked = !noBody && res.bodyChannel != null;
        // Closing the channel for HEAD too: without it a producer blocked in
        // send() would leak (the D18 cancellation path).
        if (res.bodyChannel != null && (noBody || head)) { res.bodyChannel.close(); }
        if (!noBody && !chunked && body != null) {
            res.headers.set("Content-Length", body.length().toString());
        } else if (!noBody && !chunked && !head) {
            res.headers.set("Content-Length", "0");
        }
        if (!res.headers.has("Date")) {
            res.headers.set("Date", HttpDate.format(system.wallMs()));
        }
        bool wantClose = res.connectionClose || (req != null && req.connectionClose);
        if (wantClose) {
            res.headers.set("Connection", "close");
        } else if (req != null && req.version == "HTTP/1.0") {
            res.headers.set("Connection", "keep-alive");   // RFC 9112 §9.1.1 echo
        }
        List<byte> headBytes = {};
        HttpParser.appendAscii(headBytes, res.version + " " + res.statusCode.toString()
            + " " + res.reasonPhrase + "\r\n");
        foreach (string name in res.headers.names()) {
            foreach (string v in res.headers.getAll(name)) {
                HttpParser.appendAscii(headBytes, name + ": " + v + "\r\n");
            }
        }
        HttpParser.appendAscii(headBytes, "\r\n");
        this.writeAll(HttpParser.toByteArray(headBytes), writeTimeoutMs);
        if (noBody || head) { return; }
        if (chunked) {
            this.pumpChunked(res.bodyChannel, writeTimeoutMs);
            return;
        }
        if (body != null && body.length() > 0) {
            this.writeAll(body, writeTimeoutMs);
        }
    }

    // The interim response for Expect: 100-continue (D10); no body, no Date.
    public void writeStatus100(int writeTimeoutMs) {
        stream.write(io.toBytes("HTTP/1.1 100 Continue\r\n\r\n"), -1, writeTimeoutMs);
    }

    // Orderly close: half-close, let the peer finish, then close. Windows
    // answers a closesocket() that still has received bytes queued with a
    // reset, and that reset also discards the response the peer has buffered
    // but not read yet — the client would see a broken connection instead of
    // the answer. Dropping the queued bytes first makes the close land as the
    // EOF the client expects; a peer that stays open after the FIN costs at
    // most CLOSE_GRACE_MS.
    public void close() {
        try { stream.shutdownWrite(); } catch (Exception e) { }
        this.drainSocket(system.monoMs() + CLOSE_GRACE_MS);
        stream.close();
    }

    // Reads and throws away what the peer queued until it closes its side or
    // the deadline passes.
    private void drainSocket(long deadline) {
        byte[] sink = byte[CLOSE_SINK_WINDOW];
        while (true) {
            long left = deadline - system.monoMs();
            if (left <= 0) { return; }
            int n = 0;
            try { n = stream.read(sink, left as int); } catch (Exception e) { return; }
            if (n <= 0) { return; }
        }
    }

    private void discard(int n) {
        // Drop the consumed prefix by shifting the tail down in place.
        for (int i = n; i < m_have; i = i + 1) { m_buf[i - n] = m_buf[i]; }
        m_have = m_have - n;
    }

    private void grow() {
        byte[] nb = byte[m_cap * 2];
        for (int i = 0; i < m_have; i = i + 1) { nb[i] = m_buf[i]; }
        m_buf = nb;
        m_cap = m_cap * 2;
    }

    // Streams the channel to the socket as chunked frames (D5/D18); the
    // terminating 0-chunk closes the stream.
    private void pumpChunked(Channel<byte[]> ch, int writeTimeoutMs) {
        while (true) {
            try {
                byte[] chunk = ch.recv();
                stream.write(HttpParser.encodeChunk(chunk), -1, writeTimeoutMs);
            } catch (ChannelClosedException e) {
                break;   // closed and drained: recv throws, never returns null
            }
        }
        stream.write(HttpParser.encodeLastChunk(), -1, writeTimeoutMs);
    }

    // Per-connection keep-alive loop (D6), run on its own thread via
    // thread.spawn(conn.run). The language has no anonymous function literals
    // yet (lambda is the separate 0.13.3 subproject), so the loop body lives
    // here as a bound method — the same shape as examples/net_conc_bench.n.
    public void run() {
        try {
            stream.setNoDelay(true);
            stream.setKeepAlive(true);
            int served = 0;
            while (true) {
                HttpRequest req = null;
                try {
                    req = this.readRequest(m_srv.keepAliveTimeoutMs, m_srv.headerTimeoutMs,
                        m_srv.maxHeaderBytes, m_srv.maxHeaders);
                } catch (HttpException e) {
                    // Malformed head (400/408/431/505): answer on the wire,
                    // then close — the harden test asserts the status line,
                    // not a silent hang-up.
                    int st = e.status;
                    if (st <= 0) { st = 400; }
                    HttpResponse bad = errorResponse(st, e.message);
                    // The head never parsed, so there is no request to
                    // echo. A typed local is required: the argument binder
                    // rejects a bare null literal against a class formal.
                    HttpRequest noReq = null;
                    this.writeResponse(bad, noReq, false, m_srv.writeTimeoutMs);
                    break;
                }
                if (req == null) { break; }   // peer closed between requests
                served = served + 1;
                if (!this.serveOne(req, served)) { break; }
            }
            this.close();
        } catch (Exception e) {
            // Socket failure mid-connection (timeout, reset, half-write):
            // drop the connection without an answer.
            try { this.close(); } catch (Exception e2) { }
        }
        m_srv.connDone();
    }

    // Answers a connection the server will not serve (over maxConnections).
    // Public because HttpServer reaches it; not part of the documented user
    // surface. The request sits unread in the receive queue, so the response
    // goes out through the orderly close: a plain close would reset the
    // connection and the client would never see the 503.
    public void reject503(int writeTimeoutMs) {
        HttpResponse res = errorResponse(503, "server is at capacity");
        HttpRequest noReq = null;
        try {
            this.writeResponse(res, noReq, false, writeTimeoutMs);
        } catch (Exception e) { }
        this.close();
    }

    // Serves one parsed request: the Expect handshake, the handler call, the
    // drain that makes the connection reusable and the response write.
    // Returns false when the connection must close afterwards.
    private bool serveOne(HttpRequest req, int served) {
        bool lastByCap = m_srv.maxRequestsPerConnection > 0
            && served >= m_srv.maxRequestsPerConnection;
        bool head = req.method == "HEAD";
        // D10: answer 100-continue before the body is read; an Expect value we
        // do not know is a 417 without invoking the handler.
        string expect = req.headers.get("Expect");
        if (expect != "") {
            if (expect.equalsIgnoreCase("100-continue")) {
                this.writeStatus100(m_srv.writeTimeoutMs);
            } else {
                HttpResponse bad = errorResponse(417, "Expectation Failed");
                this.writeResponse(bad, req, false, m_srv.writeTimeoutMs);
                return false;
            }
        }
        req.bodyReader = HttpBodyReader(this, req.framingMode, req.framingLength,
            m_srv.maxBodyBytes, m_srv.bodyTimeoutMs);
        HttpResponse res = null;
        try {
            func<HttpResponse, HttpRequest> h = m_srv.handler();
            res = h(req);
        } catch (HttpException e) {
            // A handler throwing HttpException picks its own status (D15).
            int st = e.status;
            if (st <= 0) { st = 500; }
            res = errorResponse(st, e.message);
        } catch (Exception e) {
            // Any other handler failure: 500 with no internal detail leak.
            res = errorResponse(500, "internal error");
        }
        if (res == null) { res = errorResponse(500, "handler returned no response"); }
        res.requestUrl = req.url;
        // Drain whatever the handler left unread so the connection can be
        // reused; over the drain cap the stream cannot be trusted → close.
        bool reusable = req.bodyReader.drain(DEFAULT_DRAIN_CAP);
        // No HTTP/1.0 clause here: the parser already encoded the D7 default
        // (bare 1.0 → connectionClose, explicit keep-alive → persist), so
        // req.connectionClose carries it.
        res.connectionClose = res.connectionClose || lastByCap || req.connectionClose;
        this.writeResponse(res, req, head, m_srv.writeTimeoutMs);
        return !res.connectionClose && reusable;
    }

    private static bool acceptsGzip(HttpRequest req) {
        if (req == null) { return false; }
        foreach (string v in req.headers.getAll("Accept-Encoding")) {
            foreach (string tok in HttpParser.splitTokens(v)) {
                if (tok.equalsIgnoreCase("gzip")) { return true; }
            }
        }
        return false;
    }

    // The error responses the server produces itself (D6: they close the
    // connection, since a parse failure leaves the stream position unknown).
    private static HttpResponse errorResponse(int status, string message) {
        HttpResponse res = HttpResponse();
        res.statusCode = status;
        res.reasonPhrase = reasonFor(status);
        res.body = io.toBytes(message);
        res.headers.set("Content-Type", "text/plain; charset=utf-8");
        res.connectionClose = true;
        return res;
    }

    // Reason phrases for the statuses this library generates; the statuses a
    // handler invents keep the default "OK" unless it sets its own.
    private static string reasonFor(int status) {
        if (status == 400) { return "Bad Request"; }
        if (status == 408) { return "Request Timeout"; }
        if (status == 413) { return "Content Too Large"; }
        if (status == 417) { return "Expectation Failed"; }
        if (status == 431) { return "Request Header Fields Too Large"; }
        if (status == 500) { return "Internal Server Error"; }
        if (status == 503) { return "Service Unavailable"; }
        if (status == 505) { return "HTTP Version Not Supported"; }
        return "Error";
    }
}

// Accept thread + one thread per connection (D6). start() is non-blocking;
// serve() runs the same loop on the calling thread. close() wakes the blocked
// accept (D14).
class HttpServer {
    public int maxHeaderBytes = 65536;
    public int maxHeaders = 100;
    public long maxBodyBytes = 16777216;
    public int keepAliveTimeoutMs = 30000;
    public int headerTimeoutMs = 10000;
    public int bodyTimeoutMs = 10000;
    public int writeTimeoutMs = 10000;
    public int maxConnections = 0;              // 0 = unlimited
    public int maxRequestsPerConnection = 0;    // 0 = unlimited

    private TcpListener m_listener;
    private func<HttpResponse, HttpRequest> m_handler;
    private AtomicInt m_active;
    private AtomicInt m_closing;

    public HttpServer() {
        m_active = AtomicInt(0);
        m_closing = AtomicInt(0);
    }

    // Binds and starts accepting; returns as soon as the listening socket is
    // up, so a caller (or a test) can connect immediately.
    public void start(string host, int port, func<HttpResponse, HttpRequest> handler) {
        m_handler = handler;
        m_listener = TcpListener.bind(host, port);
        thread.spawn(this.acceptLoop);
    }

    // Binds and serves until close(), on the calling thread: the entry point
    // for a standalone server process, whose main() must not return.
    public void serve(string host, int port, func<HttpResponse, HttpRequest> handler) {
        m_handler = handler;
        m_listener = TcpListener.bind(host, port);
        this.acceptLoop();
    }

    public string localAddress() { return m_listener.localAddress(); }
    public int localPort() { return m_listener.localPort(); }

    public void close() {
        m_closing.store(1);
        m_listener.close();   // wakes accept() with SocketException
    }

    private void acceptLoop() {
        while (true) {
            TcpStream sock = null;
            try {
                sock = m_listener.accept(0);
            } catch (Exception e) {
                // The listener was closed (the intended exit), or a transient
                // accept failure worth retrying.
                if (m_closing.load() == 1) { return; }
                thread.sleep(10);
                continue;
            }
            // Count every accepted connection unconditionally: run()'s
            // connDone() decrements unconditionally, so short-circuiting the
            // increment here would drift the counter negative.
            int active = m_active.getAndIncrement();
            HttpConn conn = HttpConn(sock, this);
            if (maxConnections > 0 && active >= maxConnections) {
                m_active.addAndGet(-1);
                conn.reject503(writeTimeoutMs);
                continue;
            }
            thread.spawn(conn.run);
        }
    }

    // Internal helpers for HttpConn: nlang has no friend access, so they are
    // public but are not part of the documented user surface.
    public func<HttpResponse, HttpRequest> handler() { return m_handler; }
    public void connDone() { m_active.addAndGet(-1); }
}
