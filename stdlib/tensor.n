// Standard library source for the "tensor" package — authoritative
// declarations, indexed by langservice::SymbolIndex and inlined into every
// build. The native functions are implemented in the host (nlang_tensor.dll);
// any plain NLang function would compile from this file. Edit freely.
//
// Stage 1 covers 1-D numeric kernels over int/long/float/double arrays.
// Creation kernels carry an element-type suffix (I/L/F/D) — the element
// intent is not derivable from integer-only arguments, so each kind needs
// its own name. Elementwise and reduction families use same-name
// overloads instead: overload resolution picks the declared signature at
// compile time and the native dispatches on the runtime element kind.
//
// Error model: null arrays raise NullPointerException, negative lengths
// raise IndexOutOfBoundsException (language-side alignment), length
// mismatches, zero arange steps and empty reductions raise the base
// Exception.

//--- creation -----------------------------------------------------------------

// int array of n zeros.
native int[] zerosI(int n);
// long array of n zeros.
native long[] zerosL(int n);
// float array of n zeros.
native float[] zerosF(int n);
// Double array of n zeros.
native double[] zerosD(int n);

// int array of n ones.
native int[] onesI(int n);
// long array of n ones.
native long[] onesL(int n);
// float array of n ones.
native float[] onesF(int n);
// Double array of n ones.
native double[] onesD(int n);

// int array of n copies of value.
native int[] fullI(int n, int value);
// long array of n copies of value.
native long[] fullL(int n, long value);
// float array of n copies of value.
native float[] fullF(int n, float value);
// Double array of n copies of value.
native double[] fullD(int n, double value);

// Half-open arithmetic progression: start, start+step, ... strictly
// before stop. A zero step, or one that cannot advance toward stop,
// raises the base Exception.
native int[] arangeI(int start, int stop, int step);
// long arange; int arguments widen implicitly.
native long[] arangeL(long start, long stop, long step);
// float arange.
native float[] arangeF(float start, float stop, float step);
// Double arange.
native double[] arangeD(double start, double stop, double step);
