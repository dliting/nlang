// Standard library source for the "tensor" package — authoritative
// declarations, indexed by langservice::SymbolIndex and inlined into every
// build. The native functions are implemented in the host (nlang_tensor.dll);
// any plain NLang function would compile from this file. Edit freely.
//
// The public surface uses ONE naming discipline: same-name overloads, the
// element kind carried by the typed arguments (the fill value for full,
// the progression triple for arange, the array operands everywhere else).
// Rank-generic operations are declared over the unannotated Array<T> —
// one declaration serves every rank, and the caller's variable annotation
// provides the rank check at run time. The suffixed natives below
// (fullI/fullL/..., arangeI/...) are internal implementation the typed
// wrappers dispatch to — the native ABI passes raw value cells without
// kind metadata, so one native cannot see which scalar kind a call
// carried. Zero-filled arrays need no kernel at all: the language's
// sized creation `T[n]` is zero-initialized.
//
// Error model: null arrays raise NullPointerException, negative lengths
// or lengths past the 100M-element cap raise IndexOutOfBoundsException,
// length/shape mismatches, zero arange steps and empty reductions raise
// the base Exception.

//--- creation (public overloads over internal per-kind natives) ---------------

// n copies of value; the element kind is the value's type.
int[] full(int n, int value) {
    return fullI(n, value);
}
long[] full(int n, long value) {
    return fullL(n, value);
}
float[] full(int n, float value) {
    return fullF(n, value);
}
double[] full(int n, double value) {
    return fullD(n, value);
}

// A dims-shaped array filled with value; the element kind is the value's
// type and the rank is the dims length. A negative dim raises the bounds
// family, matching sized creation.
Array<int> full(int[] dims, int value) {
    return fullDimsI(dims, value);
}
Array<long> full(int[] dims, long value) {
    return fullDimsL(dims, value);
}
Array<float> full(int[] dims, float value) {
    return fullDimsF(dims, value);
}
Array<double> full(int[] dims, double value) {
    return fullDimsD(dims, value);
}

// Half-open arithmetic progression: start, start+step, ... strictly
// before stop; the element kind is the common type of the three
// arguments. A zero step, or one that cannot advance toward stop,
// raises the base Exception.
int[] arange(int start, int stop, int step) {
    return arangeI(start, stop, step);
}
long[] arange(long start, long stop, long step) {
    return arangeL(start, stop, step);
}
float[] arange(float start, float stop, float step) {
    return arangeF(start, stop, step);
}
double[] arange(double start, double stop, double step) {
    return arangeD(start, stop, step);
}

// Internal per-kind natives (implementation of the overloads above;
// not part of the documented surface).
native int[] fullI(int n, int value);
native long[] fullL(int n, long value);
native float[] fullF(int n, float value);
native double[] fullD(int n, double value);
native Array<int> fullDimsI(int[] dims, int value);
native Array<long> fullDimsL(int[] dims, long value);
native Array<float> fullDimsF(int[] dims, float value);
native Array<double> fullDimsD(int[] dims, double value);
native int[] arangeI(int start, int stop, int step);
native long[] arangeL(long start, long stop, long step);
native float[] arangeF(float start, float stop, float step);
native double[] arangeD(double start, double stop, double step);

// Internal ABI-v10 exercise pair (native host ABI v10: view minting
// and stride-aware views). strideViewI mints a rank-1 view of target
// (len elements starting at offset, step stride — both in elements);
// viewSumI sums any rank-1 int array or view through the pinned view
// (the owning arm computes row-major strides, the view arm reads the
// record's). They exist to exercise the host entry points end to end.
native int[] strideViewI(int[] target, int len, int stride, int offset);
native int viewSumI(int[] v);

//--- unary elementwise (float/double; integers have no exp semantics) ---------

// Elementwise e^x; the operand rank flows through unchanged.
native Array<float> exp(Array<float> a);
native Array<double> exp(Array<double> a);

// Elementwise natural logarithm; the operand rank flows through
// unchanged. Negative operands follow IEEE (NaN).
native Array<float> log(Array<float> a);
native Array<double> log(Array<double> a);

//--- elementwise binary (same-name overloads; runtime element-kind dispatch) --
// Two array operands broadcast by the right-aligned rule: a missing
// leading axis or a size-1 axis repeats its cell, incompatible shapes
// raise the base Exception naming both, and the result is a fresh
// owning record of the broadcast shape. The scalar arm keeps the
// operand shape. Integer division by zero raises DivByZeroException;
// float/double division by zero yields IEEE Inf/NaN.
native Array<int> add(Array<int> a, Array<int> b);
native Array<long> add(Array<long> a, Array<long> b);
native Array<float> add(Array<float> a, Array<float> b);
native Array<double> add(Array<double> a, Array<double> b);
native Array<int> sub(Array<int> a, Array<int> b);
native Array<long> sub(Array<long> a, Array<long> b);
native Array<float> sub(Array<float> a, Array<float> b);
native Array<double> sub(Array<double> a, Array<double> b);
native Array<int> mul(Array<int> a, Array<int> b);
native Array<long> mul(Array<long> a, Array<long> b);
native Array<float> mul(Array<float> a, Array<float> b);
native Array<double> mul(Array<double> a, Array<double> b);
native Array<int> div(Array<int> a, Array<int> b);
native Array<long> div(Array<long> a, Array<long> b);
native Array<float> div(Array<float> a, Array<float> b);
native Array<double> div(Array<double> a, Array<double> b);

// Scalar arms (internal addScalar/... names: the array and scalar
// forms share argc 2, so they cannot ride one registered name).
native Array<int> addScalar(Array<int> a, int value);
native Array<long> addScalar(Array<long> a, long value);
native Array<float> addScalar(Array<float> a, float value);
native Array<double> addScalar(Array<double> a, double value);
native Array<int> subScalar(Array<int> a, int value);
native Array<long> subScalar(Array<long> a, long value);
native Array<float> subScalar(Array<float> a, float value);
native Array<double> subScalar(Array<double> a, double value);
native Array<int> mulScalar(Array<int> a, int value);
native Array<long> mulScalar(Array<long> a, long value);
native Array<float> mulScalar(Array<float> a, float value);
native Array<double> mulScalar(Array<double> a, double value);
native Array<int> divScalar(Array<int> a, int value);
native Array<long> divScalar(Array<long> a, long value);
native Array<float> divScalar(Array<float> a, float value);
native Array<double> divScalar(Array<double> a, double value);

// Reversed scalar arms (v0.13.7): the scalar sits on the LEFT, so
// `s - a` and `s / a` stay whole-array calls. int rdiv by zero raises
// like divScalar; float division follows IEEE.
native Array<int> rsubScalar(Array<int> a, int value);
native Array<long> rsubScalar(Array<long> a, long value);
native Array<float> rsubScalar(Array<float> a, float value);
native Array<double> rsubScalar(Array<double> a, double value);
native Array<int> rdivScalar(Array<int> a, int value);
native Array<long> rdivScalar(Array<long> a, long value);
native Array<float> rdivScalar(Array<float> a, float value);
native Array<double> rdivScalar(Array<double> a, double value);

// Elementwise unary minus (v0.13.7): int/long wrap like language
// arithmetic; float negation is the SIMD sign-flip lane.
native Array<int> neg(Array<int> a);
native Array<long> neg(Array<long> a);
native Array<float> neg(Array<float> a);
native Array<double> neg(Array<double> a);

// Axis max/min (v0.13.7): the axis dim is eliminated — the symmetric
// arm of the sum axis family. Overloads with the clamp bound by type.
// int/long keep clamp-only public overloads (max(intArr, int bound)
// predates the axis arm and owns the int-second-arg reading); their
// axis natives stay registered below for internal composition.
native Array<float> maxAxis(Array<float> a, int axis);
native Array<double> maxAxis(Array<double> a, int axis);
native Array<float> minAxis(Array<float> a, int axis);
native Array<double> minAxis(Array<double> a, int axis);

// Activation backward and tanh (v0.13.7): reluGrad(dOut, z) = where
// z > 0 the gradient flows, else zero (z = 0 gates off); tanh rides
// the vector math lane. float/double only.
native Array<float> reluGrad(Array<float> dOut, Array<float> z);
native Array<double> reluGrad(Array<double> dOut, Array<double> z);
native Array<float> tanh(Array<float> x);
native Array<double> tanh(Array<double> x);

// Gather along an axis with a rank-1 int index array. Rank >= 2: out
// drops the axis dim and out[flat] = a[... indices[outer] ...] at the
// same non-axis position. Rank-1 sources degenerate to plain fancy
// indexing (out[i] = a[indices[i]], out length = indices length).
// Index out of range raises IndexOutOfBoundsException; an empty source
// raises the base Exception.
native Array<int> gather(Array<int> a, int axis, Array<int> indices);
native Array<long> gather(Array<long> a, int axis, Array<int> indices);
native Array<float> gather(Array<float> a, int axis, Array<int> indices);
native Array<double> gather(Array<double> a, int axis, Array<int> indices);

// Argmax/argmin along an axis: int32 indices, first-max/min tie.
native Array<int> argmax(Array<int> a, int axis);
native Array<int> argmax(Array<float> a, int axis);
native Array<int> argmax(Array<double> a, int axis);
native Array<int> argmin(Array<int> a, int axis);
native Array<int> argmin(Array<float> a, int axis);
native Array<int> argmin(Array<double> a, int axis);

// Elementwise equality: int32 0/1 out (IEEE ==/!= for floats).
native Array<int> eq(Array<int> a, Array<int> b);
native Array<int> eq(Array<long> a, Array<long> b);
native Array<int> eq(Array<float> a, Array<float> b);
native Array<int> eq(Array<double> a, Array<double> b);

// One-hot expansion: float[len, n], row i ones at labels[i].
native Array<float> oneHot(Array<int> labels, int n);

// Device surface (v0.14.x device line): toDevice lands a copy on the
// active device (a view materializes into the device copy); toHost
// lands one back. A same-residency operand returns as-is. backend()
// reports the active backend's name ("cpu"/"mirror"/"cuda").
native Array<float> toDevice(Array<float> a);
native Array<double> toDevice(Array<double> a);
native Array<int> toDevice(Array<int> a);
native Array<long> toDevice(Array<long> a);
native Array<float> toHost(Array<float> a);
native Array<double> toHost(Array<double> a);
native Array<int> toHost(Array<int> a);
native Array<long> toHost(Array<long> a);
native string backend();

// Whole-array random fill: dims-shaped array, each element drawn
// uniformly from [low, high) in row-major order. The draws ride the
// host PRNG — the same seeded stream math.random reads — so a seeded
// run is reproducible through either surface. Raises Exception when
// low > high (the math.randomi range rule).
Array<float> uniform(int[] dims, float low, float high) {
    return uniformF(dims, low, high);
}
Array<double> uniform(int[] dims, double low, double high) {
    return uniformD(dims, low, high);
}
native Array<float> uniformF(int[] dims, float low, float high);
native Array<double> uniformD(int[] dims, double low, double high);



//arange(n): 0..n-1 step 1 — the index-array spelling.
Array<int> arange(int n) {
    return arangeI(0, n, 1);
}

Array<int> add(Array<int> a, int value) {
    return addScalar(a, value);
}
Array<long> add(Array<long> a, long value) {
    return addScalar(a, value);
}
Array<float> add(Array<float> a, float value) {
    return addScalar(a, value);
}
Array<double> add(Array<double> a, double value) {
    return addScalar(a, value);
}
Array<int> sub(Array<int> a, int value) {
    return subScalar(a, value);
}
Array<long> sub(Array<long> a, long value) {
    return subScalar(a, value);
}
Array<float> sub(Array<float> a, float value) {
    return subScalar(a, value);
}
Array<double> sub(Array<double> a, double value) {
    return subScalar(a, value);
}
Array<int> mul(Array<int> a, int value) {
    return mulScalar(a, value);
}
Array<long> mul(Array<long> a, long value) {
    return mulScalar(a, value);
}
Array<float> mul(Array<float> a, float value) {
    return mulScalar(a, value);
}
Array<double> mul(Array<double> a, double value) {
    return mulScalar(a, value);
}
Array<int> div(Array<int> a, int value) {
    return divScalar(a, value);
}
Array<long> div(Array<long> a, long value) {
    return divScalar(a, value);
}
Array<float> div(Array<float> a, float value) {
    return divScalar(a, value);
}
Array<double> div(Array<double> a, double value) {
    return divScalar(a, value);
}


//--- clamp (elementwise bound; the clamp pair shares names with the
//--- reductions and is arity-dispatched) ---------------------------------------

// Elementwise maximum of a and bound; the operand rank flows through.
native Array<int> max(Array<int> a, int bound);
native Array<long> max(Array<long> a, long bound);
native Array<float> max(Array<float> a, float bound);
native Array<double> max(Array<double> a, double bound);

// Elementwise minimum of a and bound; the operand rank flows through.
native Array<int> min(Array<int> a, int bound);
native Array<long> min(Array<long> a, long bound);
native Array<float> min(Array<float> a, float bound);
native Array<double> min(Array<double> a, double bound);

//--- reductions (same-name overloads; runtime element-kind dispatch) -----------
// Rank-generic: one unannotated declaration covers every rank; the
// payload is flattened in row-major order.

// Sum of all elements. The empty array yields the type's zero.
native int sum(Array<int> a);
native long sum(Array<long> a);
native float sum(Array<float> a);
native double sum(Array<double> a);
// Sum along one axis: the axis dim is eliminated and the rank drops by
// one (a rank-1 source with axis 0 returns the scalar). An axis
// outside [0, rank) raises the base Exception naming axis and rank.
native Array<int> sum(Array<int> a, int axis);
native Array<long> sum(Array<long> a, int axis);
native Array<float> sum(Array<float> a, int axis);
native Array<double> sum(Array<double> a, int axis);

// Largest element; an empty array raises the base Exception.
native int max(Array<int> a);
native long max(Array<long> a);
native float max(Array<float> a);
native double max(Array<double> a);

// Smallest element; an empty array raises the base Exception.
native int min(Array<int> a);
native long min(Array<long> a);
native float min(Array<float> a);
native double min(Array<double> a);

// Arithmetic mean; always double, for every element kind. An empty
// array raises the base Exception.
native double mean(int[] a);
native double mean(long[] a);
native double mean(float[] a);
native double mean(double[] a);
native double mean(int[,] a);
native double mean(long[,] a);
native double mean(float[,] a);
native double mean(double[,] a);

// Inner product of two arrays of the same length. Integer kinds
// accumulate in 64 bits and return long — a single int product always
// fits 64 bits, and the running sum wraps like language arithmetic; the
// empty array yields zero.
native long dot(int[] a, int[] b);
native long dot(long[] a, long[] b);
native float dot(float[] a, float[] b);
native double dot(double[] a, double[] b);

//--- matrix family --------------------------------------------------------------

// Transpose as a view: without axes every axis reverses (rank 2 is
// the familiar [rows, cols] -> [cols, rows]); with axes the view's
// axis d reads the source axis axes[d] — axes must be a permutation of
// 0..rank-1 or the base Exception raises.
native Array<int> transpose(Array<int> a);
native Array<long> transpose(Array<long> a);
native Array<float> transpose(Array<float> a);
native Array<double> transpose(Array<double> a);
native Array<int> transpose(Array<int> a, int[] axes);
native Array<long> transpose(Array<long> a, int[] axes);
native Array<float> transpose(Array<float> a, int[] axes);
native Array<double> transpose(Array<double> a, int[] axes);

// Flatten to rank 1: a view over a contiguous source, a dense copy
// otherwise (a strided source has no rank-1 reinterpretation).
native Array<int> flatten(Array<int> a);
native Array<long> flatten(Array<long> a);
native Array<float> flatten(Array<float> a);
native Array<double> flatten(Array<double> a);

// Slice every axis at once, the function form of the colon subscript:
// starts/stops/steps each carry one entry per axis (negative endpoints
// count from the end; a zero step raises the base Exception).
native Array<int> slice(Array<int> a, int[] starts, int[] stops, int[] steps);
native Array<long> slice(Array<long> a, int[] starts, int[] stops, int[] steps);
native Array<float> slice(Array<float> a, int[] starts, int[] stops, int[] steps);
native Array<double> slice(Array<double> a, int[] starts, int[] stops, int[] steps);

// Read-only broadcast view: leading axes the source lacks and size-1
// source axes repeat (zero stride). Aligned dims must match or have
// source size 1; stores through the view reject (a repeated write
// would corrupt aliases).
native Array<int> broadcastTo(Array<int> a, int[] shape);
native Array<long> broadcastTo(Array<long> a, int[] shape);
native Array<float> broadcastTo(Array<float> a, int[] shape);
native Array<double> broadcastTo(Array<double> a, int[] shape);

// Materialize to a dense row-major copy: the original handle is
// returned when the source is already contiguous, a dense copy
// otherwise (PyTorch's contiguous). The copy keeps the source's
// residency (a device view stays on device).
native Array<int> contiguous(Array<int> a);
native Array<long> contiguous(Array<long> a);
native Array<float> contiguous(Array<float> a);
native Array<double> contiguous(Array<double> a);

// Reshape re-views a contiguous source at the same offset (O(1)); a
// strided source materializes a dense copy first. Exactly one shape
// dim may be
// -1: it is inferred as elemCount divided by the product of the other
// dims, which must divide evenly — otherwise the base Exception raises
// with both numbers spelled out. Any other negative dim raises the
// bounds family (matching sized creation).
native Array<int> reshape(Array<int> a, int[] shape);
native Array<long> reshape(Array<long> a, int[] shape);
native Array<float> reshape(Array<float> a, int[] shape);
native Array<double> reshape(Array<double> a, int[] shape);

// Concatenate two arrays of equal rank along axis: every dim must match
// except the axis dim, which sums. An out-of-range axis raises the
// bounds family.
native Array<int> concat(Array<int> a, Array<int> b, int axis);
native Array<long> concat(Array<long> a, Array<long> b, int axis);
native Array<float> concat(Array<float> a, Array<float> b, int axis);
native Array<double> concat(Array<double> a, Array<double> b, int axis);

// Matrix product: [aRows, aCols] * [bRows, bCols] -> [aRows, bCols];
// the inner dimensions must match — otherwise the base Exception names
// both shapes. Arithmetic follows the language-wide rules: int/long
// wrap around, float/double follow IEEE.
native int[,] matmul(int[,] a, int[,] b);
native long[,] matmul(long[,] a, long[,] b);
native float[,] matmul(float[,] a, float[,] b);
native double[,] matmul(double[,] a, double[,] b);

//--- plain-NLang layer: the small neural-net composition the kernels
//--- above are built for. float and double overloads; integers have no
//--- activation semantics.

// Rectified linear unit: max(a, 0) elementwise. The bare 0.0 literal
// binds the float clamp through the fitted-constant rung (the double
// overload is dead on argument 1 — array element types are invariant).
Array<float> relu(Array<float> a) {
    return max(a, 0.0);
}
Array<double> relu(Array<double> a) {
    return max(a, 0.0);
}

// Softmax over the flattened payload lives in the vector-ops layer
// below (softmax(x) keeps this name; rank-1 reads as axis 0).

// Cross-entropy of one-hot labels against softmax(logits):
// -sum(labels * log(softmax(logits))). The formals are the rank-1
// spelling on purpose: an unannotated `Array<T>` formal matches any
// rank, and passing one to the rank-split mul family would be
// ambiguous (rank-1 and rank-2 rows both match). Rank-2 batches
// flatten first (tensor.flatten).
float crossEntropyLoss(float[] logits, float[] labels) {
    float[] p = softmax(logits);
    float[] lp = log(p);
    return -sum(mul(labels, lp));
}
double crossEntropyLoss(double[] logits, double[] labels) {
    double[] p = softmax(logits);
    double[] lp = log(p);
    return -sum(mul(labels, lp));
}

//--- vector-ops layer (v0.13.7): the loop-free composition surface ---

//neg overloads bind the kind-dispatching native directly.
// s - a and s / a with the scalar on the left (rsub/rdiv); neg,
// rsubScalar, rdivScalar, reluGrad and tanh bind the kind-dispatching
// natives directly.

// Axis arms: `max(a, 3)` with an int axis reduces along that axis; the
// float-bound overloads above keep the clamp reading. rank-1 + axis 0
// is the full reduction (the scalar overload's value).
Array<float> max(Array<float> a, int axis) {
    return maxAxis(a, axis);
}
Array<double> max(Array<double> a, int axis) {
    return maxAxis(a, axis);
}
Array<float> min(Array<float> a, int axis) {
    return minAxis(a, axis);
}
Array<double> min(Array<double> a, int axis) {
    return minAxis(a, axis);
}

// Logistic sigmoid: 1 / (1 + exp(-x)) — every step a whole-array call
// (neg, exp, addScalar, rdivScalar), no element loops.
Array<float> sigmoid(Array<float> x) {
    return rdivScalar(add(exp(neg(x)), 1.0 as float), 1.0 as float);
}
Array<double> sigmoid(Array<double> x) {
    return rdivScalar(add(exp(neg(x)), 1.0), 1.0);
}

// Softmax along an axis, loop-free: shift by the axis max (numerically
// safe exp), exponentiate, normalize by the axis sum — both back-
// broadcast through reshape + broadcastTo. The default spelling keeps
// the historical rank-1 reading (axis 0); higher ranks default to the
// last axis, like the row-wise classifiers use.
Array<float> softmax(Array<float> x, int axis) {
    int[] xs = x.shape();
    int rank = xs.length();
    int[] ms = int[rank];
    for (int i = 0; i < rank; i += 1) {
        if (i == axis) {
            ms[i] = 1;
        } else {
            ms[i] = xs[i];
        }
    }
    Array<float> mb = broadcastTo(reshape(max(x, axis), ms), xs);
    Array<float> e = exp(sub(x, mb));
    Array<float> sb = broadcastTo(reshape(sum(e, axis), ms), xs);
    return div(e, sb);
}
Array<double> softmax(Array<double> x, int axis) {
    int[] xs = x.shape();
    int rank = xs.length();
    int[] ms = int[rank];
    for (int i = 0; i < rank; i += 1) {
        if (i == axis) {
            ms[i] = 1;
        } else {
            ms[i] = xs[i];
        }
    }
    Array<double> mb = broadcastTo(reshape(max(x, axis), ms), xs);
    Array<double> e = exp(sub(x, mb));
    Array<double> sb = broadcastTo(reshape(sum(e, axis), ms), xs);
    return div(e, sb);
}
Array<float> softmax(Array<float> x) {
    float m = max(x);
    float[] e = exp(subScalar(x, m));
    return divScalar(e, sum(e));
}
Array<double> softmax(Array<double> x) {
    double m = max(x);
    double[] e = exp(subScalar(x, m));
    return divScalar(e, sum(e));
}
